{
  "name": "edgey-cli",
  "version": "1.0.2",
  "private": true,
  "bin": {
    "edgey": "bin/edgey.mjs"
  },
  "type": "module",
  "description": "edgeyCLI terminal coding client",
  "engines": {
    "bun": ">=1.4.2"
  },
  "scripts": {
    "start": "bun run src/index.tsx",
    "dev": "bun run src/index.tsx",
    "doctor": "bun run src/index.tsx --doctor",
    "package": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package-source.ps1",
    "build:windows": "bun run scripts/build-windows.ts",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.1",
    "@opentui/core": "0.5.11",
    "@opentui/react": "0.5.11",
    "playwright-core": "1.63.0",
    "react": "19.3.0"
  },
  "devDependencies": {
    "@types/bun": "1.4.2",
    "@types/react": "19.3.0",
    "@types/react-reconciler": "0.33.0",
    "bun": "1.4.2",
    "typescript": "7.0.2"
  }
}
