---
import Shell from './Shell.astro';
import Icon from '../components/Icon.astro';

interface Props {
  title: string;
  active?: 'products' | 'support' | 'terms';
}
const { title, active } = Astro.props;
---
<Shell title={title}>
  <div class="pub">
    <header class="bar">
      <a href="/" class="brand"><span class="logo"><Icon name="terminal" size={14} /></span><span>edgey<span class="accent">cli</span></span></a>
      <nav>
        <a href="/products" class:list={{ on: active === 'products' }}>Products</a>
        <a href="/support" class:list={{ on: active === 'support' }}>Support</a>
        <a href="/terms" class:list={{ on: active === 'terms' }}>Terms</a>
      </nav>
    </header>
    <main><slot /></main>
    <footer class="foot">
      <a href="/support" class="accent">Contact support</a>
      <span>© {new Date().getFullYear()} cli.edgey.shop</span>
    </footer>
  </div>
</Shell>

<style is:global>
  .pub { max-width: 1000px; margin: 0 auto; padding: 0 16px; min-height: 100svh; display: flex; flex-direction: column; }
  .pub .bar { display: flex; justify-content: space-between; align-items: center; height: 84px; border-bottom: 1px solid var(--border); }
  .pub .brand { display: flex; align-items: center; gap: 10px; font-size: 16px; font-weight: 700; }
  .pub .logo { display: grid; place-items: center; width: 26px; height: 26px; border-radius: 7px; color: var(--accent); background: var(--accent-soft); border: 1px solid var(--accent-line); view-transition-name: brand-logo; }
  .pub .accent { color: var(--accent); }
  .pub nav { display: flex; gap: 20px; font-size: 13px; color: var(--muted); }
  .pub nav a[href]:hover, .pub nav .on { color: var(--fg); }
  .pub main { flex: 1; padding: 72px 0 64px; }
  .pub .kicker { display: flex; align-items: center; gap: 10px; font-family: var(--mono); font-size: 10px; letter-spacing: 0.22em; color: var(--accent); }
  .pub .dot { width: 6px; height: 6px; border-radius: 50%; background: var(--accent); box-shadow: 0 0 10px var(--accent); }
  .pub h1 { margin-top: 18px; max-width: 820px; font-size: clamp(38px, 7vw, 68px); line-height: 1.02; letter-spacing: -0.045em; font-weight: 700; }
  .pub .lead { margin-top: 22px; max-width: 600px; font-size: 16px; line-height: 1.6; color: var(--muted); }
  .pub .cta { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 28px; }
  .pub .cta .btn { height: 46px; padding: 0 20px; font-size: 13px; }
  .pub .grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; margin-top: 64px; }
  .pub .feat { position: relative; padding: 22px; overflow: hidden; transition: border-color 0.2s, transform 0.2s; }
  .pub .feat::after { content: ''; position: absolute; inset: 0 0 auto; height: 2px; background: linear-gradient(90deg, transparent, var(--accent), transparent); opacity: 0; transition: opacity 0.2s; }
  .pub .feat:hover { border-color: var(--accent-line); transform: translateY(-3px); }
  .pub .feat:hover::after { opacity: 1; }
  .pub .feat-top { display: flex; justify-content: space-between; align-items: center; }
  .pub .feat .g-icon { color: var(--accent); border-color: var(--accent-line); background: var(--accent-soft); }
  .pub .idx { font-family: var(--mono); font-size: 11px; color: var(--muted); }
  .pub .feat h2 { margin-top: 20px; font-size: 15px; font-weight: 600; }
  .pub .feat p { margin-top: 8px; font-size: 12.5px; line-height: 1.65; color: var(--muted); }
  .pub .how { margin-top: 16px; }
  .pub .how-head { display: flex; justify-content: space-between; align-items: center; padding: 18px 22px; border-bottom: 1px solid var(--border); }
  .pub .how-head .card-title { display: flex; align-items: center; gap: 10px; }
  .pub .how ol { list-style: none; padding: 10px 22px 18px; font-family: var(--mono); font-size: 12.5px; }
  .pub .how li { display: flex; gap: 12px; padding: 12px 0; border-bottom: 1px dashed var(--border); }
  .pub .how li:last-child { border-bottom: 0; }
  .pub .n { color: var(--muted); }
  .pub .p { color: var(--accent); }
  .pub .foot { display: flex; justify-content: space-between; gap: 12px; padding: 20px 0 28px; border-top: 1px solid var(--border); font-family: var(--mono); font-size: 10px; letter-spacing: 0.08em; color: #3d4c55; }
  @media (max-width: 800px) {
    .pub .grid { grid-template-columns: 1fr; }
    .pub main { padding-top: 48px; }
  }
  @media (max-width: 480px) {
    .pub nav { gap: 12px; font-size: 12px; }
    .pub .brand > span:last-child { font-size: 14px; }
    .pub .cta .btn { width: 100%; }
    .pub .foot { flex-direction: column; align-items: center; }
  }
</style>
