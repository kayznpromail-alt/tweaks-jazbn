---
import Shell from './Shell.astro';
import Icon from '../components/Icon.astro';
import { DISCORD_URL } from '../data/site';

interface Props {
  title: string;
  active?: 'products' | 'support' | 'terms';
}
const { title, active } = Astro.props;
const year = new Date().getFullYear();
---
<Shell title={title}>
  <div class="pub">
    <header class="bar">
      <a href="/" class="brand">
        <span class="logo"><Icon name="terminal" size={14} /></span>
        <span class="brand-name">edgey<span class="dim">.shop</span></span>
      </a>
      <nav>
        <a href="/products" class:list={{ on: active === 'products' }}>Products</a>
        <a href="/support" class:list={{ on: active === 'support' }}>Support</a>
        <a href="/terms" class:list={{ on: active === 'terms' }}>Terms</a>
      </nav>
      <div class="bar-right">
        <a href="/overview" class="btn-nav">Open workspace <Icon name="arrowUpRight" size={12} /></a>
      </div>
    </header>
    <main><slot /></main>
    <footer class="foot">
      <div class="foot-grid">
        <div class="foot-brand">
          <a href="/" class="brand">
            <span class="logo sm"><Icon name="terminal" size={12} /></span>
            <span class="brand-name">edgey<span class="dim">.shop</span></span>
          </a>
          <p>Your AI models, API keys<br />and usage in one place.</p>
        </div>
        <div class="foot-col">
          <h4>Workspace</h4>
          <a href="/overview">Dashboard</a>
          <a href="/models">Models</a>
          <a href="/setup">Setup</a>
        </div>
        <div class="foot-col">
          <h4>Resources</h4>
          <a href="/support">Support</a>
          <a href={DISCORD_URL} target="_blank" rel="noopener">Discord</a>
        </div>
        <div class="foot-col">
          <h4>Information</h4>
          <a href="/terms">Terms & payments</a>
          <a href="/products">Products</a>
        </div>
      </div>
      <div class="foot-bottom">
        <span>&copy; {year} cli.edgey.shop</span>
        <a href="/support" class="accent">Contact support</a>
      </div>
    </footer>
  </div>
</Shell>

<style is:global>
  .pub { max-width: 1140px; margin: 0 auto; padding: 0 24px; min-height: 100svh; display: flex; flex-direction: column; }
  .pub .bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    height: 64px;
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgb(5 8 11 / 0.8);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    margin: 0 -24px;
    padding: 0 24px;
    border-bottom: 1px solid var(--border);
  }
  .pub .brand { display: flex; align-items: center; gap: 10px; font-size: 16px; font-weight: 700; }
  .pub .brand-name { letter-spacing: -0.01em; }
  .pub .logo {
    display: grid; place-items: center;
    width: 28px; height: 28px; border-radius: 8px;
    color: var(--accent); background: var(--accent-soft); border: 1px solid var(--accent-line);
    view-transition-name: brand-logo;
  }
  .pub .logo.sm { width: 24px; height: 24px; }
  .pub .dim { color: var(--muted); font-weight: 400; }
  .pub .accent { color: var(--accent); }
  .pub nav { display: flex; gap: 28px; font-size: 13px; color: var(--muted); }
  .pub nav a[href]:hover, .pub nav .on { color: var(--fg); }
  .pub .bar-right { display: flex; gap: 10px; }
  .pub .btn-nav {
    display: inline-flex; align-items: center; gap: 8px;
    height: 34px; padding: 0 14px; border-radius: 8px;
    font-size: 12px; font-weight: 600;
    border: 1px solid var(--border-2); background: var(--bg);
    color: var(--fg); transition: all 0.15s;
  }
  .pub .btn-nav:hover { border-color: var(--accent-line); color: var(--accent); }
  .pub main { flex: 1; padding: 72px 0 80px; }
  .pub .kicker { display: flex; align-items: center; gap: 10px; font-family: var(--mono); font-size: 10px; letter-spacing: 0.22em; color: var(--accent); }
  .pub .dot { width: 6px; height: 6px; border-radius: 50%; background: var(--accent); box-shadow: 0 0 10px var(--accent); }
  .pub h1 { margin-top: 18px; max-width: 820px; font-size: clamp(38px, 7vw, 68px); line-height: 1.02; letter-spacing: -0.045em; font-weight: 700; }
  .pub .lead { margin-top: 22px; max-width: 600px; font-size: 16px; line-height: 1.6; color: var(--muted); }
  .pub .cta { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 28px; }
  .pub .cta .btn { height: 46px; padding: 0 22px; font-size: 13px; }
  .pub .grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; margin-top: 64px; }
  .pub .feat { position: relative; padding: 24px; overflow: hidden; transition: border-color 0.2s, transform 0.2s; }
  .pub .feat::after { content: ''; position: absolute; inset: 0 0 auto; height: 2px; background: linear-gradient(90deg, transparent, var(--accent), transparent); opacity: 0; transition: opacity 0.2s; }
  .pub .feat:hover { border-color: var(--accent-line); transform: translateY(-3px); }
  .pub .feat:hover::after { opacity: 1; }
  .pub .feat-top { display: flex; justify-content: space-between; align-items: center; }
  .pub .feat .g-icon { color: var(--accent); border-color: var(--accent-line); background: var(--accent-soft); }
  .pub .idx { font-family: var(--mono); font-size: 11px; color: var(--muted); }
  .pub .feat h2 { margin-top: 20px; font-size: 15px; font-weight: 600; }
  .pub .feat p { margin-top: 8px; font-size: 12.5px; line-height: 1.65; color: var(--muted); }
  .pub .how { margin-top: 16px; }
  .pub .how-head { display: flex; justify-content: space-between; align-items: center; padding: 18px 24px; border-bottom: 1px solid var(--border); }
  .pub .how-head .card-title { display: flex; align-items: center; gap: 10px; }
  .pub .how ol { list-style: none; padding: 10px 24px 18px; font-family: var(--mono); font-size: 12.5px; }
  .pub .how li { display: flex; gap: 12px; padding: 12px 0; border-bottom: 1px dashed var(--border); }
  .pub .how li:last-child { border-bottom: 0; }
  .pub .n { color: var(--muted); }
  .pub .p { color: var(--accent); }

  /* Footer */
  .pub .foot { border-top: 1px solid var(--border); margin-top: auto; }
  .pub .foot-grid {
    display: grid;
    grid-template-columns: 1.5fr 1fr 1fr 1fr;
    gap: 40px;
    padding: 40px 0 32px;
  }
  .pub .foot-brand p { margin-top: 14px; font-size: 13px; line-height: 1.6; color: var(--muted); }
  .pub .foot-col h4 { font-size: 12px; font-weight: 600; letter-spacing: 0.04em; margin-bottom: 14px; }
  .pub .foot-col a { display: block; padding: 4px 0; font-size: 13px; color: var(--muted); transition: color 0.15s; }
  .pub .foot-col a:hover { color: var(--fg); }
  .pub .foot-bottom {
    display: flex; justify-content: space-between; gap: 12px;
    padding: 20px 0 28px;
    border-top: 1px solid var(--border);
    font-size: 11px; color: #3d4c55;
  }

  @media (max-width: 800px) {
    .pub .grid { grid-template-columns: 1fr; }
    .pub main { padding-top: 48px; }
    .pub .foot-grid { grid-template-columns: 1fr 1fr; gap: 32px; }
  }
  @media (max-width: 480px) {
    .pub nav { gap: 16px; font-size: 12px; }
    .pub .bar-right { display: none; }
    .pub .cta .btn { width: 100%; }
    .pub .foot-grid { grid-template-columns: 1fr; }
    .pub .foot-bottom { flex-direction: column; align-items: center; }
  }
</style>
