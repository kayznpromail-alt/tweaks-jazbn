---
import Shell from './Shell.astro';
import Header from '../components/Header.astro';
import Icon from '../components/Icon.astro';

interface Props {
  title?: string;
  crumb: string;
  heading: string;
  sub: string;
}
const { title, crumb, heading, sub } = Astro.props;
---
<Shell title={title}>
  <Header />
  <main class="page">
    <p class="crumb">WORKSPACE / {crumb}</p>
    <h1>{heading}</h1>
    <p class="sub">{sub}</p>
    <hr />
    <slot />
  </main>
  <footer class="site-foot">
    <a href="/overview">edgeycli.com</a>
    <span class="motto">ONE WORKSPACE. YOUR AI TOOLS.</span>
    <a href="/setup" class="to-setup">Client setup <Icon name="arrowUpRight" size={12} /></a>
  </footer>
</Shell>

<script>
  import { API_ENABLED, api, session } from '../lib/api';

  // Dashboard pages need a session once the API is live.
  if (API_ENABLED && !session.get()) location.replace('/');

  document.querySelector('[aria-label="Log out"]')?.addEventListener('click', async (e) => {
    if (!API_ENABLED) return;
    e.preventDefault();
    await api('/auth/logout', { method: 'POST' }).catch(() => {});
    session.clear();
    location.assign('/');
  });
</script>

<style is:global>
  .page { max-width: 1256px; margin: 0 auto; padding: 48px 16px 80px; }
  .crumb {
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: 0.14em;
    color: var(--accent);
  }
  .page > h1 {
    font-size: clamp(28px, 5vw, 38px);
    font-weight: 700;
    letter-spacing: -0.035em;
    margin-top: 14px;
  }
  .sub { color: var(--muted); margin-top: 10px; font-size: 13px; }
  .page > hr { border: 0; border-top: 1px solid var(--border); margin: 28px 0; }

  .site-foot {
    max-width: 1256px;
    margin: 0 auto;
    padding: 0 16px 40px;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 12px;
    font-size: 11px;
    color: var(--muted);
  }
  .site-foot::before {
    content: '';
    grid-column: 1 / -1;
    border-top: 1px solid var(--border);
    margin-bottom: 20px;
  }
  .site-foot a:hover { color: var(--accent); }
  .site-foot .motto { font-family: var(--mono); font-size: 9.5px; letter-spacing: 0.14em; color: var(--accent); }
  .site-foot .to-setup { display: inline-flex; align-items: center; gap: 6px; justify-self: end; }
  @media (max-width: 640px) {
    .site-foot { grid-template-columns: 1fr; justify-items: center; text-align: center; }
    .site-foot .to-setup { justify-self: center; }
  }
</style>
