---
import Header from '../components/Header.astro';
import Icon from '../components/Icon.astro';
import Intro from '../components/Intro.astro';

interface Props {
  title?: string;
  crumb: string;
  heading: string;
  sub: string;
}
const { title, crumb, heading, sub } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      // Opening effect: once per tab, and never with reduced motion.
      try {
        if (!sessionStorage.getItem('edgey-intro') && !matchMedia('(prefers-reduced-motion: reduce)').matches)
          document.documentElement.classList.add('intro-on');
      } catch (e) {}
    </script>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title ? `${title} · edgeycli.com` : 'edgeycli.com'}</title>
  </head>
  <body>
    <Intro />
    <Header />
    <main class="page">
      <p class="crumb">WORKSPACE / {crumb}</p>
      <h1>{heading}</h1>
      <p class="sub">{sub}</p>
      <hr />
      <slot />
    </main>
    <footer class="site-foot">
      <a href="/">edgeycli.com</a>
      <span class="motto">ONE WORKSPACE. YOUR AI TOOLS.</span>
      <a href="/setup" class="to-setup">Client setup <Icon name="arrowUpRight" size={12} /></a>
    </footer>
    <script>
      document.addEventListener('click', (e) => {
        const btn = (e.target as HTMLElement).closest<HTMLElement>('[data-copy]');
        if (!btn) return;
        navigator.clipboard?.writeText(btn.dataset.copy ?? '');
        btn.classList.add('copied');
        const label = btn.querySelector('.label');
        const prev = label?.textContent;
        if (label) label.textContent = 'Copied';
        setTimeout(() => {
          btn.classList.remove('copied');
          if (label) label.textContent = prev ?? '';
        }, 1200);
      });
    </script>
  </body>
</html>

<style is:global>
  :root {
    --bg: #05080b;
    --surface: #0a0f13;
    --surface-2: #0f161c;
    --border: #17222b;
    --border-2: #203039;
    --fg: #e8f1f5;
    --muted: #7d8d98;
    --accent: #22d3ee;
    --accent-2: #38bdf8;
    --accent-soft: rgb(34 211 238 / 0.08);
    --accent-line: rgb(34 211 238 / 0.28);
    --mono: ui-monospace, 'JetBrains Mono', 'Cascadia Code', 'Fira Code', Consolas, monospace;
    color-scheme: dark;
  }
  * { box-sizing: border-box; margin: 0; padding: 0; }
  [hidden] { display: none !important; }
  html { -webkit-text-size-adjust: 100%; }
  body {
    background:
      radial-gradient(900px 600px at -10% -10%, rgb(34 211 238 / 0.09), transparent 60%),
      radial-gradient(700px 500px at 110% 10%, rgb(56 189 248 / 0.05), transparent 60%),
      var(--bg);
    background-attachment: fixed;
    color: var(--fg);
    font-family: system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
    font-size: 14px;
    line-height: 1.5;
    min-height: 100vh;
    -webkit-font-smoothing: antialiased;
  }
  a { color: inherit; text-decoration: none; }
  button { font: inherit; color: inherit; background: none; border: 0; cursor: pointer; }
  input { font: inherit; color: inherit; }
  code, .mono { font-family: var(--mono); }

  .page { max-width: 1256px; margin: 0 auto; padding: 48px 16px 80px; }
  .crumb {
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: 0.14em;
    color: var(--accent);
  }
  .page > h1 {
    font-size: clamp(28px, 5vw, 38px);
    font-weight: 700;
    letter-spacing: -0.035em;
    margin-top: 14px;
  }
  .sub { color: var(--muted); margin-top: 10px; font-size: 13px; }
  .page > hr { border: 0; border-top: 1px solid var(--border); margin: 28px 0; }

  .card {
    background: linear-gradient(180deg, var(--surface-2), var(--surface));
    border: 1px solid var(--border);
    border-radius: 14px;
  }
  .card-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 12px;
  }
  .card-title { font-size: 13px; font-weight: 600; }
  .card-sub { font-size: 12px; color: var(--muted); margin-top: 4px; }
  .icon-btn {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    flex: none;
    border-radius: 8px;
    border: 1px solid var(--border-2);
    background: var(--bg);
    color: var(--fg);
    transition: color 0.15s, border-color 0.15s;
  }
  .icon-btn:hover { color: var(--accent); border-color: var(--accent-line); }
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    height: 38px;
    padding: 0 16px;
    border-radius: 8px;
    font-size: 12px;
    font-weight: 600;
    white-space: nowrap;
    border: 1px solid var(--border-2);
    background: var(--bg);
    transition: border-color 0.15s, color 0.15s, filter 0.15s;
  }
  .btn:hover { border-color: var(--accent-line); color: var(--accent); }
  .btn.primary {
    background: var(--accent);
    border-color: var(--accent);
    color: #031217;
  }
  .btn.primary:hover { filter: brightness(1.1); color: #031217; }
  .tag {
    font-family: var(--mono);
    font-size: 9px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .pill {
    display: inline-block;
    font-size: 10px;
    padding: 3px 8px;
    border-radius: 6px;
    border: 1px solid var(--accent-line);
    background: var(--accent-soft);
    color: var(--accent);
  }
  .g-icon {
    display: grid;
    place-items: center;
    flex: none;
    width: 32px;
    height: 32px;
    border-radius: 8px;
    border: 1px solid var(--border-2);
    background: var(--surface-2);
    color: var(--fg);
  }
  .site-foot {
    max-width: 1256px;
    margin: 0 auto;
    padding: 0 16px 40px;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 12px;
    font-size: 11px;
    color: var(--muted);
  }
  .site-foot::before {
    content: '';
    grid-column: 1 / -1;
    border-top: 1px solid var(--border);
    margin-bottom: 20px;
  }
  .site-foot a:hover { color: var(--accent); }
  .site-foot .motto { font-family: var(--mono); font-size: 9.5px; letter-spacing: 0.14em; color: var(--accent); }
  .site-foot .to-setup { display: inline-flex; align-items: center; gap: 6px; justify-self: end; }
  .btn.copied { color: var(--accent); border-color: var(--accent-line); }
  @media (max-width: 640px) {
    .site-foot { grid-template-columns: 1fr; justify-items: center; text-align: center; }
    .site-foot .to-setup { justify-self: center; }
  }
  ::selection { background: rgb(34 211 238 / 0.3); }
</style>
