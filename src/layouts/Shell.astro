---
import Intro from '../components/Intro.astro';
import '../styles/global.css';

interface Props {
  title?: string;
}
const { title } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="edgeycli.com: your AI models, API keys, and balance in one place." />
    <meta name="theme-color" content="#05080b" />
    <script is:inline>
      // Opening effect: every load of the home page, once per tab elsewhere, never with reduced motion.
      try {
        var home = location.pathname === '/' || location.pathname === '/index.html';
        if ((home || !sessionStorage.getItem('edgey-intro')) && !matchMedia('(prefers-reduced-motion: reduce)').matches)
          document.documentElement.classList.add('intro-on');
      } catch (e) {}
      // Browsers without cross-page view transitions get a simple fade-in instead.
      if (!('PageRevealEvent' in window)) document.documentElement.classList.add('no-vt');
    </script>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title ? `${title} · edgeycli.com` : 'edgeycli.com'}</title>
  </head>
  <body>
    <Intro />
    <div class="vt-line" aria-hidden="true"></div>
    <slot />
    <script>
      document.addEventListener('click', (e) => {
        const btn = (e.target as HTMLElement).closest<HTMLElement>('[data-copy]');
        if (!btn) return;
        navigator.clipboard?.writeText(btn.dataset.copy ?? '');
        btn.classList.add('copied');
        const label = btn.querySelector('.label');
        const prev = label?.textContent;
        if (label) label.textContent = 'Copied';
        setTimeout(() => {
          btn.classList.remove('copied');
          if (label) label.textContent = prev ?? '';
        }, 1200);
      });
    </script>
  </body>
</html>

<style is:global>
  :root {
    --bg: #05080b;
    --surface: #0a0f13;
    --surface-2: #0f161c;
    --border: #17222b;
    --border-2: #203039;
    --fg: #e8f1f5;
    --muted: #7d8d98;
    --accent: #22d3ee;
    --accent-2: #38bdf8;
    --accent-soft: rgb(34 211 238 / 0.08);
    --accent-line: rgb(34 211 238 / 0.28);
    --mono: ui-monospace, 'JetBrains Mono', 'Cascadia Code', 'Fira Code', Consolas, monospace;
    color-scheme: dark;
  }
  [hidden] { display: none !important; }
  /* Element resets sit in the base layer so Tailwind utilities (components/ui) can override them. */
  @layer base {
    * { box-sizing: border-box; margin: 0; padding: 0; }
    a { color: inherit; text-decoration: none; }
    button { font: inherit; color: inherit; background: none; border: 0; cursor: pointer; }
    input { font: inherit; color: inherit; }
  }
  html { -webkit-text-size-adjust: 100%; }
  body {
    background:
      radial-gradient(900px 600px at -10% -10%, rgb(34 211 238 / 0.09), transparent 60%),
      radial-gradient(700px 500px at 110% 10%, rgb(56 189 248 / 0.05), transparent 60%),
      var(--bg);
    background-attachment: fixed;
    color: var(--fg);
    font-family: system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
    font-size: 14px;
    line-height: 1.5;
    min-height: 100vh;
    -webkit-font-smoothing: antialiased;
  }
  code, .mono { font-family: var(--mono); }

  .card {
    background: linear-gradient(180deg, var(--surface-2), var(--surface));
    border: 1px solid var(--border);
    border-radius: 14px;
  }
  .card-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 12px;
  }
  .card-title { font-size: 13px; font-weight: 600; }
  .card-sub { font-size: 12px; color: var(--muted); margin-top: 4px; }
  .icon-btn {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    flex: none;
    border-radius: 8px;
    border: 1px solid var(--border-2);
    background: var(--bg);
    color: var(--fg);
    transition: color 0.15s, border-color 0.15s;
  }
  .icon-btn:hover { color: var(--accent); border-color: var(--accent-line); }
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    height: 38px;
    padding: 0 16px;
    border-radius: 8px;
    font-size: 12px;
    font-weight: 600;
    white-space: nowrap;
    border: 1px solid var(--border-2);
    background: var(--bg);
    transition: border-color 0.15s, color 0.15s, filter 0.15s;
  }
  .btn:hover { border-color: var(--accent-line); color: var(--accent); }
  .btn.primary {
    background: var(--accent);
    border-color: var(--accent);
    color: #031217;
  }
  .btn.primary:hover { filter: brightness(1.1); color: #031217; }
  .tag {
    font-family: var(--mono);
    font-size: 9px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .pill {
    display: inline-block;
    font-size: 10px;
    padding: 3px 8px;
    border-radius: 6px;
    border: 1px solid var(--accent-line);
    background: var(--accent-soft);
    color: var(--accent);
  }
  .g-icon {
    display: grid;
    place-items: center;
    flex: none;
    width: 32px;
    height: 32px;
    border-radius: 8px;
    border: 1px solid var(--border-2);
    background: var(--surface-2);
    color: var(--fg);
  }
  .btn.copied { color: var(--accent); border-color: var(--accent-line); }
  ::selection { background: rgb(34 211 238 / 0.3); }

  /* Page changes: native cross-page view transitions, no JS needed. */
  @media (prefers-reduced-motion: no-preference) {
    @view-transition { navigation: auto; }
    .no-vt .page,
    .no-vt .auth { animation: page-in 0.45s cubic-bezier(0.2, 0.8, 0.2, 1) both; }
  }
  ::view-transition-old(root) { animation: page-out 0.22s cubic-bezier(0.4, 0, 1, 1) both; }
  ::view-transition-new(root) { animation: page-in 0.45s cubic-bezier(0.2, 0.8, 0.2, 1) both; }
  ::view-transition-group(nav-active),
  ::view-transition-group(brand-logo) {
    animation-duration: 0.4s;
    animation-timing-function: cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  /* A cyan scan line sweeps the top edge on every page change. */
  .vt-line {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    height: 2px;
    opacity: 0;
    pointer-events: none;
    view-transition-name: scan;
  }
  ::view-transition-group(scan) {
    background: linear-gradient(90deg, transparent, var(--accent), transparent);
    box-shadow: 0 0 12px var(--accent);
    animation: scan 0.55s ease-out both;
  }
  @keyframes page-out {
    to { opacity: 0; transform: translateY(-6px); filter: blur(4px); }
  }
  @keyframes page-in {
    from { opacity: 0; transform: translateY(14px); filter: blur(6px); }
  }
  @keyframes scan {
    from { transform: translateX(-100%); opacity: 1; }
    70% { opacity: 1; }
    to { transform: translateX(100%); opacity: 0; }
  }
</style>
