---
import Icon from './Icon.astro';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const nav = [
  { href: '/', icon: 'grid', label: 'Overview' },
  { href: '/keys', icon: 'key', label: 'API keys' },
  { href: '/setup', icon: 'terminal', label: 'Setup', text: true },
  { href: '/models', icon: 'cpu', label: 'Models' },
  { href: '/activity', icon: 'activity', label: 'Activity' },
] as const;
---
<header class="top">
  <div class="inner">
    <a href="/" class="brand">
      <span class="logo"><Icon name="terminal" size={14} /></span>
      <span>edgey<span class="accent">cli</span>.com</span>
    </a>

    <nav>
      {nav.map((n) => (
        <a
          href={n.href}
          class:list={['nav-btn', { active: path === n.href, 'has-text': 'text' in n }]}
          title={n.label}
          aria-label={n.label}
        >
          <Icon name={n.icon} size={15} />
          {'text' in n && <span>{n.label}</span>}
        </a>
      ))}
    </nav>

    <div class="user">
      <button class="ghost" aria-label="Theme"><Icon name="sun" size={15} /></button>
      <span class="avatar">M</span>
      <span class="name">Member</span>
      <button class="ghost" aria-label="Log out"><Icon name="logout" size={15} /></button>
    </div>
  </div>
</header>

<style>
  .top {
    border-bottom: 1px solid var(--border);
    background: rgb(5 8 11 / 0.7);
    backdrop-filter: blur(8px);
    position: sticky;
    top: 0;
    z-index: 10;
  }
  .inner {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 16px;
    height: 72px;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 16px;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
    font-weight: 700;
    font-size: 17px;
    letter-spacing: -0.01em;
  }
  .logo {
    display: grid;
    place-items: center;
    width: 26px;
    height: 26px;
    border-radius: 7px;
    color: var(--accent);
    background: var(--accent-soft);
    border: 1px solid var(--accent-line);
  }
  .accent { color: var(--accent); }
  nav { display: flex; gap: 6px; }
  .nav-btn {
    display: flex;
    align-items: center;
    gap: 8px;
    height: 38px;
    min-width: 38px;
    justify-content: center;
    border-radius: 8px;
    color: var(--muted);
    border: 1px solid transparent;
    font-size: 12px;
    transition: color 0.15s, background 0.15s, border-color 0.15s;
  }
  .nav-btn.has-text { padding: 0 12px; border-color: var(--border); }
  .nav-btn:hover { color: var(--fg); background: var(--surface-2); }
  .nav-btn.active {
    color: var(--accent);
    background: var(--accent-soft);
    border-color: var(--accent-line);
  }
  .user {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 12px;
    font-size: 12px;
    font-weight: 600;
  }
  .avatar {
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
    border-radius: 999px;
    border: 1px solid var(--border);
    background: var(--surface-2);
    font-size: 10px;
  }
  @media (max-width: 760px) {
    .inner { grid-template-columns: 1fr auto; height: auto; padding: 12px 16px; }
    nav { grid-column: 1 / -1; grid-row: 2; justify-content: center; }
    .name { display: none; }
  }
</style>
