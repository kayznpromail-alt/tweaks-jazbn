---
import Icon from './Icon.astro';
import SiteNav from './SiteNav';

// Works for /api, /api/ and /api.html alike.
const path = Astro.url.pathname.replace(/(\.html|\/)$/, '') || '/';
---
<header class="top">
  <div class="inner">
    <a href="/overview" class="brand">
      <span class="logo"><Icon name="terminal" size={14} /></span>
      <span>edgey<span class="accent">cli</span></span>
    </a>

    <div class="nav-slot"><SiteNav client:load path={path} /></div>

    <div class="user">
      <button class="ghost" aria-label="Theme"><Icon name="sun" size={15} /></button>
      <span class="sep"></span>
      <span class="avatar">M</span>
      <span class="name">Member</span>
      <a href="/" class="ghost" aria-label="Log out" title="Log out"><Icon name="logout" size={15} /></a>
    </div>
  </div>
</header>

<style>
  .top {
    border-bottom: 1px solid var(--border);
    background: rgb(5 8 11 / 0.7);
    backdrop-filter: blur(8px);
    position: sticky;
    top: 0;
    z-index: 10;
  }
  .inner {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 16px;
    height: 72px;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 16px;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
    font-weight: 700;
    font-size: 17px;
    letter-spacing: -0.01em;
  }
  .logo {
    display: grid;
    place-items: center;
    width: 26px;
    height: 26px;
    border-radius: 7px;
    color: var(--accent);
    background: var(--accent-soft);
    border: 1px solid var(--accent-line);
  }
  .accent { color: var(--accent); }
  nav { display: flex; gap: 6px; }
  .nav-btn {
    display: flex;
    align-items: center;
    gap: 8px;
    height: 38px;
    min-width: 38px;
    justify-content: center;
    border-radius: 8px;
    color: var(--muted);
    border: 1px solid transparent;
    font-size: 12px;
    transition: color 0.15s, background 0.15s, border-color 0.15s;
  }
  .nav-btn.labeled { padding: 0 12px; font-weight: 600; }
  .nav-btn.boxed { border-color: var(--border); }
  .nav-btn:hover { color: var(--fg); background: var(--surface-2); }
  .nav-btn.active {
    color: var(--accent);
    background: var(--accent-soft);
    border-color: var(--accent-line);
  }
  .user {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 12px;
    font-size: 12px;
    font-weight: 600;
  }
  .avatar {
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
    border-radius: 8px;
    border: 1px solid var(--border);
    background: var(--surface-2);
    font-size: 10px;
  }
  .sep { width: 1px; height: 20px; background: var(--border-2); }
  /* Kept still during page changes; the active tab highlight slides to the new tab. */
  .top { view-transition-name: site-header; }
  .logo { view-transition-name: brand-logo; }
  .nav-slot { view-transition-name: site-nav; display: flex; justify-content: center; }
  .ghost { display: grid; place-items: center; transition: color 0.15s; }
  .ghost:hover { color: var(--accent); }
  @media (max-width: 760px) {
    .inner { grid-template-columns: 1fr auto; height: auto; padding: 12px 16px; }
    .inner { grid-template-columns: 1fr auto; }
    /* backdrop-filter would trap the fixed bar inside the header. */
    .top { backdrop-filter: none; background: var(--bg); }
    /* On phones the nav becomes a real bottom bar. */
    .nav-slot { position: fixed; left: 0; right: 0; bottom: 16px; z-index: 20; }
    :global(body) { padding-bottom: 84px; }
    .name { display: none; }
  }
</style>
