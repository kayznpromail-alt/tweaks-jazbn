---
import Icon from './Icon.astro';
import { providers } from '../data/site';

interface Props { full?: boolean }
const { full = false } = Astro.props;
---
<section class="card rates" id="models">
  <div class="card-head pad">
    <div>
      <p class="card-title">Model rates</p>
      <p class="card-sub">API units per token · by provider</p>
    </div>
    <a href="/models" class="icon-btn" aria-label="All models"><Icon name="cpu" /></a>
  </div>
  {providers.length === 0 ? (
    <div class="none">
      <span class="icon-btn"><Icon name="cpu" /></span>
      <p class="card-title">No models yet</p>
      <p class="card-sub">Models and their rates will show up here.</p>
    </div>
  ) : (
  <div class:list={['list', { full }]}>
    {providers.map((p, i) => (
      <details open={full && i === 0}>
        <summary>
          <span class="badge">{p.badge}</span>
          <span class="pname">{p.name}</span>
          <span class="count">{p.models.length}</span>
          <Icon name="chevronDown" size={14} class="chev" />
        </summary>
        <ul>
          {p.models.map((m) => (
            <li>
              <code>{m.id}</code>
              <span class="rate">×{m.rate.toFixed(1)}</span>
            </li>
          ))}
        </ul>
      </details>
    ))}
  </div>
  )}
  {!full && (
    <a href="/models" class="all">View all models <Icon name="arrowUpRight" size={13} /></a>
  )}
</section>

<style>
  .rates { display: flex; flex-direction: column; min-width: 0; }
  .pad { padding: 24px; border-bottom: 1px solid var(--border); }
  .list {
    padding: 14px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    max-height: 340px;
    overflow-y: auto;
    scrollbar-width: thin;
    scrollbar-color: var(--border-2) transparent;
  }
  .list.full { max-height: none; }
  .all {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 14px 24px;
    border-top: 1px solid var(--border);
    font-size: 11px;
    color: var(--muted);
    transition: color 0.15s;
  }
  .all:hover { color: var(--accent); }
  .none {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    padding: 40px 16px;
    text-align: center;
  }
  .none .icon-btn { width: 40px; height: 40px; margin-bottom: 6px; color: var(--accent); }
  details {
    border: 1px solid var(--border);
    border-radius: 10px;
    background: var(--bg);
  }
  summary {
    list-style: none;
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 12px 14px;
    cursor: pointer;
    font-size: 12px;
    font-weight: 600;
  }
  summary::-webkit-details-marker { display: none; }
  summary:hover .pname { color: var(--accent); }
  .badge {
    display: grid;
    place-items: center;
    width: 22px;
    height: 22px;
    border-radius: 6px;
    font-family: var(--mono);
    font-size: 11px;
    color: var(--accent);
    background: var(--accent-soft);
    border: 1px solid var(--accent-line);
  }
  .count {
    font-family: var(--mono);
    font-size: 9px;
    padding: 1px 6px;
    border-radius: 4px;
    border: 1px solid var(--border-2);
    color: var(--muted);
  }
  summary :global(.chev) { margin-left: auto; color: var(--muted); transition: transform 0.2s; }
  details[open] summary :global(.chev) { transform: rotate(180deg); }
  ul { list-style: none; border-top: 1px solid var(--border); padding: 6px 14px 10px; }
  li {
    display: flex;
    justify-content: space-between;
    padding: 6px 0;
    font-size: 11.5px;
    color: var(--muted);
  }
  li + li { border-top: 1px dashed var(--border); }
  .rate { font-family: var(--mono); color: var(--accent); }
</style>
