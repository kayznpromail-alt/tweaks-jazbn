---
import Icon from './Icon.astro';
---
<section class="card usage" id="usage">
  <div class="card-head pad">
    <div>
      <p class="card-title">Token usage</p>
      <p class="card-sub">Your API history</p>
    </div>
    <div class="seg" role="tablist" aria-label="Range">
      <button class="on" role="tab" aria-selected="true" data-range="24h">24h</button>
      <button role="tab" aria-selected="false" data-range="7d">7d</button>
      <button role="tab" aria-selected="false" data-range="30d">30d</button>
    </div>
  </div>
  <div class="body">
    <div class="stats">
      <div>
        <p class="big">0</p>
        <p class="card-sub" data-range-label>tokens / 24 hours</p>
      </div>
      <div class="right">
        <p class="card-sub" data-peak-label>Peak hourly</p>
        <p class="mid">0</p>
      </div>
    </div>
    <div class="chart">
      <div class="plot">
        <div class="grid" aria-hidden="true"><i></i><i></i><i></i><i></i></div>
        <span class="y0">0</span>
        <div class="empty">
          <span class="icon-btn"><Icon name="activity" /></span>
          <p class="card-title">No activity yet</p>
          <p class="card-sub">Your usage will appear after your first API request.</p>
          <a href="/setup" class="btn">Connect your first tool <Icon name="arrowUpRight" size={13} /></a>
        </div>
      </div>
      <div class="x-axis" data-x-axis aria-hidden="true"></div>
    </div>
  </div>
  <div class="foot">
    <span><i class="dot"></i>Usage reported by the API</span>
    <span>Hover over a point for details</span>
  </div>
</section>

<script>
  const RANGES = {
    '24h': { buckets: 24, step: 5, hourly: true, label: '24 hours', peak: 'Peak hourly' },
    '7d': { buckets: 7, step: 1, hourly: false, label: '7 days', peak: 'Peak daily' },
    '30d': { buckets: 30, step: 5, hourly: false, label: '30 days', peak: 'Peak daily' },
  } as const;
  type Range = keyof typeof RANGES;

  const timeFmt = new Intl.DateTimeFormat('en-US', { hour: '2-digit', minute: '2-digit' });
  const dayFmt = new Intl.DateTimeFormat('en-US', { month: 'short', day: 'numeric' });

  // Axis labels for the range: the first bucket, every `step` buckets, and the current one.
  function ticks(range: Range) {
    const { buckets, step, hourly } = RANGES[range];
    const end = new Date();
    if (hourly) end.setMinutes(0, 0, 0);
    const idx: number[] = [];
    for (let i = 0; i < buckets - 1; i += step) idx.push(i);
    idx.push(buckets - 1);
    return idx.map((i) => {
      const d = new Date(end);
      const back = buckets - 1 - i;
      if (hourly) d.setHours(d.getHours() - back);
      else d.setDate(d.getDate() - back);
      return { pos: (i / (buckets - 1)) * 100, text: (hourly ? timeFmt : dayFmt).format(d) };
    });
  }

  document.querySelectorAll<HTMLElement>('.usage').forEach((card) => {
    const tabs = card.querySelectorAll<HTMLButtonElement>('[data-range]');
    const label = card.querySelector('[data-range-label]');
    const peak = card.querySelector('[data-peak-label]');
    const axis = card.querySelector<HTMLElement>('[data-x-axis]');
    const select = (range: Range) => {
      tabs.forEach((b) => {
        const on = b.dataset.range === range;
        b.classList.toggle('on', on);
        b.setAttribute('aria-selected', String(on));
      });
      if (label) label.textContent = `tokens / ${RANGES[range].label}`;
      if (peak) peak.textContent = RANGES[range].peak;
      axis?.replaceChildren(
        ...ticks(range).map(({ pos, text }) => {
          const s = document.createElement('span');
          s.textContent = text;
          s.style.left = `${pos}%`;
          return s;
        }),
      );
    };
    tabs.forEach((t) => t.addEventListener('click', () => select(t.dataset.range as Range)));
    select('24h');
  });
</script>

<style>
  .usage { min-width: 0; }
  .pad { padding: 24px; border-bottom: 1px solid var(--border); }
  .seg {
    display: flex;
    padding: 3px;
    border-radius: 8px;
    border: 1px solid var(--border);
    background: var(--bg);
  }
  .seg button {
    font-size: 10px;
    padding: 6px 12px;
    border-radius: 6px;
    color: var(--muted);
  }
  .seg button.on { background: var(--surface-2); color: var(--accent); }
  .body { padding: 24px 24px 20px; }
  .stats { display: flex; justify-content: space-between; }
  .right { text-align: right; }
  .big { font-size: 38px; font-weight: 600; line-height: 1.1; }
  .mid { font-size: 20px; font-weight: 600; margin-top: 4px; }

  .chart { margin-top: 20px; padding-left: 20px; container-type: inline-size; }
  .plot { position: relative; height: 230px; border-bottom: 1px solid var(--border-2); }
  .grid {
    position: absolute;
    inset: 0;
    -webkit-mask-image: radial-gradient(ellipse 34% 48% at 50% 50%, transparent 60%, #000 100%);
    mask-image: radial-gradient(ellipse 34% 48% at 50% 50%, transparent 60%, #000 100%);
  }
  .grid i { position: absolute; left: 0; right: 0; border-top: 1px dashed var(--border-2); }
  .grid i:nth-child(1) { top: 0; }
  .grid i:nth-child(2) { top: 25%; }
  .grid i:nth-child(3) { top: 50%; }
  .grid i:nth-child(4) { top: 75%; }
  .y0 {
    position: absolute;
    left: -20px;
    bottom: 0;
    transform: translateY(50%);
    font-family: var(--mono);
    font-size: 9px;
    color: var(--muted);
  }
  .empty {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 6px;
    padding: 0 16px;
    text-align: center;
  }
  .empty .icon-btn { width: 40px; height: 40px; margin-bottom: 6px; color: var(--accent); }
  .empty .btn { margin-top: 10px; }
  .x-axis { position: relative; height: 16px; margin-top: 10px; }
  .x-axis :global(span) {
    position: absolute;
    top: 0;
    transform: translateX(-50%);
    font-family: var(--mono);
    font-size: 9.5px;
    color: var(--muted);
    white-space: nowrap;
  }
  .x-axis :global(span:first-child) { transform: none; }
  .x-axis :global(span:last-child) { transform: translateX(-100%); }
  @container (max-width: 520px) {
    .grid { display: none; }
    .x-axis :global(span:not(:first-child):not(:last-child)) { display: none; }
  }
  .foot {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 8px 16px;
    padding: 14px 24px;
    border-top: 1px solid var(--border);
    font-size: 10.5px;
    color: var(--muted);
  }
  .dot {
    display: inline-block;
    width: 6px;
    height: 6px;
    margin-right: 8px;
    border-radius: 50%;
    background: var(--accent);
    vertical-align: 1px;
  }
</style>
