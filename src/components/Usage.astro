---
import Icon from './Icon.astro';
---
<section class="card usage" id="usage">
  <div class="card-head pad">
    <div>
      <p class="card-title">Token usage</p>
      <p class="card-sub">Your API history</p>
    </div>
    <div class="seg" role="tablist">
      <button class="on" role="tab" aria-selected="true">24h</button>
      <button role="tab" aria-selected="false">7d</button>
      <button role="tab" aria-selected="false">30d</button>
    </div>
  </div>
  <div class="body">
    <div class="stats">
      <div>
        <p class="big">0</p>
        <p class="card-sub" data-range-label>tokens / 24 hours</p>
      </div>
      <div class="right">
        <p class="card-sub">Peak hourly</p>
        <p class="mid">0</p>
      </div>
    </div>
    <div class="empty">
      <span class="icon-btn"><Icon name="activity" /></span>
      <p class="card-title">No activity yet</p>
      <p class="card-sub">Your usage will appear after your first API request.</p>
    </div>
  </div>
</section>

<script>
  const labels: Record<string, string> = { '24h': '24 hours', '7d': '7 days', '30d': '30 days' };
  document.querySelectorAll<HTMLElement>('.usage').forEach((card) => {
    const tabs = card.querySelectorAll<HTMLButtonElement>('.seg button');
    const label = card.querySelector('[data-range-label]');
    tabs.forEach((t) =>
      t.addEventListener('click', () => {
        tabs.forEach((b) => {
          b.classList.toggle('on', b === t);
          b.setAttribute('aria-selected', String(b === t));
        });
        if (label) label.textContent = `tokens / ${labels[t.textContent ?? '24h']}`;
      }),
    );
  });
</script>

<style>
  .usage { min-width: 0; }
  .pad { padding: 24px; border-bottom: 1px solid var(--border); }
  .seg {
    display: flex;
    padding: 3px;
    border-radius: 8px;
    border: 1px solid var(--border);
    background: var(--bg);
  }
  .seg button {
    font-size: 10px;
    padding: 6px 12px;
    border-radius: 6px;
    color: var(--muted);
  }
  .seg button.on { background: var(--surface-2); color: var(--accent); }
  .body { padding: 24px; }
  .stats { display: flex; justify-content: space-between; }
  .right { text-align: right; }
  .big { font-size: 38px; font-weight: 600; line-height: 1.1; }
  .mid { font-size: 20px; font-weight: 600; margin-top: 4px; }
  .empty {
    margin-top: 28px;
    padding: 32px 16px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    text-align: center;
    border-block: 1px dashed var(--border);
    background: radial-gradient(closest-side, var(--accent-soft), transparent);
  }
  .empty .icon-btn { width: 40px; height: 40px; margin-bottom: 6px; color: var(--accent); }
</style>
