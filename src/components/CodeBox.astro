---
import Icon from './Icon.astro';

interface Props {
  code: string;
  wrap?: boolean;
}
const { code, wrap = false } = Astro.props;
---
<div class="codebox">
  <pre class:list={{ wrap }}><code>{code}</code></pre>
  <button class="copy" data-copy={code} aria-label="Copy" title="Copy"><Icon name="copy" size={14} /></button>
</div>

<style>
  .codebox {
    display: flex;
    align-items: center;
    gap: 12px;
    min-width: 0;
    padding: 12px 10px 12px 16px;
    border-radius: 10px;
    border: 1px solid var(--border);
    background: var(--surface-2);
  }
  pre {
    flex: 1;
    min-width: 0;
    overflow-x: auto;
    font-size: 11.5px;
    font-weight: 600;
    line-height: 1.75;
    color: var(--fg);
    scrollbar-width: thin;
    scrollbar-color: var(--border-2) transparent;
  }
  pre.wrap { white-space: pre-wrap; overflow-wrap: anywhere; }
  .copy {
    flex: none;
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    border-radius: 7px;
    color: var(--muted);
    transition: color 0.15s, background 0.15s;
  }
  .copy:hover,
  .copy:global(.copied) { color: var(--accent); background: var(--accent-soft); }
</style>
