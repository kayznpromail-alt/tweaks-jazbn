---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import CodeBox from '../components/CodeBox.astro';
import CodeRow from '../components/CodeRow.astro';
import GuidePanel from '../components/GuidePanel.astro';
import ShellSnippet from '../components/ShellSnippet.astro';
import { API_BASE, API_ROOT, DISCORD_URL } from '../data/site';

const KEY = 'YOUR_EDGEY_API_KEY';
const apiHost = new URL(API_ROOT).host;

// Served from public/install.cmd on the site.
const install = String.raw`curl.exe -fL https://cli.edgey.shop/install.cmd -o "%TEMP%\edgey-install.cmd" && call "%TEMP%\edgey-install.cmd"`;

const guides = [
  { id: 'cli', icon: 'terminal', title: 'edgeyCLI', desc: 'Terminal workspace for all supported models.', tag: 'Recommended' },
  { id: 'claude', icon: 'bot', title: 'Claude Code', desc: 'Use Claude through the standard Anthropic Messages API.' },
  { id: 'codex', icon: 'code', title: 'Codex & OpenAI', desc: 'Use the standard Chat Completions route.' },
] as const;
const extras = [
  { id: 'script', icon: 'code', title: 'Full API setup script', desc: 'Configure both standard clients with one script.' },
  { id: 'routes', icon: 'sliders', title: 'Models and API routes', desc: 'Discover models and API endpoints.' },
] as const;

const claudeCode = [
  { id: 'ps', label: 'PowerShell', code: `$env:ANTHROPIC_BASE_URL = "${API_ROOT}"\n$env:ANTHROPIC_API_KEY = "${KEY}"` },
  { id: 'sh', label: 'macOS / Linux', code: `export ANTHROPIC_BASE_URL="${API_ROOT}"\nexport ANTHROPIC_API_KEY="${KEY}"` },
];
const codex = [
  { id: 'ps', label: 'PowerShell', code: `$env:OPENAI_BASE_URL = "${API_BASE}"\n$env:OPENAI_API_KEY = "${KEY}"` },
  { id: 'sh', label: 'macOS / Linux', code: `export OPENAI_BASE_URL="${API_BASE}"\nexport OPENAI_API_KEY="${KEY}"` },
];
const fullScript = [
  {
    id: 'ps',
    label: 'PowerShell',
    code: [
      `$env:EDGEY_API_KEY = "${KEY}"`,
      `$env:ANTHROPIC_BASE_URL = "${API_ROOT}"`,
      `$env:ANTHROPIC_API_KEY = $env:EDGEY_API_KEY`,
      `$env:OPENAI_BASE_URL = "${API_BASE}"`,
      `$env:OPENAI_API_KEY = $env:EDGEY_API_KEY`,
    ].join('\n'),
  },
  {
    id: 'sh',
    label: 'macOS / Linux',
    code: [
      `export EDGEY_API_KEY="${KEY}"`,
      `export ANTHROPIC_BASE_URL="${API_ROOT}"`,
      `export ANTHROPIC_API_KEY="$EDGEY_API_KEY"`,
      `export OPENAI_BASE_URL="${API_BASE}"`,
      `export OPENAI_API_KEY="$EDGEY_API_KEY"`,
    ].join('\n'),
  },
];
const routes = [
  { label: 'List models', code: `curl ${API_BASE}/models -H "Authorization: Bearer $EDGEY_API_KEY"` },
  {
    label: 'OpenAI-compatible request',
    code: `curl ${API_BASE}/chat/completions -H "Authorization: Bearer $EDGEY_API_KEY" -H "Content-Type: application/json" -d '{"model":"MODEL_ID","messages":[{"role":"user","content":"Hello"}]}'`,
  },
  {
    label: 'Anthropic request',
    code: `curl ${API_BASE}/messages -H "x-api-key: $EDGEY_API_KEY" -H "anthropic-version: 2023-06-01" -H "Content-Type: application/json" -d '{"model":"MODEL_ID","max_tokens":128,"messages":[{"role":"user","content":"Hello"}]}'`,
  },
];
---
<Base title="Setup" crumb="CLI" heading="Connect your tools." sub="Your AI tools, in one place.">
  <section class="card setup" data-setup>
    <div class="top">
      <p class="card-title row"><Icon name="sliders" /> Connect your tools</p>
      <p class="card-sub">Choose a guide to connect your edgey key to a supported client.</p>
    </div>

    <div class="inner">
      <div class="guides">
        {guides.map((g, i) => (
          <button class:list={['guide', { on: i === 0 }]} data-guide={g.id} aria-pressed={String(i === 0)}>
            <span class="g-icon"><Icon name={g.icon} /></span>
            <Icon name="arrowUpRight" size={13} class="g-arrow" />
            <span class="t">{g.title}</span>
            <span class="d">{g.desc}</span>
            {'tag' in g && <span class="tag">{g.tag}</span>}
          </button>
        ))}
      </div>
      <div class="guides two">
        {extras.map((g) => (
          <button class="guide wide" data-guide={g.id} aria-pressed="false">
            <span class="g-icon"><Icon name={g.icon} /></span>
            <span class="txt">
              <span class="t">{g.title}</span>
              <span class="d">{g.desc}</span>
            </span>
            <Icon name="arrowUpRight" size={13} class="g-arrow" />
          </button>
        ))}
      </div>

      <GuidePanel id="cli" icon="terminal" title="edgeyCLI" open>
        <p class="platform">Windows · Command Prompt</p>
        <ol class="steps">
          <li>
            <span class="num">01</span>
            <div>
              <p class="t">Install edgeyCLI</p>
              <p class="d">Open Command Prompt (cmd.exe), then run this command.</p>
              <CodeBox code={install} />
            </div>
          </li>
          <li>
            <span class="num">02</span>
            <div>
              <p class="t">Enter your CLI key</p>
              <p class="d">Paste the CLI key you received with your purchase when the installer asks. This is separate from your edgey ID.</p>
              <a href={DISCORD_URL} class="keybox empty" target="_blank" rel="noopener">
                <span>No CLI key yet? Get one on Discord.</span>
                <Icon name="arrowUpRight" size={13} />
              </a>
            </div>
          </li>
          <li>
            <span class="num">03</span>
            <div>
              <p class="t">Start your workspace</p>
              <p class="d">Open a new terminal in your project folder and run <code>edgey</code>. Follow the first-run prompts and choose a model.</p>
              <CodeBox code="edgey" />
            </div>
          </li>
        </ol>
      </GuidePanel>

      <GuidePanel id="claude" icon="bot" title="Claude Code">
        <ShellSnippet shells={claudeCode}>
          <p slot="desc">Set these variables in the shell where Claude Code runs. The CLI adds <code>/v1/messages</code> to this base URL.</p>
          <p slot="note">Use your edgey API key from the API page. The key stays on your machine. Never paste it into a public repository, browser URL, or support message.</p>
        </ShellSnippet>
      </GuidePanel>

      <GuidePanel id="codex" icon="code" title="Codex and OpenAI-compatible clients">
        <ShellSnippet shells={codex}>
          <p slot="desc">Set the base URL to <code>{API_BASE}</code>. Use the model ID returned by <code>GET {API_BASE}/models</code>.</p>
          <p slot="note">For clients that ask for a custom endpoint, use <code>{API_BASE}/chat/completions</code> and send <code>Authorization: Bearer {KEY}</code>.</p>
        </ShellSnippet>
      </GuidePanel>

      <GuidePanel id="script" icon="code" title="Full API setup script">
        <ShellSnippet shells={fullScript}>
          <p slot="desc">The script sets both standard clients to {apiHost}. It does not contain a secret. Replace <code>{KEY}</code> with your edgey API key, then run it in the terminal where your client starts.</p>
          <p slot="note">To keep these settings, add the same lines to your PowerShell profile or shell startup file.</p>
        </ShellSnippet>
      </GuidePanel>

      <GuidePanel id="routes" icon="sliders" title="Models and API routes">
        <p class="platform">Models, limits, pricing multipliers and routing are applied by the gateway for your key.</p>
        <div class="route-rows">
          {routes.map((r) => <CodeRow label={r.label} code={r.code} wrap />)}
        </div>
      </GuidePanel>
    </div>

    <div class="foot">
      <span>All guides use the standard API routes and the same edgey balance.</span>
      <span class="row"><Icon name="lock" size={12} /> Keep your key private</span>
    </div>
  </section>
</Base>

<script>
  const root = document.querySelector<HTMLElement>('[data-setup]');
  if (root) {
    const cards = root.querySelectorAll<HTMLButtonElement>('[data-guide]');
    const panels = root.querySelectorAll<HTMLElement>('[data-panel]');
    const show = (id: string | null) => {
      cards.forEach((c) => {
        const on = c.dataset.guide === id;
        c.classList.toggle('on', on);
        c.setAttribute('aria-pressed', String(on));
      });
      panels.forEach((p) => (p.hidden = p.dataset.panel !== id));
    };
    cards.forEach((c) =>
      c.addEventListener('click', () => {
        show(c.dataset.guide ?? null);
        root.querySelector(`[data-panel="${c.dataset.guide}"]`)?.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      }),
    );
    root.querySelectorAll('[data-close]').forEach((b) => b.addEventListener('click', () => show(null)));
  }
</script>

<style>
  .setup { overflow: hidden; }
  .top { padding: 22px 24px; border-bottom: 1px solid var(--border); }
  .row { display: flex; align-items: center; gap: 10px; }
  .inner { display: flex; flex-direction: column; gap: 14px; padding: 22px; }

  .guides { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 14px; }
  .guides.two { grid-template-columns: 1fr 1fr; }
  .guide {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 6px;
    min-height: 150px;
    padding: 18px;
    text-align: left;
    border-radius: 12px;
    border: 1px solid var(--border);
    background: var(--bg);
    transition: border-color 0.15s, background 0.15s, box-shadow 0.15s;
  }
  .guide:hover { border-color: var(--border-2); background: var(--surface); }
  .guide.on {
    border-color: var(--accent-line);
    background: var(--accent-soft);
    box-shadow: 0 0 0 3px rgb(34 211 238 / 0.06);
  }
  .guide .g-icon { margin-bottom: 18px; }
  .guide.on .g-icon { color: var(--accent); border-color: var(--accent-line); }
  .guide :global(.g-arrow) { position: absolute; top: 18px; right: 18px; color: var(--muted); }
  .guide:hover :global(.g-arrow),
  .guide.on :global(.g-arrow) { color: var(--accent); }
  .t { font-size: 13px; font-weight: 600; }
  .d { font-size: 11.5px; color: var(--muted); }
  .guide .tag { margin-top: auto; padding-top: 14px; }
  .guide.wide { flex-direction: row; align-items: center; gap: 14px; min-height: 0; padding: 16px 18px; }
  .guide.wide .g-icon { margin: 0; }
  .guide.wide :global(.g-arrow) { position: static; margin-left: auto; flex: none; }
  .txt { display: flex; flex-direction: column; gap: 4px; }

  .platform {
    padding-bottom: 16px;
    margin-bottom: 4px;
    border-bottom: 1px solid var(--border);
    font-size: 11.5px;
    color: var(--muted);
  }
  .steps { list-style: none; }
  .steps li {
    display: grid;
    grid-template-columns: 26px minmax(0, 1fr);
    gap: 0 10px;
    padding: 18px 0;
    border-bottom: 1px solid var(--border);
  }
  .steps li:last-child { border-bottom: 0; padding-bottom: 0; }
  .num { font-family: var(--mono); font-size: 11px; color: var(--muted); padding-top: 1px; }
  .steps .d { margin: 4px 0 12px; }
  .steps code { color: var(--fg); font-weight: 600; }
  .keybox {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 14px 16px;
    border-radius: 10px;
    border: 1px solid var(--border);
    background: var(--surface-2);
    font-size: 12px;
  }
  .keybox.empty { border-style: dashed; background: none; color: var(--muted); transition: color 0.15s, border-color 0.15s; }
  .keybox.empty:hover { color: var(--accent); border-color: var(--accent-line); }
  .hint { margin-top: 10px; font-size: 10.5px; color: var(--muted); }
  .route-rows :global(.code-row) { padding: 16px 0; border-top: 1px solid var(--border); }
  .route-rows :global(.code-row:first-child) { border-top: 0; }
  .route-rows :global(.code-row:last-child) { padding-bottom: 0; }

  .foot {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 8px 16px;
    padding: 14px 24px;
    border-top: 1px solid var(--border);
    font-size: 10.5px;
    color: var(--muted);
  }
  .foot .row { gap: 6px; }

  @media (max-width: 860px) {
    .guides, .guides.two { grid-template-columns: 1fr; }
    .guide { min-height: 0; }
    .inner { padding: 14px; }
  }
</style>
