---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Connect from '../components/Connect.astro';
import { API_BASE } from '../data/site';

const steps = [
  { n: '01', title: 'Install edgeyCLI', cmd: 'npm install -g edgeycli' },
  { n: '02', title: 'Log in with your key', cmd: 'edgey login $EDGEY_API_KEY' },
  { n: '03', title: 'Start coding', cmd: 'edgey' },
];
const clients = [
  { name: 'Claude Code', env: `ANTHROPIC_BASE_URL=${API_BASE.replace(/\/v1$/, '')}\nANTHROPIC_AUTH_TOKEN=$EDGEY_API_KEY` },
  { name: 'Codex / OpenAI SDK', env: `OPENAI_BASE_URL=${API_BASE}\nOPENAI_API_KEY=$EDGEY_API_KEY` },
];
---
<Base title="Setup" crumb="SETUP" heading="Get set up." sub="Three commands and you're in.">
  <div class="steps">
    {steps.map((s) => (
      <section class="card step">
        <p class="n">{s.n}</p>
        <p class="card-title">{s.title}</p>
        <div class="cmd">
          <code><span class="p">$</span> {s.cmd}</code>
          <button class="icon-btn" data-copy={s.cmd} aria-label="Copy"><Icon name="copy" size={13} /><span class="label" hidden></span></button>
        </div>
      </section>
    ))}
  </div>

  <div class="clients">
    {clients.map((c) => (
      <section class="card client">
        <div class="card-head">
          <p class="card-title">{c.name}</p>
          <button class="btn" data-copy={c.env}><Icon name="copy" size={14} /><span class="label">Copy</span></button>
        </div>
        <pre><code>{c.env}</code></pre>
      </section>
    ))}
  </div>

  <div class="gap"><Connect /></div>
</Base>

<style>
  .steps { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
  .step { padding: 22px; display: flex; flex-direction: column; gap: 10px; }
  .n { font-family: var(--mono); font-size: 22px; font-weight: 700; color: var(--accent); }
  .cmd {
    margin-top: 6px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    padding: 8px 8px 8px 14px;
    border-radius: 8px;
    border: 1px solid var(--border);
    background: var(--bg);
    font-size: 12px;
    min-width: 0;
  }
  .cmd code { overflow-x: auto; white-space: nowrap; }
  .p { color: var(--accent); }
  .clients { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-top: 16px; }
  .client { padding: 22px; min-width: 0; }
  pre {
    margin-top: 14px;
    padding: 14px;
    border-radius: 8px;
    background: var(--bg);
    border: 1px solid var(--border);
    font-size: 11.5px;
    line-height: 1.7;
    color: #b9c7cf;
    overflow-x: auto;
  }
  .gap { margin-top: 32px; }
  @media (max-width: 860px) {
    .steps, .clients { grid-template-columns: 1fr; }
  }
</style>
