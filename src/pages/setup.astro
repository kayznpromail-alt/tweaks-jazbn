---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { API_ROOT, API_BASE, providers } from '../data/site';

const KEY = 'YOUR_EDGEY_API_KEY';

const install = String.raw`curl.exe -fL https://cli.edgey.shop/install.cmd -o "%TEMP%\edgey-install.cmd" && call "%TEMP%\edgey-install.cmd"`;

const claudeModels = providers.flatMap(p => p.models.filter(m => m.id.startsWith('claude-')).map(m => m.id));
const allModels = providers.flatMap(p => p.models.map(m => m.id));

const tabs = [
  { id: 'cli',     icon: 'terminal', title: 'edgeyCLI',               desc: 'Your terminal workspace' },
  { id: 'claude',  icon: 'bot',      title: 'Claude Code',            desc: 'Connect your coding agent' },
  { id: 'openai',  icon: 'cpu',      title: 'OpenAI-compatible API',  desc: 'Connect an app or SDK' },
  { id: 'env',     icon: 'sliders',  title: 'Environment variables',  desc: 'Configure both APIs' },
  { id: 'ref',     icon: 'code',     title: 'API reference',          desc: 'Models, routes and requests' },
] as const;

const routes = [
  { method: 'GET',  path: '/v1/models',            label: 'Models available to your key' },
  { method: 'POST', path: '/v1/chat/completions',  label: 'Chat Completions' },
  { method: 'POST', path: '/v1/messages',          label: 'Anthropic Messages' },
];
---
<Base title="Setup" crumb="CLI" heading="Setup" sub="Your tools. One API. The same wallet.">
  <section class="setup" data-setup>
    <!-- API key bar -->
    <div class="key-bar">
      <div class="key-icon"><Icon name="search" size={16} /></div>
      <div class="key-area">
        <span class="key-label">API key</span>
        <select class="key-select" data-key-select>
          <option value="">Select an API key</option>
        </select>
      </div>
      <span class="key-hint">Fills in your setup commands</span>
      <div class="key-actions">
        <button class="ka" data-key-eye title="Show key" aria-label="Show key"><Icon name="eye" size={15} /></button>
        <button class="ka" data-key-copy title="Copy key" aria-label="Copy key"><Icon name="copy" size={14} /> <span>Copy key</span></button>
        <a href="/api" class="ka manage">Manage keys <Icon name="arrowUpRight" size={11} /></a>
      </div>
    </div>

    <div class="layout">
      <!-- Sidebar -->
      <nav class="sidebar" aria-label="Connect a tool">
        <p class="sidebar-label">Connect a tool</p>
        {tabs.map((t, i) => (
          <button class:list={['nav-item', { on: i === 0 }]} data-nav={t.id} aria-pressed={String(i === 0)}>
            <span class="nav-icon"><Icon name={t.icon} size={16} /></span>
            <span class="nav-text">
              <span class="nav-title">{t.title}</span>
              <span class="nav-desc">{t.desc}</span>
            </span>
            <Icon name="arrowRight" size={13} class="nav-arrow" />
          </button>
        ))}
        <div class="gateway">
          <span class="gw-label">Gateway endpoint</span>
          <span class="gw-url">
            <span>{API_BASE}</span>
            <button class="gw-copy" data-copy={API_BASE} title="Copy"><Icon name="copy" size={12} /></button>
          </span>
        </div>
      </nav>

      <!-- Content panels -->
      <div class="content">

        <!-- edgeyCLI -->
        <div class="panel" data-panel="cli">
          <div class="panel-head">
            <span class="ph-icon"><Icon name="terminal" size={20} /></span>
            <div>
              <h2>edgeyCLI</h2>
              <p class="ph-sub">Install once, then work from any project folder.</p>
            </div>
            <span class="platform-badge">Windows</span>
          </div>
          <p class="platform-note"><Icon name="terminal" size={12} /> Command Prompt · cmd.exe</p>
          <ol class="steps">
            <li>
              <span class="num">01</span>
              <div>
                <p class="st">Install edgeyCLI</p>
                <p class="sd">Open Command Prompt and run the installer.</p>
                <div class="cb" data-label="Windows installer">
                  <span class="cb-label">Windows installer</span>
                  <div class="cb-box"><pre><code>{install}</code></pre><button class="copy-btn" data-copy={install}><Icon name="copy" size={14} /> Copy</button></div>
                </div>
              </div>
            </li>
            <li>
              <span class="num">02</span>
              <div>
                <p class="st">Connect your account</p>
                <p class="sd">When the installer asks, paste your API key from the bar above.</p>
                <p class="sd">Your CLI and website share the same token balance.</p>
                <a href="/api" class="link-action">Open API keys <Icon name="arrowUpRight" size={12} /></a>
              </div>
            </li>
            <li>
              <span class="num">03</span>
              <div>
                <p class="st">Start in your project</p>
                <p class="sd">Open a new terminal in your project folder. Launch the CLI and choose a model.</p>
                <div class="cb">
                  <span class="cb-label">Launch edgeyCLI</span>
                  <div class="cb-box"><pre><code>edgey</code></pre><button class="copy-btn" data-copy="edgey"><Icon name="copy" size={14} /> Copy</button></div>
                </div>
              </div>
            </li>
          </ol>
          <div class="panel-foot">
            <span>Keep your API key private.</span>
            <a href="/support" class="foot-link">Need help? <Icon name="arrowUpRight" size={11} /></a>
          </div>
        </div>

        <!-- Claude Code -->
        <div class="panel" data-panel="claude" hidden>
          <div class="panel-head">
            <span class="ph-icon"><Icon name="bot" size={20} /></span>
            <div>
              <h2>Claude Code</h2>
              <p class="ph-sub">Connect with your existing account and API balance.</p>
            </div>
            <div class="model-sel" data-model-group="claude">
              <select data-model-select>
                {claudeModels.map((m, i) => <option value={m} selected={i === 0}>{m}</option>)}
              </select>
            </div>
          </div>
          <div class="shell-tabs" data-shells>
            <div class="seg">
              <button class="on" data-shell="ps">PowerShell</button>
              <button data-shell="sh">macOS / Linux</button>
            </div>
          </div>
          <ol class="steps">
            <li>
              <span class="num">01</span>
              <div>
                <p class="st">Set your API key</p>
                <p class="sd">Select an API key above to fill in the command.</p>
                <div class="cb">
                  <span class="cb-label">API key environment</span>
                  <div class="cb-box" data-shell-row="ps"><pre><code data-tpl="key-ps">{`$env:EDGEY_API_KEY = "${KEY}"`}</code></pre><button class="copy-btn" data-copy={`$env:EDGEY_API_KEY = "${KEY}"`}><Icon name="copy" size={14} /> Copy</button></div>
                  <div class="cb-box" data-shell-row="sh" hidden><pre><code data-tpl="key-sh">{`export EDGEY_API_KEY="${KEY}"`}</code></pre><button class="copy-btn" data-copy={`export EDGEY_API_KEY="${KEY}"`}><Icon name="copy" size={14} /> Copy</button></div>
                </div>
              </div>
            </li>
            <li>
              <span class="num">02</span>
              <div>
                <p class="st">Configure Claude Code</p>
                <p class="sd">Requires an existing Claude Code installation. These settings apply to the current terminal.</p>
                <div class="cb">
                  <span class="cb-label">Claude environment</span>
                  <div class="cb-box" data-shell-row="ps"><pre><code data-tpl="claude-env-ps">{`$env:ANTHROPIC_BASE_URL = "${API_ROOT}"\n$env:ANTHROPIC_API_KEY = "${KEY}"\n$env:ANTHROPIC_MODEL = "${claudeModels[0]}"`}</code></pre><button class="copy-btn"><Icon name="copy" size={14} /> Copy</button></div>
                  <div class="cb-box" data-shell-row="sh" hidden><pre><code data-tpl="claude-env-sh">{`export ANTHROPIC_BASE_URL="${API_ROOT}"\nexport ANTHROPIC_API_KEY="${KEY}"\nexport ANTHROPIC_MODEL="${claudeModels[0]}"`}</code></pre><button class="copy-btn"><Icon name="copy" size={14} /> Copy</button></div>
                </div>
              </div>
            </li>
            <li>
              <span class="num">03</span>
              <div>
                <p class="st">Open your project</p>
                <p class="sd">Run this from your project folder.</p>
                <div class="cb">
                  <span class="cb-label">Launch Claude Code</span>
                  <div class="cb-box"><pre><code data-tpl="claude-launch">{`claude --model "${claudeModels[0]}"`}</code></pre><button class="copy-btn"><Icon name="copy" size={14} /> Copy</button></div>
                </div>
              </div>
            </li>
          </ol>
          <div class="panel-foot">
            <span>Keep your API key private.</span>
            <a href="/support" class="foot-link">Need help? <Icon name="arrowUpRight" size={11} /></a>
          </div>
        </div>

        <!-- OpenAI-compatible API -->
        <div class="panel" data-panel="openai" hidden>
          <div class="panel-head">
            <span class="ph-icon"><Icon name="cpu" size={20} /></span>
            <div>
              <h2>OpenAI-compatible API</h2>
              <p class="ph-sub">Connect with your existing account and API balance.</p>
            </div>
            <div class="model-sel" data-model-group="all">
              <select data-model-select>
                {allModels.map((m, i) => <option value={m} selected={i === 0}>{m}</option>)}
              </select>
            </div>
          </div>
          <div class="shell-tabs" data-shells>
            <div class="seg">
              <button class="on" data-shell="ps">PowerShell</button>
              <button data-shell="sh">macOS / Linux</button>
            </div>
          </div>
          <ol class="steps">
            <li>
              <span class="num">01</span>
              <div>
                <p class="st">Set your API key</p>
                <p class="sd">Select an API key above to fill in the command.</p>
                <div class="cb">
                  <span class="cb-label">API key environment</span>
                  <div class="cb-box" data-shell-row="ps"><pre><code>{`$env:EDGEY_API_KEY = "${KEY}"`}</code></pre><button class="copy-btn" data-copy={`$env:EDGEY_API_KEY = "${KEY}"`}><Icon name="copy" size={14} /> Copy</button></div>
                  <div class="cb-box" data-shell-row="sh" hidden><pre><code>{`export EDGEY_API_KEY="${KEY}"`}</code></pre><button class="copy-btn" data-copy={`export EDGEY_API_KEY="${KEY}"`}><Icon name="copy" size={14} /> Copy</button></div>
                </div>
              </div>
            </li>
            <li>
              <span class="num">02</span>
              <div>
                <p class="st">Set the API endpoint</p>
                <p class="sd">For OpenAI-compatible apps and SDKs that support a custom base URL.</p>
                <div class="cb">
                  <span class="cb-label">OpenAI environment</span>
                  <div class="cb-box" data-shell-row="ps"><pre><code data-tpl="openai-env-ps">{`$env:OPENAI_BASE_URL = "${API_BASE}"\n$env:OPENAI_API_KEY = "${KEY}"`}</code></pre><button class="copy-btn"><Icon name="copy" size={14} /> Copy</button></div>
                  <div class="cb-box" data-shell-row="sh" hidden><pre><code data-tpl="openai-env-sh">{`export OPENAI_BASE_URL="${API_BASE}"\nexport OPENAI_API_KEY="${KEY}"`}</code></pre><button class="copy-btn"><Icon name="copy" size={14} /> Copy</button></div>
                </div>
              </div>
            </li>
            <li>
              <span class="num">03</span>
              <div>
                <p class="st">Send your first request</p>
                <p class="sd">A successful request returns a model response and uses tokens from your wallet.</p>
                <div class="cb">
                  <span class="cb-label">Chat Completions request</span>
                  <div class="cb-box" data-shell-row="ps"><pre class="wrap"><code data-tpl="openai-req-ps">{`$body = '{"model":"${allModels[0]}","messages":[{"role":"user","content":"Hello"}],"max_tokens":128}'\nInvoke-RestMethod -Method Post "${API_BASE}/chat/completions" \`\n  -Headers @{ Authorization = "Bearer ${KEY}" } \`\n  -ContentType "application/json" -Body $body`}</code></pre><button class="copy-btn"><Icon name="copy" size={14} /> Copy</button></div>
                  <div class="cb-box" data-shell-row="sh" hidden><pre class="wrap"><code data-tpl="openai-req-sh">{`curl ${API_BASE}/chat/completions \\\n  -H "Authorization: Bearer ${KEY}" \\\n  -H "Content-Type: application/json" \\\n  -d '{"model":"${allModels[0]}","messages":[{"role":"user","content":"Hello"}],"max_tokens":128}'`}</code></pre><button class="copy-btn"><Icon name="copy" size={14} /> Copy</button></div>
                </div>
              </div>
            </li>
          </ol>
          <div class="check-row"><Icon name="check" size={14} /> <span>Check your connection</span> <code>GET /v1/models</code></div>
          <div class="panel-foot">
            <span>Keep your API key private.</span>
            <a href="/support" class="foot-link">Need help? <Icon name="arrowUpRight" size={11} /></a>
          </div>
        </div>

        <!-- Environment variables -->
        <div class="panel" data-panel="env" hidden>
          <div class="panel-head">
            <span class="ph-icon"><Icon name="sliders" size={20} /></span>
            <div>
              <h2>Environment variables</h2>
              <p class="ph-sub">Connect with your existing account and API balance.</p>
            </div>
          </div>
          <div class="shell-tabs" data-shells>
            <div class="seg">
              <button class="on" data-shell="ps">PowerShell</button>
              <button data-shell="sh">macOS / Linux</button>
              <button data-shell="cmd">CMD</button>
            </div>
          </div>
          <ol class="steps">
            <li>
              <span class="num">01</span>
              <div>
                <p class="st">Set your API key</p>
                <p class="sd">Select an API key above to fill in the command.</p>
                <div class="cb">
                  <span class="cb-label">API key environment</span>
                  <div class="cb-box" data-shell-row="ps"><pre><code>{`$env:EDGEY_API_KEY = "${KEY}"`}</code></pre><button class="copy-btn" data-copy={`$env:EDGEY_API_KEY = "${KEY}"`}><Icon name="copy" size={14} /> Copy</button></div>
                  <div class="cb-box" data-shell-row="sh" hidden><pre><code>{`export EDGEY_API_KEY="${KEY}"`}</code></pre><button class="copy-btn" data-copy={`export EDGEY_API_KEY="${KEY}"`}><Icon name="copy" size={14} /> Copy</button></div>
                  <div class="cb-box" data-shell-row="cmd" hidden><pre><code>{`set EDGEY_API_KEY=${KEY}`}</code></pre><button class="copy-btn" data-copy={`set EDGEY_API_KEY=${KEY}`}><Icon name="copy" size={14} /> Copy</button></div>
                </div>
              </div>
            </li>
            <li>
              <span class="num">02</span>
              <div>
                <p class="st">Configure both APIs</p>
                <p class="sd">Set the base URLs and credentials for clients that read these environment variables.</p>
                <div class="cb">
                  <span class="cb-label">API environment</span>
                  <div class="cb-box" data-shell-row="ps"><pre><code>{`$env:OPENAI_BASE_URL = "${API_BASE}"\n$env:OPENAI_API_KEY = "${KEY}"\n$env:ANTHROPIC_BASE_URL = "${API_ROOT}"\n$env:ANTHROPIC_API_KEY = "${KEY}"`}</code></pre><button class="copy-btn"><Icon name="copy" size={14} /> Copy</button></div>
                  <div class="cb-box" data-shell-row="sh" hidden><pre><code>{`export OPENAI_BASE_URL="${API_BASE}"\nexport OPENAI_API_KEY="${KEY}"\nexport ANTHROPIC_BASE_URL="${API_ROOT}"\nexport ANTHROPIC_API_KEY="${KEY}"`}</code></pre><button class="copy-btn"><Icon name="copy" size={14} /> Copy</button></div>
                  <div class="cb-box" data-shell-row="cmd" hidden><pre><code>{`set OPENAI_BASE_URL=${API_BASE}\nset OPENAI_API_KEY=${KEY}\nset ANTHROPIC_BASE_URL=${API_ROOT}\nset ANTHROPIC_API_KEY=${KEY}`}</code></pre><button class="copy-btn"><Icon name="copy" size={14} /> Copy</button></div>
                </div>
                <p class="sd hint">Session only — run your client from this terminal. Use the dedicated Claude Code guide for that tool.</p>
              </div>
            </li>
          </ol>
          <div class="check-row"><Icon name="check" size={14} /> <span>Check your connection</span> <code>GET /v1/models</code></div>
          <div class="panel-foot">
            <span>Keep your API key private.</span>
            <a href="/support" class="foot-link">Need help? <Icon name="arrowUpRight" size={11} /></a>
          </div>
        </div>

        <!-- API reference -->
        <div class="panel" data-panel="ref" hidden>
          <div class="panel-head">
            <span class="ph-icon"><Icon name="code" size={20} /></span>
            <div>
              <h2>API reference</h2>
              <p class="ph-sub">Standard routes supported by your gateway.</p>
            </div>
            <div class="model-sel" data-model-group="all">
              <select data-model-select>
                {allModels.map((m, i) => <option value={m} selected={i === 0}>{m}</option>)}
              </select>
            </div>
          </div>
          <div class="shell-tabs" data-shells>
            <div class="seg">
              <button class="on" data-shell="ps">PowerShell</button>
              <button data-shell="sh">macOS / Linux</button>
            </div>
          </div>
          <table class="route-table">
            <tbody>
              {routes.map(r => (
                <tr>
                  <td><span class:list={['method', r.method.toLowerCase()]}>{r.method}</span></td>
                  <td class="route-path">{r.path}</td>
                  <td class="route-label">{r.label}</td>
                </tr>
              ))}
            </tbody>
          </table>
          <ol class="steps">
            <li>
              <span class="num">01</span>
              <div>
                <p class="st">Set your API key</p>
                <p class="sd">Select an API key above to fill in the command.</p>
                <div class="cb">
                  <span class="cb-label">API key environment</span>
                  <div class="cb-box" data-shell-row="ps"><pre><code>{`$env:EDGEY_API_KEY = "${KEY}"`}</code></pre><button class="copy-btn" data-copy={`$env:EDGEY_API_KEY = "${KEY}"`}><Icon name="copy" size={14} /> Copy</button></div>
                  <div class="cb-box" data-shell-row="sh" hidden><pre><code>{`export EDGEY_API_KEY="${KEY}"`}</code></pre><button class="copy-btn" data-copy={`export EDGEY_API_KEY="${KEY}"`}><Icon name="copy" size={14} /> Copy</button></div>
                </div>
              </div>
            </li>
            <li>
              <span class="num">02</span>
              <div>
                <p class="st">Try a Chat Completions request</p>
                <p class="sd">Choose a compatible model from your catalog. This request uses wallet tokens.</p>
                <div class="cb">
                  <span class="cb-label">Chat Completions request</span>
                  <div class="cb-box" data-shell-row="ps"><pre class="wrap"><code data-tpl="ref-req-ps">{`$body = '{"model":"${allModels[0]}","messages":[{"role":"user","content":"Hello"}],"max_tokens":128}'\nInvoke-RestMethod -Method Post "${API_BASE}/chat/completions" \`\n  -Headers @{ Authorization = "Bearer ${KEY}" } \`\n  -ContentType "application/json" -Body $body`}</code></pre><button class="copy-btn"><Icon name="copy" size={14} /> Copy</button></div>
                  <div class="cb-box" data-shell-row="sh" hidden><pre class="wrap"><code data-tpl="ref-req-sh">{`curl ${API_BASE}/chat/completions \\\n  -H "Authorization: Bearer ${KEY}" \\\n  -H "Content-Type: application/json" \\\n  -d '{"model":"${allModels[0]}","messages":[{"role":"user","content":"Hello"}],"max_tokens":128}'`}</code></pre><button class="copy-btn"><Icon name="copy" size={14} /> Copy</button></div>
                </div>
              </div>
            </li>
          </ol>
          <div class="check-row"><Icon name="check" size={14} /> <span>Check your connection</span> <code>GET /v1/models</code></div>
          <div class="panel-foot">
            <span>Keep your API key private.</span>
            <a href="/support" class="foot-link">Need help? <Icon name="arrowUpRight" size={11} /></a>
          </div>
        </div>

      </div>
    </div>
  </section>
</Base>

<script>
  import { API_ENABLED, api } from '../lib/api';

  const root = document.querySelector<HTMLElement>('[data-setup]')!;
  const isWindows = /Win/i.test(navigator.userAgent);

  // Sidebar navigation
  const navItems = root.querySelectorAll<HTMLButtonElement>('[data-nav]');
  const panels = root.querySelectorAll<HTMLElement>('[data-panel]');
  navItems.forEach(btn => btn.addEventListener('click', () => {
    const id = btn.dataset.nav!;
    navItems.forEach(n => { n.classList.toggle('on', n.dataset.nav === id); n.setAttribute('aria-pressed', String(n.dataset.nav === id)); });
    panels.forEach(p => p.hidden = p.dataset.panel !== id);
  }));

  // Shell tabs (per panel)
  root.querySelectorAll<HTMLElement>('[data-shells]').forEach(group => {
    const panel = group.closest('[data-panel]')!;
    const tabs = group.querySelectorAll<HTMLButtonElement>('[data-shell]');
    const rows = panel.querySelectorAll<HTMLElement>('[data-shell-row]');
    const select = (id: string) => {
      tabs.forEach(t => { t.classList.toggle('on', t.dataset.shell === id); });
      rows.forEach(r => r.hidden = r.dataset.shellRow !== id);
    };
    tabs.forEach(t => t.addEventListener('click', () => select(t.dataset.shell!)));
    if (!isWindows && group.querySelector('[data-shell="sh"]')) select('sh');
  });

  // Copy buttons
  root.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('.copy-btn, [data-copy]');
    if (!btn) return;
    let text = btn.dataset.copy;
    if (!text) {
      const box = btn.closest('.cb-box');
      text = box?.querySelector('code')?.textContent ?? '';
    }
    navigator.clipboard.writeText(text).then(() => {
      btn.classList.add('copied');
      const span = btn.querySelector('span');
      const prev = span?.textContent;
      if (span) span.textContent = 'Copied!';
      setTimeout(() => { btn.classList.remove('copied'); if (span && prev) span.textContent = prev; }, 1500);
    });
  });

  // Load keys into the selector
  if (API_ENABLED) {
    api('/keys').then((data: any) => {
      const sel = root.querySelector<HTMLSelectElement>('[data-key-select]');
      if (!sel || !data.keys?.length) return;
      data.keys.forEach((k: any) => {
        const opt = document.createElement('option');
        opt.value = k.masked;
        opt.textContent = `${k.name || k.masked}`;
        opt.dataset.masked = k.masked;
        sel.appendChild(opt);
      });
    }).catch(() => {});
  }

  // Key copy button
  root.querySelector('[data-key-copy]')?.addEventListener('click', () => {
    const sel = root.querySelector<HTMLSelectElement>('[data-key-select]');
    if (sel?.value) navigator.clipboard.writeText(sel.value);
  });
</script>

<style>
  .setup { overflow: hidden; border-radius: 16px; border: 1px solid var(--border); background: var(--surface); }

  /* Key bar */
  .key-bar {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 14px 20px;
    border-bottom: 1px solid var(--border);
    flex-wrap: wrap;
  }
  .key-icon { color: var(--accent); }
  .key-area { display: flex; flex-direction: column; gap: 2px; }
  .key-label { font-size: 11px; font-weight: 600; }
  .key-select {
    background: none;
    border: none;
    color: var(--muted);
    font-size: 12px;
    cursor: pointer;
    padding: 0;
  }
  .key-select:focus { outline: none; color: var(--fg); }
  .key-hint { font-size: 11px; color: var(--accent); margin-left: 8px; }
  .key-actions { display: flex; align-items: center; gap: 6px; margin-left: auto; }
  .ka {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 10px;
    border-radius: 7px;
    font-size: 11px;
    color: var(--muted);
    border: 1px solid var(--border);
