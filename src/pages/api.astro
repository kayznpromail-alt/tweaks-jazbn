---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import CodeBox from '../components/CodeBox.astro';
import Connect from '../components/Connect.astro';
import { DISCORD_URL, keys, MAX_KEYS } from '../data/site';

const install = String.raw`curl.exe -fL https://cli.edgey.shop/install.cmd -o "%TEMP%\edgey-install.cmd" && call "%TEMP%\edgey-install.cmd"`;
---
<Base title="API" crumb="API" heading="Your API keys." sub="Create keys, connect your tools, track your balance.">
  <section class="card">
    <div class="card-head pad">
      <div>
        <h2>Your API keys</h2>
        <p class="card-sub">Create keys for your apps. They all use your edgey balance.</p>
      </div>
      <div class="count">
        <p class="mono"><span data-count>{keys.length}</span> / {MAX_KEYS} keys</p>
      </div>
    </div>
    <form class="create" data-create>
      <input placeholder="Key name, e.g. My laptop" aria-label="Key name" maxlength="40" data-key-name />
      <button class="btn primary"><Icon name="plus" size={14} /> Create API key</button>
    </form>
    <p class="msg" data-key-msg role="status" hidden></p>
    <div class="newkey" data-newkey hidden>
      <p class="strong">Your new key. Copy it now, it will not be shown again.</p>
      <div class="newkey-row">
        <code data-newkey-value></code>
        <button type="button" class="btn" data-newkey-copy><Icon name="copy" size={14} /> <span class="label">Copy</span></button>
      </div>
    </div>
    <div class="table-wrap">
      <table>
        <thead>
          <tr><th>Name / key</th><th>Budget / models</th><th>Status</th><th>Actions</th></tr>
        </thead>
        <tbody data-keys>
          {keys.map((k) => (
            <tr>
              <td><p class="strong">{k.name}</p><code class="muted">{k.masked}</code></td>
              <td><p class="strong">{k.budget}</p><p class="muted">{k.models}</p></td>
              <td><span class="pill">{k.enabled ? 'Enabled' : 'Disabled'}</span></td>
              <td>
                <div class="actions">
                  <button class="icon-btn" aria-label="Rename"><Icon name="pencil" size={14} /></button>
                  <button class="icon-btn" aria-label="Rotate key"><Icon name="key" size={14} /></button>
                </div>
              </td>
            </tr>
          ))}
          {keys.length === 0 && (
            <tr><td colspan="4" class="empty">No API keys yet. Create your first key above.</td></tr>
          )}
        </tbody>
      </table>
    </div>
  </section>

  <div class="gap"><Connect /></div>

  <div class="cli-block" data-cli-block hidden>
    <p class="block-title">Your CLI key</p>
    <section class="card key-card">
    <div class="card-head pad">
      <div>
        <h2>Your CLI key</h2>
        <p class="card-sub">Delivered with your purchase. Keep it private, like a password.</p>
      </div>
      <div class="state" data-cli-state="none"><i></i><span data-cli="status">Not linked</span></div>
    </div>
    <div class="keyline">
      <code data-cli="masked">No CLI key yet</code>
    </div>
    <dl class="facts">
      <div><dt>Plan</dt><dd data-cli="plan">–</dd></div>
      <div><dt>Tokens available</dt><dd data-cli="available">–</dd></div>
      <div><dt>Expires</dt><dd data-cli="expires">–</dd></div>
      <div><dt>Last checked</dt><dd data-cli="updated">–</dd></div>
    </dl>
  </section>

  <section class="card pad install">
    <p class="card-title row"><Icon name="terminal" /> Install edgeyCLI</p>
    <p class="card-sub">Open Command Prompt (cmd.exe), run this command, then paste your CLI key when asked.</p>
    <CodeBox code={install} />
    <p class="card-sub">Then open a new terminal in your project folder and run <code>edgey</code>. <a href="/setup">Full guide</a></p>
  </section>

  <a href={DISCORD_URL} class="card pad help" target="_blank" rel="noopener">
    <span class="icon-btn big"><Icon name="shield" size={18} /></span>
    <span class="grow">
      <span class="card-title">Lost or leaked your key?</span>
      <span class="card-sub">Contact us on Discord and we will replace it. Staff will never ask for your key.</span>
    </span>
    <span class="btn">Discord <Icon name="arrowUpRight" size={13} /></span>
  </a>
  </div>
</Base>

<script>
  import { fillCli, type Cli } from '../lib/cli';

  import { paths } from '../components/icons';
  import { API_ENABLED, ApiError, api } from '../lib/api';

  type Key = { id: number; name: string; masked: string; enabled: boolean };
  const tbody = document.querySelector<HTMLElement>('[data-keys]')!;
  const msg = document.querySelector<HTMLElement>('[data-key-msg]')!;
  const say = (text: string) => {
    msg.textContent = text;
    msg.hidden = !text;
  };
  const icon = (name: keyof typeof paths) =>
    `<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${paths[name]}</svg>`;

  function row(k: Key) {
    const tr = document.createElement('tr');
    tr.innerHTML = `
      <td><p class="strong"></p><code class="muted"></code></td>
      <td><p class="strong">Uses shared wallet</p><p class="muted">All offered models</p></td>
      <td><span class="pill ${k.enabled ? '' : 'off'}">${k.enabled ? 'Enabled' : 'Disabled'}</span></td>
      <td><div class="actions">
        <button class="icon-btn" data-act="rename" aria-label="Rename">${icon('pencil')}</button>
        <button class="icon-btn" data-act="toggle" aria-label="${k.enabled ? 'Disable' : 'Enable'}">${icon(k.enabled ? 'eyeOff' : 'eye')}</button>
        <button class="icon-btn" data-act="delete" aria-label="Delete">${icon('x')}</button>
      </div></td>`;
    tr.querySelector('p.strong')!.textContent = k.name;
    tr.querySelector('code')!.textContent = k.masked;
    tr.querySelectorAll<HTMLButtonElement>('[data-act]').forEach((b) =>
      b.addEventListener('click', async () => {
        try {
          if (b.dataset.act === 'rename') {
            const name = prompt('New name for this key', k.name)?.trim();
            if (name) await api(`/keys/${k.id}`, { method: 'PATCH', body: { name } });
          } else if (b.dataset.act === 'toggle') {
            await api(`/keys/${k.id}`, { method: 'PATCH', body: { enabled: !k.enabled } });
          } else if (confirm(`Delete "${k.name}"? Apps using it will stop working.`)) {
            await api(`/keys/${k.id}`, { method: 'DELETE' });
          }
          await load();
        } catch {
          say('That did not work. Try again.');
        }
      }),
    );
    return tr;
  }

  async function load() {
    const { keys } = await api<{ keys: Key[] }>('/keys');
    tbody.replaceChildren(...keys.map(row));
    if (!keys.length) tbody.innerHTML = '<tr><td colspan="4" class="empty">No API keys yet. Create your first key above.</td></tr>';
    document.querySelector('[data-count]')!.textContent = String(keys.length);
  }

  const form = document.querySelector<HTMLFormElement>('[data-create]')!;
  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!API_ENABLED) return say('Keys can be created once your account is live.');
    const input = form.querySelector<HTMLInputElement>('[data-key-name]')!;
    try {
      const created = await api<Key & { key: string }>('/keys', { method: 'POST', body: { name: input.value } });
      input.value = '';
      say('');
      document.querySelector('[data-newkey-value]')!.textContent = created.key;
      document.querySelector<HTMLElement>('[data-newkey-copy]')!.dataset.copy = created.key;
      document.querySelector<HTMLElement>('[data-newkey]')!.hidden = false;
      await load();
    } catch (err) {
      say(err instanceof ApiError && err.code === 'key_limit' ? 'You already have the maximum number of keys.' : 'Could not create the key. Try again.');
    }
  });

  if (API_ENABLED) load();

  // The CLI key block only appears for accounts that have one.
  if (API_ENABLED)
    api<{ cli: Cli }>('/me').then(({ cli }) => {
      if (!cli) return;
      fillCli(cli);
      document.querySelector<HTMLElement>('[data-cli-block]')!.hidden = false;
    });
</script>

<style>
  .pad { padding: 24px; }
  h2 { font-size: 20px; letter-spacing: -0.02em; }
  .count { text-align: right; }
  .count .mono { font-size: 14px; font-weight: 600; }
  .create {
    display: flex;
    gap: 12px;
    padding: 0 24px 20px;
    border-bottom: 1px solid var(--border);
  }
  .create input {
    flex: 0 1 400px;
    min-width: 0;
    height: 40px;
    padding: 0 14px;
    border-radius: 8px;
    border: 1px solid var(--border-2);
    background: var(--bg);
    outline: none;
  }
  .create input:focus { border-color: var(--accent-line); box-shadow: 0 0 0 3px var(--accent-soft); }
  .create .btn { height: 40px; }
  .table-wrap { overflow-x: auto; }
  table { width: 100%; border-collapse: collapse; min-width: 560px; }
  th {
    text-align: left;
    font-family: var(--mono);
    font-size: 9px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
    font-weight: 500;
    padding: 14px 24px;
    border-bottom: 1px solid var(--border);
  }
  .table-wrap :global(td) { padding: 18px 24px; border-bottom: 1px solid var(--border); vertical-align: middle; }
  .table-wrap :global(.strong) { font-size: 12px; font-weight: 600; }
  .table-wrap :global(.muted) { font-size: 10.5px; color: var(--muted); }
  .table-wrap :global(.actions) { display: flex; gap: 8px; }
  .msg { padding: 0 24px 16px; font-size: 12px; color: var(--accent); }
  .newkey { margin: 0 24px 20px; padding: 14px; border-radius: 10px; border: 1px solid var(--accent-line); background: var(--accent-soft); }
  .newkey .strong { font-size: 12px; font-weight: 600; }
  .newkey-row { display: flex; align-items: center; gap: 10px; margin-top: 10px; }
  .newkey-row code { flex: 1; min-width: 0; overflow-wrap: anywhere; font-size: 12.5px; color: var(--accent); }
  .table-wrap :global(.off) { color: var(--muted); border-color: var(--border-2); background: none; }
  .table-wrap :global(.empty) { text-align: center; color: var(--muted); font-size: 12px; padding: 36px 24px; }
  .gap { margin-top: 32px; }
  @media (max-width: 640px) {
    .card-head { flex-direction: column; }
    .count { text-align: left; }
    .create { flex-direction: column; }
    .create input { flex: none; }
  }
  /* CLI key block */

  .key-card .card-head { align-items: center; }
  .keyline { margin: 0 24px; padding: 16px; border-radius: 10px; border: 1px solid var(--border-2); background: var(--bg); }
  .keyline code { font-size: 15px; font-weight: 700; letter-spacing: 0.04em; color: var(--accent); }
  .facts { display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px; padding: 20px 24px 24px; }
  .facts div { padding: 12px 14px; border-radius: 10px; border: 1px solid var(--border); background: var(--surface); }
  .facts dt { font-size: 11px; color: var(--muted); }
  .facts dd { margin-top: 4px; font-size: 15px; font-weight: 600; }
  .state { display: inline-flex; align-items: center; gap: 8px; padding: 6px 12px; border-radius: 999px; border: 1px solid var(--border-2); font-size: 12px; font-weight: 600; }
  .state i { width: 8px; height: 8px; border-radius: 50%; background: var(--muted); }
  .state[data-cli-state='active'] i { background: #4ade80; box-shadow: 0 0 10px #4ade80; }
  .state[data-cli-state='exhausted'] i, .state[data-cli-state='paused'] i { background: #fbbf24; }
  .state[data-cli-state='expired'] i { background: #f87171; }
  .install { display: flex; flex-direction: column; gap: 12px; margin-top: 20px; }
  .install .row { display: flex; align-items: center; gap: 10px; }
  .install code { color: var(--fg); font-weight: 600; }
  .install a { color: var(--accent); }
  .help { display: flex; align-items: center; gap: 16px; margin-top: 20px; transition: border-color 0.15s; }
  .help:hover { border-color: var(--accent-line); }
  .help .grow { flex: 1; display: flex; flex-direction: column; }
  .icon-btn.big { width: 44px; height: 44px; color: var(--accent); }
  @media (max-width: 760px) {
    .facts { grid-template-columns: 1fr 1fr; }
    .key-card .card-head { flex-direction: column; align-items: flex-start; }
    .help { flex-wrap: wrap; }
  }
  .cli-block { margin-top: 32px; }
  .block-title { margin-bottom: 12px; font-family: var(--mono); font-size: 10px; letter-spacing: 0.12em; text-transform: uppercase; color: var(--muted); }
</style>
