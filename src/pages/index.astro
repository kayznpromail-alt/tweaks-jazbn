---
import Shell from '../layouts/Shell.astro';
import Icon from '../components/Icon.astro';

const year = new Date().getFullYear();
const steps = ['Claim your number.', 'Copy it or save it as a file.', 'Use it whenever you sign in.'];
---
<Shell title="Sign in">
  <div class="auth">
    <header class="bar">
      <a href="/" class="brand">
        <span class="logo"><Icon name="terminal" size={14} /></span>
        <span>edgey<span class="accent">cli</span>.com</span>
      </a>
      <span class="motto">YOUR AI WORKSPACE</span>
    </header>

    <main class="split">
      <section class="card hero">
        <p class="kicker"><i class="dot"></i><span>SIXTEEN DIGITS. <b>ONE WORKSPACE.</b></span></p>
        <div class="mid">
          <p class="site">edgeycli.com</p>
          <h1>Your number.<br /><span>Your space.</span></h1>
          <p class="digits" data-digits aria-hidden="true">
            {[0, 1, 2, 3].map(() => (
              <span class="grp">
                {[0, 1, 2, 3].map(() => (
                  <span class="d">
                    <span class="strip">{'0123456789'.split('').map((n) => <span>{n}</span>)}</span>
                  </span>
                ))}
              </span>
            ))}
          </p>
          <p class="note">No email. No password. Just your access number.</p>
        </div>
        <div class="hero-foot">
          <span>00 / UNCLAIMED</span>
          <span class="accent">KEEP IT YOURS.</span>
        </div>
      </section>

      <section class="panel">
        <div class="tabs" role="tablist" aria-label="Account">
          <button class="on" role="tab" aria-selected="true" data-tab="signin">Sign in</button>
          <button role="tab" aria-selected="false" data-tab="register">Register</button>
        </div>

        <form class="view" data-view="signin" novalidate>
          <p class="eyebrow">WELCOME BACK</p>
          <h2>Make yourself at home.</h2>
          <p class="lead">Enter the 16-digit number you saved when you registered.</p>
          <label for="access" class="label">Access number</label>
          <div class="field">
            <input
              id="access"
              name="access"
              type="password"
              inputmode="numeric"
              autocomplete="current-password"
              spellcheck="false"
              maxlength="19"
              placeholder="0000 0000 0000 0000"
              data-access
            />
            <button type="button" class="eye" aria-label="Show number" data-eye>
              <span data-icon="show"><Icon name="eye" /></span>
              <span data-icon="hide" hidden><Icon name="eyeOff" /></span>
            </button>
          </div>
          <button type="submit" class="btn primary big">Sign in <Icon name="arrowRight" size={14} /></button>
          <p class="msg" data-msg role="status" hidden></p>
          <p class="small">New here? <button type="button" class="link" data-go="register">Claim your number.</button></p>
        </form>

        <form class="view register" data-view="register" novalidate hidden>
          <p class="eyebrow">A FRESH START</p>
          <h2>Claim your space.</h2>
          <p class="lead">One click creates your account and a unique 16-digit access number. No email or password needed.</p>
          <ol class="steps">
            {steps.map((s, i) => (
              <li><span class="n">{String(i + 1).padStart(2, '0')}</span>{s}</li>
            ))}
          </ol>
          <button type="submit" class="btn primary big">Register <Icon name="arrowRight" size={14} /></button>
          <p class="msg" data-msg role="status" hidden></p>
          <p class="small accent">Your account starts with no API credit. API access is assigned separately.</p>
        </form>
      </section>
    </main>

    <footer class="foot">
      <span>© {year} edgeycli.com</span>
      <span class="links">
        <a>Products</a> · <a>Support</a> · <a>Terms</a> · One number. Your workspace.
      </span>
    </footer>
  </div>
</Shell>

<script>
  // Tabs: Sign in / Register (#register opens the second one).
  const tabs = [...document.querySelectorAll<HTMLButtonElement>('[data-tab]')];
  const views = [...document.querySelectorAll<HTMLFormElement>('[data-view]')];
  const show = (id: string) => {
    tabs.forEach((t) => {
      const on = t.dataset.tab === id;
      t.classList.toggle('on', on);
      t.setAttribute('aria-selected', String(on));
    });
    views.forEach((v) => (v.hidden = v.dataset.view !== id));
    history.replaceState(null, '', id === 'register' ? '#register' : location.pathname);
  };
  tabs.forEach((t) => t.addEventListener('click', () => show(t.dataset.tab ?? 'signin')));
  document.querySelectorAll<HTMLElement>('[data-go]').forEach((b) => b.addEventListener('click', () => show(b.dataset.go ?? 'signin')));
  if (location.hash === '#register') show('register');

  // Access number: digits only, grouped by four.
  const input = document.querySelector<HTMLInputElement>('[data-access]');
  const digitCount = () => input?.value.replace(/\D/g, '').length ?? 0;
  input?.addEventListener('input', () => {
    const d = input.value.replace(/\D/g, '').slice(0, 16);
    input.value = d.replace(/(\d{4})(?=\d)/g, '$1 ');
  });

  const eye = document.querySelector<HTMLButtonElement>('[data-eye]');
  eye?.addEventListener('click', () => {
    if (!input) return;
    const reveal = input.type === 'password';
    input.type = reveal ? 'text' : 'password';
    eye.setAttribute('aria-label', reveal ? 'Hide number' : 'Show number');
    eye.querySelector<HTMLElement>('[data-icon="show"]')!.hidden = reveal;
    eye.querySelector<HTMLElement>('[data-icon="hide"]')!.hidden = !reveal;
  });

  // No accounts backend yet: any complete number opens the workspace (preview only).
  views.forEach((form) =>
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const msg = form.querySelector<HTMLElement>('[data-msg]');
      if (!msg) return;
      if (form.dataset.view === 'register') {
        msg.textContent = "Registration isn't open yet.";
        msg.hidden = false;
      } else if (digitCount() < 16) {
        msg.textContent = 'Enter all 16 digits of your access number.';
        msg.hidden = false;
      } else {
        msg.hidden = true;
        form.classList.add('granted');
        setTimeout(() => location.assign('/overview'), 350);
      }
    }),
  );

  // Rolling access-number digits on the left card.
  const digits = document.querySelector<HTMLElement>('[data-digits]');
  if (digits && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const strips = [...digits.querySelectorAll<HTMLElement>('.strip')];
    const roll = () =>
      strips.forEach((s, i) => {
        s.style.transitionDelay = `${i * 45}ms`;
        s.style.transform = `translateY(${-Math.floor(Math.random() * 10) * 1.25}em)`;
      });
    requestAnimationFrame(roll);
    setInterval(roll, 3600);
  }
</script>

<style>
  .auth {
    min-height: 100svh;
    max-width: 1220px;
    margin: 0 auto;
    padding: 0 16px;
    display: flex;
    flex-direction: column;
  }
  .bar { display: flex; justify-content: space-between; align-items: center; gap: 16px; height: 96px; }
  .brand { display: flex; align-items: center; gap: 10px; font-size: 17px; font-weight: 700; letter-spacing: -0.01em; }
  .logo {
    display: grid;
    place-items: center;
    width: 26px;
    height: 26px;
    border-radius: 7px;
    color: var(--accent);
    background: var(--accent-soft);
    border: 1px solid var(--accent-line);
  }
  .logo { view-transition-name: brand-logo; }
  .accent { color: var(--accent); }
  .motto { font-family: var(--mono); font-size: 9.5px; letter-spacing: 0.2em; color: var(--accent); opacity: 0.85; }

  .split {
    flex: 1;
    display: grid;
    grid-template-columns: minmax(0, 606px) minmax(0, 1fr);
    align-items: center;
    gap: 48px;
    padding: 16px 0 40px;
  }

  .hero {
    position: relative;
    display: flex;
    flex-direction: column;
    min-height: clamp(520px, calc(100svh - 220px), 720px);
    padding: 32px;
    overflow: hidden;
    border-radius: 18px;
    background:
      radial-gradient(120% 80% at 0% 0%, rgb(34 211 238 / 0.08), transparent 55%),
      linear-gradient(180deg, var(--surface-2), var(--surface));
    box-shadow: 0 30px 80px -40px rgb(0 0 0 / 0.8);
  }
  .kicker {
    display: flex;
    align-items: center;
    gap: 10px;
    font-family: var(--mono);
    font-size: 9px;
    letter-spacing: 0.2em;
    color: var(--muted);
  }
  .kicker b { font-weight: inherit; color: var(--accent); }
  .dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 8px var(--accent);
  }
  .mid { margin: auto 0; }
  .site { font-family: var(--mono); font-size: 10px; letter-spacing: 0.14em; color: var(--muted); }
  h1 {
    margin-top: 26px;
    font-size: clamp(40px, 6vw, 66px);
    font-weight: 700;
    line-height: 1.04;
    letter-spacing: -0.045em;
  }
  h1 span { color: #7f8e97; }
  .digits {
    display: flex;
    flex-wrap: wrap;
    gap: 0 0.7em;
    margin-top: 34px;
    font-family: var(--mono);
    font-size: 22px;
    letter-spacing: 0.06em;
    color: #9fb0b9;
  }
  .grp { display: flex; }
  .d { display: inline-block; height: 1.25em; overflow: hidden; }
  .strip { display: flex; flex-direction: column; transition: transform 1.1s cubic-bezier(0.2, 0.8, 0.2, 1); }
  .strip span { height: 1.25em; line-height: 1.25em; }
  .note { margin-top: 14px; font-size: 12px; color: var(--muted); }
  .hero-foot {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    font-family: var(--mono);
    font-size: 8.5px;
    letter-spacing: 0.2em;
    color: #3d4c55;
  }
  .hero-foot .accent { opacity: 0.8; }

  .panel { justify-self: center; width: 100%; max-width: 332px; }
  .tabs { display: flex; gap: 6px; padding-bottom: 18px; border-bottom: 1px solid var(--border); }
  .tabs button {
    padding: 9px 14px;
    border-radius: 8px;
    border: 1px solid transparent;
    font-size: 12px;
    color: var(--muted);
    transition: color 0.15s, background 0.15s, border-color 0.15s;
  }
  .tabs button:hover { color: var(--fg); }
  .tabs button.on { color: var(--fg); font-weight: 600; background: var(--surface-2); border-color: var(--accent-line); }
  .view { padding-top: 44px; }
  .eyebrow { font-family: var(--mono); font-size: 9.5px; letter-spacing: 0.2em; color: var(--muted); }
  h2 { margin-top: 12px; font-size: 26px; font-weight: 700; letter-spacing: -0.03em; }
  .lead { margin-top: 14px; font-size: 12.5px; line-height: 1.65; color: var(--muted); }
  .label { display: block; margin-top: 32px; font-size: 12px; font-weight: 600; }
  .field {
    display: flex;
    align-items: center;
    height: 48px;
    margin-top: 10px;
    padding: 0 8px 0 14px;
    border-radius: 10px;
    border: 1px solid var(--border-2);
    background: var(--surface);
    transition: border-color 0.15s, box-shadow 0.15s;
  }
  .field:focus-within { border-color: var(--accent-line); box-shadow: 0 0 0 3px var(--accent-soft); }
  .field input {
    flex: 1;
    min-width: 0;
    background: none;
    border: 0;
    outline: none;
    font-family: var(--mono);
    font-size: 13px;
    letter-spacing: 0.12em;
  }
  .field input::placeholder { color: #3f4d56; }
  .eye {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border-radius: 7px;
    color: var(--muted);
    transition: color 0.15s, background 0.15s;
  }
  .eye:hover { color: var(--fg); background: var(--surface-2); }
  .eye span { display: grid; }
  .big { width: 100%; height: 46px; margin-top: 18px; font-size: 12.5px; }
  .register .big { margin-top: 56px; }
  .msg { margin-top: 12px; font-size: 11.5px; color: var(--accent); }
  .granted .big { filter: brightness(1.15); box-shadow: 0 0 0 4px var(--accent-soft), 0 0 24px rgb(34 211 238 / 0.35); }
  .small { margin-top: 20px; font-size: 11px; line-height: 1.6; color: var(--muted); }
  .small.accent { color: var(--accent); opacity: 0.85; }
  .link { font-weight: 600; color: var(--fg); transition: color 0.15s; }
  .link:hover { color: var(--accent); }
  .steps {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 14px;
    margin-top: 28px;
    padding-top: 22px;
    border-top: 1px solid var(--border);
  }
  .steps li { display: flex; gap: 14px; font-size: 12px; }
  .steps .n { font-family: var(--mono); font-size: 10.5px; color: var(--muted); }

  .foot {
    display: flex;
    justify-content: space-between;
    gap: 8px 16px;
    padding: 20px 0 28px;
    font-family: var(--mono);
    font-size: 9.5px;
    letter-spacing: 0.08em;
    color: #3d4c55;
  }
  .links { color: var(--accent); opacity: 0.7; }

  @media (max-width: 900px) {
    .split { grid-template-columns: minmax(0, 1fr); }
    .panel { order: -1; justify-self: stretch; max-width: none; }
    .hero { min-height: 440px; }
  }
  @media (max-width: 560px) {
    .bar { height: 72px; }
    .hero { min-height: 400px; padding: 24px; }
    .digits { font-size: 17px; }
    .foot { flex-direction: column; align-items: center; text-align: center; }
  }
</style>
