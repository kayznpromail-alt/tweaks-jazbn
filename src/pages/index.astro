---
import Shell from '../layouts/Shell.astro';
import Icon from '../components/Icon.astro';
import { Starfield } from '../components/ui/starfield';
import { FAQ } from '../components/ui/faq-tabs';
import { SignIn1 } from '../components/ui/modern-stunning-sign-in';
import { API_ROOT, DISCORD_URL, providers } from '../data/site';

const year = new Date().getFullYear();
const modelCount = providers.reduce((sum, p) => sum + p.models.length, 0);
const providerCount = providers.length;

const steps = [
  { num: '01', title: 'Account', desc: 'Create an account or sign in with your access number.', btn: 'Create account', action: 'register' },
  { num: '02', title: 'Access', desc: 'Check model access and rates, top up your wallet.', btn: 'Explore workspace', href: '/overview' },
  { num: '03', title: 'Workflow', desc: 'Create an API key, follow setup instructions for your tools.', btn: 'Open setup', href: '/setup' },
];
---
<Shell title="Your AI Workspace">
  <div class="landing">

    <!-- Starfield background -->
    <div class="ln-starfield">
      <Starfield client:load starCount={15000} starColor={{ r: 34, g: 211, b: 238 }} maxOpacity={200} rotationSpeed={0.0003} waveFrequency={15} />
    </div>

    <!-- Nav -->
    <header class="ln-nav" id="lnNav">
      <div class="ln-container">
        <a href="/" class="ln-brand">
          <span class="ln-logo"><Icon name="terminal" size={14} /></span>
          <span class="ln-brand-name">edgey<span class="acc">.shop</span></span>
        </a>
        <nav class="ln-links">
          <a href="#features">Features</a>
          <a href="#how">How it works</a>
          <a href="#faq">FAQ</a>
        </nav>
        <div class="ln-nav-right">
          <button class="ln-btn ln-btn--ghost" data-open-signin>Sign in</button>
        </div>
      </div>
    </header>

    <!-- Hero -->
    <section class="ln-hero">
      <div class="ln-container">
        <div class="ln-hero-badge">
          <span class="ln-dot"></span>
          <span>YOUR AI WORKSPACE</span>
        </div>
        <h1 class="ln-hero-title">
          More models.<br />
          <span class="ln-hero-accent">One workspace.</span>
        </h1>
        <p class="ln-hero-sub">
          Connect to AI models through one API.<br />
          Manage keys, usage limits and token costs in one place.
        </p>

        <div class="ln-provider-strip">
          <span class="ln-provider"><span class="ln-prov-icon">
            <img src="/icons/openai.svg" width="18" height="18" alt="OpenAI" />
          </span>OpenAI</span>
          <span class="ln-provider"><span class="ln-prov-icon">
            <img src="/icons/claude.svg" width="18" height="18" alt="Claude" />
          </span>Claude</span>
          <span class="ln-provider ln-prov--hl"><span class="ln-prov-icon ln-prov-icon--edgey">
            <Icon name="terminal" size={16} />
          </span>edgey</span>
          <span class="ln-provider"><span class="ln-prov-icon">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor"><path d="M3 3l7.5 9L3 21h2l6.5-7.8L18 21h3l-8-9.5L20.5 3h-2L12 10.3 6 3H3z"/></svg>
          </span>Grok</span>
        </div>

        <div class="ln-hero-actions">
          <button class="ln-btn ln-btn--primary ln-btn--lg" data-open-signin>
            Start building <Icon name="arrowRight" size={14} />
          </button>
          <a href="/overview" class="ln-btn ln-btn--ghost ln-btn--lg">
            Open workspace <Icon name="arrowUpRight" size={14} />
          </a>
        </div>

        <p class="ln-hero-already">
          Already with us? <button class="ln-link" data-open-signin>Use your existing account.</button>
        </p>
      </div>
    </section>

    <!-- Model Activity -->
    <section class="ln-section" id="pricing-section">
      <div class="ln-container">
        <h2 class="ln-section-title">
          Find your rhythm.<br />
          <span class="ln-accent">Build with your favorites.</span>
        </h2>

        <div class="ln-activity-card">
          <div class="ln-activity-head">
            <div class="ln-activity-info">
              <Icon name="activity" size={18} />
              <div>
                <p class="ln-activity-title">Model activity</p>
                <p class="ln-activity-meta">{providerCount} model families · {modelCount} models</p>
              </div>
            </div>
            <a href="/overview" class="ln-btn ln-btn--sm">Open workspace <Icon name="arrowUpRight" size={12} /></a>
          </div>

          <div class="ln-activity-rows">
            <div class="ln-activity-row">
              <span class="ln-activity-dot ln-activity-dot--green"></span>
              <span class="ln-activity-name">OpenAI</span>
              <span class="ln-activity-count">80 requests</span>
              <span class="ln-activity-pct">8%</span>
            </div>
            <div class="ln-activity-row">
              <span class="ln-activity-dot ln-activity-dot--purple"></span>
              <span class="ln-activity-name">Claude</span>
              <span class="ln-activity-count">50 requests</span>
              <span class="ln-activity-pct">5%</span>
            </div>
            <div class="ln-activity-row ln-activity-row--hl">
              <span class="ln-activity-dot ln-activity-dot--cyan"></span>
              <span class="ln-activity-name">edgey</span>
              <span class="ln-activity-count">870 requests</span>
              <span class="ln-activity-pct">87%</span>
            </div>
          </div>

          <div class="ln-share-bar">
            <div class="ln-share-header">
              <span>Request share</span>
              <span class="ln-share-total">1,000 total</span>
            </div>
            <div class="ln-bar-track">
              <div class="ln-bar-seg ln-bar-seg--green" style="width:8%"></div>
              <div class="ln-bar-seg ln-bar-seg--purple" style="width:5%"></div>
              <div class="ln-bar-seg ln-bar-seg--cyan" style="width:87%"></div>
            </div>
            <div class="ln-share-legend">
              <span><i class="ln-leg-dot ln-leg-dot--green"></i> OpenAI 8%</span>
              <span><i class="ln-leg-dot ln-leg-dot--purple"></i> Claude 5%</span>
              <span><i class="ln-leg-dot ln-leg-dot--cyan"></i> edgey 87%</span>
            </div>
          </div>
        </div>

        <p class="ln-note">Animated preview with example usage. Your actual models and activity appear in the workspace.</p>
      </div>
    </section>

    <!-- Features -->
    <section class="ln-section" id="features">
      <div class="ln-container">
        <div class="ln-divider"></div>
        <h2 class="ln-section-title">
          Everything in reach.<br />
          <span class="ln-accent">Nothing in your way.</span>
        </h2>

        <div class="ln-showcase-grid">
          <!-- Models -->
          <div class="ln-showcase">
            <div class="ln-showcase-label"><Icon name="grid" size={14} /> Models</div>
            <div class="ln-showcase-preview">
              <div class="ln-model-logos">
                <span class="ln-model-logo"><img src="/icons/openai.svg" width="24" height="24" alt="OpenAI" /></span>
                <span class="ln-model-logo"><img src="/icons/claude.svg" width="22" height="22" alt="Claude" /></span>
                <span class="ln-model-logo ln-model-logo--hl"><Icon name="terminal" size={20} /></span>
                <span class="ln-model-logo"><svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d="M3 3l7.5 9L3 21h2l6.5-7.8L18 21h3l-8-9.5L20.5 3h-2L12 10.3 6 3H3z"/></svg></span>
              </div>
              <p class="ln-showcase-desc">A catalog of {modelCount} models from {providerCount} providers. Choose the right fit for your project.</p>
            </div>
          </div>

          <!-- Keys -->
          <div class="ln-showcase">
            <div class="ln-showcase-label"><Icon name="key" size={14} /> Keys</div>
            <div class="ln-showcase-preview">
              <div class="ln-key-rows">
                <div class="ln-key-row">
                  <span class="ln-key-dot ln-key-dot--on"></span>
                  <span class="ln-key-name">Production</span>
                  <span class="ln-key-mask">sk_edgey_…</span>
                  <span class="ln-key-status ln-key-status--active">Active</span>
                </div>
                <div class="ln-key-row">
                  <span class="ln-key-dot ln-key-dot--on"></span>
                  <span class="ln-key-name">Side project</span>
                  <span class="ln-key-mask">sk_edgey_…</span>
                  <span class="ln-key-status ln-key-status--active">Active</span>
                </div>
                <div class="ln-key-row">
                  <span class="ln-key-dot"></span>
                  <span class="ln-key-name">Local development</span>
                  <span class="ln-key-mask">sk_edgey_…</span>
                  <span class="ln-key-status ln-key-status--paused">Paused</span>
                </div>
              </div>
              <p class="ln-showcase-desc">Keys can have separate model access and limits.</p>
            </div>
          </div>

          <!-- Usage -->
          <div class="ln-showcase">
            <div class="ln-showcase-label"><Icon name="activity" size={14} /> Usage</div>
            <div class="ln-showcase-preview">
              <div class="ln-usage-chart">
                <div class="ln-usage-bars">
                  <div class="ln-usage-bar" style="--h:60%"><span class="ln-usage-day">Mon</span></div>
                  <div class="ln-usage-bar" style="--h:85%"><span class="ln-usage-day">Tue</span></div>
                  <div class="ln-usage-bar" style="--h:45%"><span class="ln-usage-day">Wed</span></div>
                  <div class="ln-usage-bar" style="--h:90%"><span class="ln-usage-day">Thu</span></div>
                  <div class="ln-usage-bar" style="--h:70%"><span class="ln-usage-day">Fri</span></div>
                  <div class="ln-usage-bar" style="--h:30%"><span class="ln-usage-day">Sat</span></div>
                  <div class="ln-usage-bar" style="--h:50%"><span class="ln-usage-day">Sun</span></div>
                </div>
              </div>
              <p class="ln-showcase-desc">Follow your requests, token usage and costs from your workspace.</p>
            </div>
          </div>

          <!-- Setup -->
          <div class="ln-showcase">
            <div class="ln-showcase-label"><Icon name="terminal" size={14} /> Setup</div>
            <div class="ln-showcase-preview">
              <div class="ln-setup-code">
                <code><span class="c-kw">from</span> openai <span class="c-kw">import</span> OpenAI</code>
                <code>client = OpenAI(</code>
                <code>  <span class="c-key">base_url</span>=<span class="c-str">"https://api.edgey.shop/v1"</span></code>
                <code>)</code>
              </div>
              <p class="ln-showcase-desc">Drop-in OpenAI-compatible endpoint. Same SDK, same format.</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Keep building -->
    <section class="ln-section">
      <div class="ln-container">
        <div class="ln-divider"></div>
        <h2 class="ln-section-title ln-section-title--sm">Keep building.</h2>
        <p class="ln-section-sub">When one provider fails, your workflow doesn't have to stop.</p>

        <div class="ln-compare">
          <div class="ln-compare-panel ln-compare-panel--fail">
            <div class="ln-compare-head">
              <span class="ln-compare-dot ln-compare-dot--red"></span>
              <span>Other API</span>
            </div>
            <div class="ln-compare-body">
              <p class="ln-compare-error">Can't respond.</p>
              <p class="ln-compare-hint">The model is currently unavailable. Please try again later.</p>
            </div>
          </div>
          <div class="ln-compare-panel ln-compare-panel--ok">
            <div class="ln-compare-head">
              <span class="ln-compare-dot ln-compare-dot--green"></span>
              <span>edgey</span>
            </div>
            <div class="ln-compare-body">
              <code class="ln-compare-code"><span class="c-kw">#include</span> <span class="c-str">&lt;iostream&gt;</span>
<span class="c-kw">int</span> main() {"{"}
  std::cout &lt;&lt; <span class="c-str">"Hello, world!"</span>;
  <span class="c-kw">return</span> <span class="c-num">0</span>;
{"}"}</code>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Code example -->
    <section class="ln-section" id="how">
      <div class="ln-container">
        <div class="ln-divider"></div>
        <p class="ln-eyebrow">DROP-IN COMPATIBLE.</p>
        <h2 class="ln-section-title ln-section-title--sm">
          One line changed.<br />
          <span class="ln-accent">Every model unlocked.</span>
        </h2>
        <p class="ln-section-sub">Same OpenAI SDK. Same format. Just point the base URL to edgey and use any model in the catalog.</p>

        <div class="ln-code-card">
          <div class="ln-code-head">
            <div class="ln-code-dots">
              <span></span><span></span><span></span>
            </div>
            <span class="ln-code-lang">python</span>
          </div>
          <pre class="ln-code-body"><code><span class="c-kw">from</span> openai <span class="c-kw">import</span> OpenAI

client = OpenAI(
    <span class="c-key">base_url</span>=<span class="c-str">"https://api.edgey.shop/v1"</span>,
    <span class="c-key">api_key</span>=<span class="c-str">"sk_edgey_..."</span>,
)

response = client.chat.completions.create(
    <span class="c-key">model</span>=<span class="c-str">"claude-sonnet-5"</span>,
    <span class="c-key">messages</span>=[{"{"}
        <span class="c-str">"role"</span>: <span class="c-str">"user"</span>,
        <span class="c-str">"content"</span>: <span class="c-str">"Let's build."</span>
    {"}"}],
)
<span class="c-kw">print</span>(response.choices[<span class="c-num">0</span>].message.content)</code></pre>
        </div>
      </div>
    </section>

    <!-- Getting started -->
    <section class="ln-section">
      <div class="ln-container">
        <div class="ln-divider"></div>
        <h2 class="ln-section-title ln-section-title--sm">
          A simple way to<br />
          <span class="ln-accent">get started.</span>
        </h2>

        <div class="ln-steps">
          {steps.map((s) => (
            <div class="ln-step">
              <span class="ln-step-num">{s.num}</span>
              <h3>{s.title}</h3>
              <p>{s.desc}</p>
              {s.action === 'register' ? (
                <button class="ln-btn ln-btn--sm" data-open-signin>{s.btn} <Icon name="arrowRight" size={12} /></button>
              ) : (
                <a href={s.href} class="ln-btn ln-btn--sm">{s.btn} <Icon name="arrowRight" size={12} /></a>
              )}
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="ln-section" id="faq">
      <div class="ln-container ln-container--narrow">
        <div class="ln-divider"></div>
        <FAQ
          client:load
          title="Good questions. Clear answers."
          subtitle="FREQUENTLY ASKED"
          categories={{
            "pricing": "Pricing",
            "setup": "Setup & API",
            "models": "Models",
            "security": "Security"
          }}
          faqData={{
            "pricing": [
              { question: "How does pricing work?", answer: "You buy token packs (starting at €9.99). Each model has a rate multiplier — a ×2 model costs twice as many tokens per request as a ×1 model. Your balance is shared across all your API keys." },
              { question: "What payment methods are accepted?", answer: "Crypto (BTC, ETH, LTC, USDT, SOL) via NOWPayments with instant delivery. PayPal and card available via Discord." },
              { question: "Can I track my spending?", answer: "Yes. Your workspace shows token usage per key, per model and per request. You always know where your balance goes." }
            ],
            "setup": [
              { question: "How do I get started?", answer: "Join the Discord, purchase a plan, and receive your 16-digit edgey ID and CLI key. Sign in here, grab your API key, and start building." },
              { question: "Is it OpenAI-compatible?", answer: "Yes. Point any OpenAI SDK or tool at https://api.edgey.shop/v1 with your sk_edgey_ key. Same format, same streaming, same function calling." },
              { question: "Can I have multiple API keys?", answer: "Yes. Create as many keys as you need — one per project, one per environment. Each key shares your account balance but can be revoked individually." }
            ],
            "models": [
              { question: "Which models are available?", answer: "GPT (including GPT-6), Claude (Opus, Sonnet, Haiku, Fable), Gemini, Grok, Deepseek, Qwen, and more. Check the model list for the full catalog." },
              { question: "What are premium models?", answer: "Some models like edgeybeast are exclusive or have special pricing. They require a separate subscription and come with their own token quota." },
              { question: "Do all models support streaming?", answer: "Yes. Every model supports streaming responses out of the box, just like the official OpenAI API." }
            ],
            "security": [
              { question: "Is my upstream provider key exposed?", answer: "No. Your requests are relayed through edgey's servers. The upstream key never leaves the infrastructure. Clients only see their own sk_edgey_ key." },
              { question: "How is my data handled?", answer: "Requests are proxied in real-time — nothing is logged or stored beyond usage metadata (model, tokens, timestamp). Your prompts and completions pass through and are never retained." }
            ]
          }}
          className="!bg-transparent !px-0"
        />
        <p class="ln-faq-more">Something else on your mind? <a href={DISCORD_URL} target="_blank" rel="noopener">Talk to support <Icon name="arrowUpRight" size={12} /></a></p>
      </div>
    </section>

    <!-- CTA -->
    <section class="ln-section">
      <div class="ln-container">
        <div class="ln-divider"></div>
        <p class="ln-eyebrow">LESS FRICTION. MORE BUILDING.</p>
        <h2 class="ln-cta-title">Make room for<br />your next idea.</h2>
        <div class="ln-cta-actions">
          <button class="ln-btn ln-btn--primary ln-btn--lg" data-open-signin>
            Start building <Icon name="arrowRight" size={14} />
          </button>
        </div>
      </div>
    </section>

    <!-- Footer -->
    <footer class="ln-footer">
      <div class="ln-container">
        <div class="ln-divider"></div>
        <div class="ln-footer-grid">
          <div class="ln-footer-brand">
            <a href="/" class="ln-brand">
              <span class="ln-logo"><Icon name="terminal" size={14} /></span>
              <span class="ln-brand-name">edgey<span class="acc">.shop</span></span>
            </a>
            <p>Your AI models, API keys<br />and usage in one place.</p>
            <p class="ln-footer-copy">&copy; {year} cli.edgey.shop</p>
          </div>

          <div class="ln-footer-col">
            <h4>Workspace</h4>
            <a href="/" data-open-signin>Sign in</a>
            <a href="/#register" data-open-signin-register>Create account</a>
            <a href="/models">Models</a>
          </div>

          <div class="ln-footer-col">
            <h4>Resources</h4>
            <a href="/setup">Setup</a>
            <a href="/support">Support</a>
            <a href="#faq">FAQ</a>
          </div>

          <div class="ln-footer-col">
            <h4>Information</h4>
            <a href="/terms">Terms &amp; payments</a>
            <a href="/products">Products</a>
          </div>
        </div>
      </div>
    </footer>

    <!-- Sign-in dialog -->
    <dialog class="ln-dialog" id="signinDialog">
      <div class="ln-dialog-backdrop" data-close-signin></div>
      <div class="ln-dialog-panel">
        <button class="ln-dialog-close" data-close-signin aria-label="Close"><Icon name="x" size={18} /></button>
        <SignIn1 client:load apiBase={API_ROOT} discordUrl={DISCORD_URL} openRegistration={true} />
      </div>
    </dialog>
  </div>
</Shell>

<script>
  const nav = document.getElementById('lnNav');
  if (nav) {
    const observer = new IntersectionObserver(([e]) => nav.classList.toggle('scrolled', !e.isIntersecting), { threshold: [1], rootMargin: '-1px 0px 0px 0px' });
    observer.observe(nav);
  }

  const dialog = document.getElementById('signinDialog') as HTMLDialogElement | null;
  document.querySelectorAll<HTMLElement>('[data-open-signin],[data-open-signin-register]').forEach(b =>
    b.addEventListener('click', (e) => { e.preventDefault(); dialog?.showModal(); })
  );
  document.querySelectorAll<HTMLElement>('[data-close-signin]').forEach(b =>
    b.addEventListener('click', () => dialog?.close())
  );
  if (location.hash === '#register') dialog?.showModal();

  document.querySelectorAll<HTMLAnchorElement>('a[href^="#"]').forEach(a => {
    a.addEventListener('click', (e) => {
      const target = document.querySelector(a.getAttribute('href')!);
      if (target) { e.preventDefault(); target.scrollIntoView({ behavior: 'smooth' }); }
    });
  });
</script>

<style>
  .landing { min-height: 100svh; position: relative; overflow-x: hidden; }

  .ln-starfield { position: fixed; inset: 0; z-index: 0; pointer-events: none; }
  .landing > *:not(.ln-starfield) { position: relative; z-index: 1; }

  .ln-container { max-width: 1140px; margin: 0 auto; padding: 0 24px; }
  .ln-container--narrow { max-width: 800px; }

  /* ─── Nav ─── */
  .ln-nav {
    position: sticky; top: 0; z-index: 50;
    height: 64px; display: flex; align-items: center;
    background: rgb(5 8 11 / 0.8);
    backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid transparent; transition: border-color 0.2s;
  }
  .ln-nav.scrolled { border-color: var(--border); }
  .ln-nav .ln-container { display: flex; align-items: center; justify-content: space-between; width: 100%; }
  .ln-brand { display: flex; align-items: center; gap: 10px; font-size: 16px; font-weight: 700; }
  .ln-logo {
    display: grid; place-items: center;
    width: 28px; height: 28px; border-radius: 8px;
    color: var(--accent); background: var(--accent-soft); border: 1px solid var(--accent-line);
  }
  .acc { color: var(--muted); font-weight: 400; }
  .ln-links { display: flex; gap: 28px; font-size: 13px; color: var(--muted); }
  .ln-links a:hover { color: var(--fg); }
  .ln-nav-right { display: flex; gap: 10px; }

  /* ─── Buttons ─── */
  .ln-btn {
    display: inline-flex; align-items: center; justify-content: center; gap: 8px;
    height: 38px; padding: 0 16px; border-radius: 8px;
    font-size: 13px; font-weight: 600; white-space: nowrap;
    border: 1px solid var(--border-2); background: var(--bg); color: var(--fg);
    transition: all 0.15s; cursor: pointer;
  }
  .ln-btn:hover { border-color: var(--accent-line); color: var(--accent); }
  .ln-btn--primary { background: var(--accent); border-color: var(--accent); color: #031217; }
  .ln-btn--primary:hover { filter: brightness(1.1); color: #031217; }
  .ln-btn--ghost { background: transparent; border-color: var(--border-2); }
  .ln-btn--lg { height: 46px; padding: 0 22px; font-size: 14px; }
  .ln-btn--sm { height: 34px; padding: 0 14px; font-size: 12px; }
  .ln-link { color: var(--fg); font-weight: 600; background: none; border: 0; cursor: pointer; font: inherit; transition: color 0.15s; }
  .ln-link:hover { color: var(--accent); }

  /* ─── Hero ─── */
  .ln-hero { padding: 100px 0 80px; text-align: center; }
  .ln-hero-badge {
    display: inline-flex; align-items: center; gap: 10px;
    padding: 8px 18px; border-radius: 999px;
    background: var(--surface-2); border: 1px solid var(--border);
    font-family: var(--mono); font-size: 10px; letter-spacing: 0.22em; color: var(--muted);
  }
  .ln-dot { width: 6px; height: 6px; border-radius: 50%; background: var(--accent); box-shadow: 0 0 10px var(--accent); }
  .ln-hero-title {
    margin-top: 32px;
    font-size: clamp(48px, 8vw, 82px);
    font-weight: 700; line-height: 1.04; letter-spacing: -0.045em;
  }
