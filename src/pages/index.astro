---
import Shell from '../layouts/Shell.astro';
import Icon from '../components/Icon.astro';
import { DISCORD_URL, providers } from '../data/site';

const year = new Date().getFullYear();
const modelCount = providers.reduce((sum, p) => sum + p.models.length, 0);
const providerCount = providers.length;

const features = [
  { icon: 'grid' as const, title: 'Your models. One place.', desc: 'Explore the model catalog and choose the right fit for your next project.', badges: ['GPT', 'Claude', 'Gemini', 'Grok'] },
  { icon: 'key' as const, title: 'Keys that work your way.', desc: 'Keep projects separate with API keys, model access and individual limits.', lines: ['Production', 'Side project', 'Local dev'] },
  { icon: 'activity' as const, title: 'See where your usage goes.', desc: 'Follow your requests, token usage and costs from your workspace.' },
  { icon: 'terminal' as const, title: 'Made for your workflow.', desc: 'Find connection details and setup instructions for your clients and CLI tools.' },
  { icon: 'code' as const, title: 'Keep building.', desc: 'From your idea to the first lines of code. Drop-in OpenAI-compatible endpoint.' },
  { icon: 'search' as const, title: 'Follow every step.', desc: 'A small walkthrough: spot an issue, change a line, and run it again.' },
];
---
<Shell title="Your AI Workspace">
  <div class="landing">

    <!-- Nav -->
    <header class="ln-nav" id="lnNav">
      <div class="ln-container">
        <a href="/" class="ln-brand">
          <span class="ln-logo"><Icon name="terminal" size={14} /></span>
          <span class="ln-brand-name">edgey<span class="acc">.shop</span></span>
        </a>
        <nav class="ln-links">
          <a href="#features">Features</a>
          <a href="#how">How it works</a>
          <a href="#faq">FAQ</a>
        </nav>
        <div class="ln-nav-right">
          <button class="ln-btn ln-btn--ghost" data-open-signin>Sign in</button>
        </div>
      </div>
    </header>

    <!-- Hero -->
    <section class="ln-hero">
      <div class="ln-container">
        <div class="ln-hero-badge">
          <span class="ln-dot"></span>
          <span>YOUR AI WORKSPACE</span>
        </div>
        <h1 class="ln-hero-title">
          More models.<br />
          <span class="ln-hero-fade">One workspace.</span>
        </h1>
        <p class="ln-hero-sub">
          Connect to AI models through one API.<br />
          Manage keys, usage limits and token costs in one place.
        </p>

        <div class="ln-provider-strip">
          <span class="ln-provider"><span class="ln-prov-icon ln-prov-icon--gpt">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor"><path d="M22.28 9.37a5.49 5.49 0 0 0-.47-4.5A5.55 5.55 0 0 0 15.83 1.5a5.49 5.49 0 0 0-4.15-1.84A5.55 5.55 0 0 0 6.5 2.57a5.49 5.49 0 0 0-3.67 2.67 5.55 5.55 0 0 0 .68 6.5 5.49 5.49 0 0 0 .47 4.5A5.55 5.55 0 0 0 9.97 19.6a5.49 5.49 0 0 0 4.15 1.84 5.55 5.55 0 0 0 5.18-2.91 5.49 5.49 0 0 0 3.67-2.67 5.55 5.55 0 0 0-.68-6.5zM14.12 20.07a4.13 4.13 0 0 1-2.65-.96l.13-.07 4.4-2.54a.72.72 0 0 0 .36-.62v-6.2l1.86 1.07a.07.07 0 0 1 .04.05v5.14a4.14 4.14 0 0 1-4.14 4.13zM4.16 16.47a4.13 4.13 0 0 1-.49-2.78l.13.08 4.4 2.54a.72.72 0 0 0 .72 0l5.37-3.1v2.14a.07.07 0 0 1-.03.06l-4.45 2.57a4.14 4.14 0 0 1-5.65-1.51zM3.07 7.84A4.13 4.13 0 0 1 5.23 6l-.01.15v5.08a.72.72 0 0 0 .36.62l5.37 3.1-1.86 1.07a.07.07 0 0 1-.06 0l-4.45-2.57A4.14 4.14 0 0 1 3.07 7.84zm15.08 3.51-5.37-3.1 1.86-1.07a.07.07 0 0 1 .06 0l4.45 2.57a4.14 4.14 0 0 1-.64 7.47V12a.72.72 0 0 0-.36-.62v-.03zm1.85-2.8-.13-.08-4.4-2.54a.72.72 0 0 0-.72 0L9.38 9.03V6.89a.07.07 0 0 1 .03-.06l4.45-2.56a4.14 4.14 0 0 1 6.14 4.28zM8.38 12.71 6.52 11.64a.07.07 0 0 1-.04-.05V6.45A4.14 4.14 0 0 1 13.27 3.9l-.13.07-4.4 2.54a.72.72 0 0 0-.36.62v6.2-.62zm1.01-2.18L12 8.95l2.61 1.51v3.01L12 15.05l-2.61-1.51V10.53z"/></svg>
          </span>OpenAI</span>
          <span class="ln-provider"><span class="ln-prov-icon ln-prov-icon--claude">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 15.5v-3l-3.5-2 1-1.73L12 13l3.5-2.23 1 1.73-3.5 2v3h-2z"/></svg>
          </span>Claude</span>
          <span class="ln-provider ln-prov--highlight"><span class="ln-prov-icon ln-prov-icon--edgey">
            <Icon name="terminal" size={16} />
          </span>edgey</span>
          <span class="ln-provider"><span class="ln-prov-icon ln-prov-icon--grok">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor"><path d="M3 3l7.5 9L3 21h2l6.5-7.8L18 21h3l-8-9.5L20.5 3h-2L12 10.3 6 3H3z"/></svg>
          </span>Grok</span>
        </div>

        <div class="ln-hero-actions">
          <button class="ln-btn ln-btn--primary ln-btn--lg" data-open-signin>
            Start building <Icon name="arrowRight" size={14} />
          </button>
          <a href="/overview" class="ln-btn ln-btn--ghost ln-btn--lg">
            Open workspace <Icon name="arrowUpRight" size={14} />
          </a>
        </div>

        <p class="ln-hero-already">
          Already with us? <button class="ln-link" data-open-signin>Use your existing account.</button>
        </p>
      </div>
    </section>

    <!-- Model Activity -->
    <section class="ln-section" id="models">
      <div class="ln-container">
        <h2 class="ln-section-title">
          Find your rhythm.<br />
          <span class="ln-fade">Build with your favorites.</span>
        </h2>
        <p class="ln-section-sub">A closer look at how your model usage comes together.</p>

        <div class="ln-activity-card">
          <div class="ln-activity-head">
            <div class="ln-activity-info">
              <Icon name="activity" size={18} />
              <div>
                <p class="ln-activity-title">Model activity</p>
                <p class="ln-activity-meta">{providerCount} model families · {modelCount} models</p>
              </div>
            </div>
            <a href="/overview" class="ln-btn ln-btn--sm">Open workspace <Icon name="arrowUpRight" size={12} /></a>
          </div>

          <div class="ln-prov-cards">
            <div class="ln-prov-card">
              <div class="ln-radar">
                <div class="ln-radar-ring"></div>
                <div class="ln-radar-ring ln-radar-ring--2"></div>
                <div class="ln-radar-icon">
                  <svg viewBox="0 0 24 24" width="28" height="28" fill="currentColor"><path d="M22.28 9.37a5.49 5.49 0 0 0-.47-4.5A5.55 5.55 0 0 0 15.83 1.5a5.49 5.49 0 0 0-4.15-1.84A5.55 5.55 0 0 0 6.5 2.57a5.49 5.49 0 0 0-3.67 2.67 5.55 5.55 0 0 0 .68 6.5 5.49 5.49 0 0 0 .47 4.5A5.55 5.55 0 0 0 9.97 19.6a5.49 5.49 0 0 0 4.15 1.84 5.55 5.55 0 0 0 5.18-2.91 5.49 5.49 0 0 0 3.67-2.67 5.55 5.55 0 0 0-.68-6.5zM14.12 20.07a4.13 4.13 0 0 1-2.65-.96l.13-.07 4.4-2.54a.72.72 0 0 0 .36-.62v-6.2l1.86 1.07a.07.07 0 0 1 .04.05v5.14a4.14 4.14 0 0 1-4.14 4.13zM4.16 16.47a4.13 4.13 0 0 1-.49-2.78l.13.08 4.4 2.54a.72.72 0 0 0 .72 0l5.37-3.1v2.14a.07.07 0 0 1-.03.06l-4.45 2.57a4.14 4.14 0 0 1-5.65-1.51zM3.07 7.84A4.13 4.13 0 0 1 5.23 6l-.01.15v5.08a.72.72 0 0 0 .36.62l5.37 3.1-1.86 1.07a.07.07 0 0 1-.06 0l-4.45-2.57A4.14 4.14 0 0 1 3.07 7.84zm15.08 3.51-5.37-3.1 1.86-1.07a.07.07 0 0 1 .06 0l4.45 2.57a4.14 4.14 0 0 1-.64 7.47V12a.72.72 0 0 0-.36-.62v-.03zm1.85-2.8-.13-.08-4.4-2.54a.72.72 0 0 0-.72 0L9.38 9.03V6.89a.07.07 0 0 1 .03-.06l4.45-2.56a4.14 4.14 0 0 1 6.14 4.28zM8.38 12.71 6.52 11.64a.07.07 0 0 1-.04-.05V6.45A4.14 4.14 0 0 1 13.27 3.9l-.13.07-4.4 2.54a.72.72 0 0 0-.36.62v6.2-.62zm1.01-2.18L12 8.95l2.61 1.51v3.01L12 15.05l-2.61-1.51V10.53z"/></svg>
                </div>
              </div>
              <p class="ln-prov-card-name">OpenAI</p>
              <p class="ln-prov-card-sub">GPT · General purpose</p>
              <span class="ln-prov-card-stat"><Icon name="activity" size={12} /> 6 models</span>
            </div>

            <div class="ln-prov-card">
              <div class="ln-radar">
                <div class="ln-radar-ring ln-radar-ring--purple"></div>
                <div class="ln-radar-ring ln-radar-ring--2 ln-radar-ring--purple"></div>
                <div class="ln-radar-icon ln-radar-icon--purple">
                  <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 3l1.5 5H19l-4 3.5 1.5 5.5-4.5-3-4.5 3 1.5-5.5L5 8h5.5z"/></svg>
                </div>
              </div>
              <p class="ln-prov-card-name">Anthropic</p>
              <p class="ln-prov-card-sub">Claude · Reasoning</p>
              <span class="ln-prov-card-stat"><Icon name="activity" size={12} /> 8 models</span>
            </div>

            <div class="ln-prov-card">
              <div class="ln-radar">
                <div class="ln-radar-ring ln-radar-ring--cyan"></div>
                <div class="ln-radar-ring ln-radar-ring--2 ln-radar-ring--cyan"></div>
                <div class="ln-radar-icon ln-radar-icon--cyan">
                  <Icon name="terminal" size={26} />
                </div>
              </div>
              <p class="ln-prov-card-name">edgey</p>
              <p class="ln-prov-card-sub">Premium · Beast mode</p>
              <span class="ln-prov-card-stat"><Icon name="shield" size={12} /> Exclusive</span>
            </div>
          </div>

          <div class="ln-share-bar">
            <div class="ln-share-header">
              <span>Request share</span>
              <span class="ln-share-total">{modelCount} models total</span>
            </div>
            <div class="ln-bar-track">
              <div class="ln-bar-seg ln-bar-seg--green" style="width:16%"></div>
              <div class="ln-bar-seg ln-bar-seg--purple" style="width:20%"></div>
              <div class="ln-bar-seg ln-bar-seg--cyan" style="width:64%"></div>
            </div>
            <div class="ln-share-legend">
              <span><i class="ln-leg-dot ln-leg-dot--green"></i> GPT 16%</span>
              <span><i class="ln-leg-dot ln-leg-dot--purple"></i> Claude 20%</span>
              <span><i class="ln-leg-dot ln-leg-dot--cyan"></i> All others 64%</span>
            </div>
          </div>
        </div>

        <p class="ln-section-note">Animated preview with example usage. Your actual models and activity appear in the workspace.</p>
      </div>
    </section>

    <!-- Features -->
    <section class="ln-section" id="features">
      <div class="ln-container">
        <div class="ln-divider"></div>
        <p class="ln-section-eyebrow">NOTHING IN YOUR WAY.</p>
        <h2 class="ln-section-title ln-section-title--sm">
          From your first API key to your next project.<br />
          <span class="ln-fade">A workspace that keeps the details together.</span>
        </h2>

        <div class="ln-feat-grid">
          {features.map((f) => (
            <article class="ln-feat">
              <div class="ln-feat-icon"><Icon name={f.icon} size={18} /></div>
              <h3>{f.title}</h3>
              <p>{f.desc}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- Code example -->
    <section class="ln-section" id="how">
      <div class="ln-container">
        <div class="ln-divider"></div>
        <p class="ln-section-eyebrow">DROP-IN COMPATIBLE.</p>
        <h2 class="ln-section-title ln-section-title--sm">
          One line changed.<br />
          <span class="ln-fade">Every model unlocked.</span>
        </h2>
        <p class="ln-section-sub">Same OpenAI SDK. Same format. Just point the base URL to edgey and use any model in the catalog.</p>

        <div class="ln-code-card">
          <div class="ln-code-head">
            <div class="ln-code-dots">
              <span></span><span></span><span></span>
            </div>
            <span class="ln-code-lang">python</span>
          </div>
          <pre class="ln-code-body"><code><span class="c-kw">from</span> openai <span class="c-kw">import</span> OpenAI

client = OpenAI(
    <span class="c-key">base_url</span>=<span class="c-str">"https://api.edgey.shop/v1"</span>,
    <span class="c-key">api_key</span>=<span class="c-str">"sk_edgey_..."</span>,
)

response = client.chat.completions.create(
    <span class="c-key">model</span>=<span class="c-str">"claude-sonnet-5"</span>,
    <span class="c-key">messages</span>=[{"{"}
        <span class="c-str">"role"</span>: <span class="c-str">"user"</span>,
        <span class="c-str">"content"</span>: <span class="c-str">"Let's build."</span>
    {"}"}],
)
<span class="c-kw">print</span>(response.choices[<span class="c-num">0</span>].message.content)</code></pre>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="ln-section" id="faq">
      <div class="ln-container ln-container--narrow">
        <div class="ln-divider"></div>
        <p class="ln-section-eyebrow">FREQUENTLY ASKED</p>
        <h2 class="ln-section-title ln-section-title--sm">
          Questions?<br />
          <span class="ln-fade">Covered.</span>
        </h2>

        <div class="ln-faq-list">
          <details class="ln-faq">
            <summary><span>How does pricing work?</span><Icon name="plus" size={14} /></summary>
            <div class="ln-faq-body"><p>You buy token packs (starting at €9.99). Each model has a rate multiplier — a ×2 model costs twice as many tokens per request as a ×1 model. Your balance is shared across all your API keys.</p></div>
          </details>
          <details class="ln-faq">
            <summary><span>Is it OpenAI-compatible?</span><Icon name="plus" size={14} /></summary>
            <div class="ln-faq-body"><p>Yes. Point any OpenAI SDK or tool at <code>https://api.edgey.shop/v1</code> with your <code>sk_edgey_</code> key. Same format, same streaming, same function calling.</p></div>
          </details>
          <details class="ln-faq">
            <summary><span>Which models are available?</span><Icon name="plus" size={14} /></summary>
            <div class="ln-faq-body"><p>GPT (including GPT-6), Claude (Opus, Sonnet, Haiku, Fable), Gemini, Grok, Deepseek, Qwen, and more. {modelCount} models across {providerCount} providers. Check <a href="/models">the model list</a> for the full catalog.</p></div>
          </details>
          <details class="ln-faq">
            <summary><span>What payment methods are accepted?</span><Icon name="plus" size={14} /></summary>
            <div class="ln-faq-body"><p>Crypto (BTC, ETH, LTC, USDT, SOL) via NOWPayments with instant delivery. PayPal and card available via Discord.</p></div>
          </details>
          <details class="ln-faq">
            <summary><span>How do I get started?</span><Icon name="plus" size={14} /></summary>
            <div class="ln-faq-body"><p>Join the Discord, purchase a plan, and receive your 16-digit edgey ID and CLI key. Sign in here, grab your API key, and start building.</p></div>
          </details>
          <details class="ln-faq">
            <summary><span>Is my upstream provider key exposed?</span><Icon name="plus" size={14} /></summary>
            <div class="ln-faq-body"><p>No. Your requests are relayed through edgey's servers. The upstream key never leaves the infrastructure. Clients only see their own <code>sk_edgey_</code> key.</p></div>
          </details>
        </div>

        <p class="ln-faq-more">Something else on your mind? <a href={DISCORD_URL} target="_blank" rel="noopener">Talk to support <Icon name="arrowUpRight" size={12} /></a></p>
      </div>
    </section>

    <!-- CTA -->
    <section class="ln-section">
      <div class="ln-container">
        <div class="ln-divider"></div>
        <p class="ln-section-eyebrow">LESS FRICTION. MORE BUILDING.</p>
        <h2 class="ln-cta-title">Make room for<br />your next idea.</h2>
        <div class="ln-cta-actions">
          <button class="ln-btn ln-btn--primary ln-btn--lg" data-open-signin>
            Start building <Icon name="arrowRight" size={14} />
          </button>
        </div>
      </div>
    </section>

    <!-- Footer -->
    <footer class="ln-footer">
      <div class="ln-container">
        <div class="ln-divider"></div>
        <div class="ln-footer-grid">
          <div class="ln-footer-brand">
            <a href="/" class="ln-brand">
              <span class="ln-logo"><Icon name="terminal" size={14} /></span>
              <span class="ln-brand-name">edgey<span class="acc">.shop</span></span>
            </a>
            <p>Your AI models, API keys<br />and usage in one place.</p>
            <p class="ln-footer-copy">© {year} cli.edgey.shop</p>
          </div>

          <div class="ln-footer-col">
            <h4>Workspace</h4>
            <a href="/" data-open-signin>Sign in</a>
            <a href="/#register" data-open-signin-register>Create account</a>
            <a href="/models">Models</a>
          </div>

          <div class="ln-footer-col">
            <h4>Resources</h4>
            <a href="/setup">Setup</a>
            <a href="/support">Support</a>
            <a href="#faq">FAQ</a>
          </div>

          <div class="ln-footer-col">
            <h4>Information</h4>
            <a href="/terms">Terms &amp; payments</a>
            <a href="/products">Products</a>
          </div>
        </div>
      </div>
    </footer>

    <!-- Sign-in dialog -->
    <dialog class="ln-dialog" id="signinDialog">
      <div class="ln-dialog-backdrop" data-close-signin></div>
      <div class="ln-dialog-panel">
        <button class="ln-dialog-close" data-close-signin aria-label="Close"><Icon name="x" size={18} /></button>

        <div class="ln-dialog-tabs" role="tablist">
          <button class="on" role="tab" aria-selected="true" data-tab="signin">Sign in</button>
          <button role="tab" aria-selected="false" data-tab="register">Get access</button>
        </div>

        <form class="ln-dialog-view" data-view="signin" novalidate>
          <p class="ln-d-eyebrow">WELCOME BACK</p>
          <h2>Make yourself at home.</h2>
          <p class="ln-d-lead">Enter the 16-digit edgey ID you received with your purchase.</p>
          <label for="access" class="ln-d-label">edgey ID</label>
          <div class="ln-d-field">
            <input
              id="access"
              name="access"
              type="password"
              inputmode="numeric"
              autocomplete="current-password"
              spellcheck="false"
              maxlength="19"
              placeholder="0000 0000 0000 0000"
              data-access
            />
            <button type="button" class="ln-d-eye" aria-label="Show number" data-eye>
              <span data-icon="show"><Icon name="eye" /></span>
              <span data-icon="hide" hidden><Icon name="eyeOff" /></span>
            </button>
          </div>
          <button type="submit" class="ln-btn ln-btn--primary ln-btn--full">Sign in <Icon name="arrowRight" size={14} /></button>
          <p class="ln-d-msg" data-msg role="status" hidden></p>
          <p class="ln-d-small">New here? <button type="button" class="ln-link" data-go="register">Get your access.</button></p>
        </form>

        <div class="ln-dialog-view" data-view="register" hidden>
          <p class="ln-d-eyebrow">NEW HERE</p>
          <h2>Get your access.</h2>
          <p class="ln-d-lead">Your edgey ID and CLI key are delivered with your purchase. No email or password needed.</p>
          <ol class="ln-d-steps">
            <li><span class="ln-d-n">01</span>Buy a plan on Discord.</li>
            <li><span class="ln-d-n">02</span>Receive your edgey ID and your CLI key.</li>
            <li><span class="ln-d-n">03</span>Sign in here and install the CLI.</li>
          </ol>
          <a href={DISCORD_URL} class="ln-btn ln-btn--primary ln-btn--full" target="_blank" rel="noopener">
            Get access on Discord <Icon name="arrowUpRight" size={14} />
          </a>
          <p class="ln-d-small acc">Keep your edgey ID and CLI key private. Staff will never ask for them.</p>
        </div>
      </div>
    </dialog>
  </div>
</Shell>

<script>
  import { API_ENABLED, ApiError, api, session } from '../lib/api';

  // Sticky nav shadow
  const nav = document.getElementById('lnNav');
  if (nav) {
    const observer = new IntersectionObserver(([e]) => nav.classList.toggle('scrolled', !e.isIntersecting), { threshold: [1], rootMargin: '-1px 0px 0px 0px' });
    observer.observe(nav);
  }

  // Dialog
  const dialog = document.getElementById('signinDialog') as HTMLDialogElement | null;
  const openBtns = document.querySelectorAll<HTMLElement>('[data-open-signin]');
  const openRegBtns = document.querySelectorAll<HTMLElement>('[data-open-signin-register]');
  const closeBtns = document.querySelectorAll<HTMLElement>('[data-close-signin]');

  const openDialog = (tab = 'signin') => {
    if (!dialog) return;
    dialog.showModal();
    showTab(tab);
  };
  openBtns.forEach(b => b.addEventListener('click', (e) => { e.preventDefault(); openDialog('signin'); }));
  openRegBtns.forEach(b => b.addEventListener('click', (e) => { e.preventDefault(); openDialog('register'); }));
  closeBtns.forEach(b => b.addEventListener('click', () => dialog?.close()));

  if (location.hash === '#register') openDialog('register');

  // Tabs
  const tabs = [...document.querySelectorAll<HTMLButtonElement>('[data-tab]')];
  const views = [...document.querySelectorAll<HTMLElement>('[data-view]')];
  const showTab = (id: string) => {
    tabs.forEach(t => {
      const on = t.dataset.tab === id;
      t.classList.toggle('on', on);
      t.setAttribute('aria-selected', String(on));
    });
    views.forEach(v => (v.hidden = v.dataset.view !== id));
  };
  tabs.forEach(t => t.addEventListener('click', () => showTab(t.dataset.tab ?? 'signin')));
  document.querySelectorAll<HTMLElement>('[data-go]').forEach(b => b.addEventListener('click', () => showTab(b.dataset.go ?? 'signin')));

  // Access number input
  const input = document.querySelector<HTMLInputElement>('[data-access]');
  const digitCount = () => input?.value.replace(/\D/g, '').length ?? 0;
  input?.addEventListener('input', () => {
    const d = input.value.replace(/\D/g, '').slice(0, 16);
    input.value = d.replace(/(\d{4})(?=\d)/g, '$1 ');
  });

  const eye = document.querySelector<HTMLButtonElement>('[data-eye]');
  eye?.addEventListener('click', () => {
    if (!input) return;
    const reveal = input.type === 'password';
    input.type = reveal ? 'text' : 'password';
    eye.setAttribute('aria-label', reveal ? 'Hide number' : 'Show number');
    eye.querySelector<HTMLElement>('[data-icon="show"]')!.hidden = reveal;
    eye.querySelector<HTMLElement>('[data-icon="hide"]')!.hidden = !reveal;
  });

  const errorText = (err: unknown) => {
    const code = err instanceof ApiError ? err.code : 'error';
    if (code === 'unknown_number') return 'No account uses this edgey ID.';
    if (code === 'too_many_requests') return 'Too many attempts. Wait a minute and try again.';
    if (code === 'network') return "Can't reach cli.edgey.shop right now. Try again shortly.";
    return 'Something went wrong. Try again.';
  };
  const enter = (form: HTMLElement) => {
    form.classList.add('granted');
    setTimeout(() => location.assign('/overview'), 350);
  };

  views.forEach(form =>
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const msg = form.querySelector<HTMLElement>('[data-msg]');
      if (!msg) return;
      const say = (text: string) => { msg.textContent = text; msg.hidden = false; };
      msg.hidden = true;
      if (digitCount() < 16) return say('Enter all 16 digits of your edgey ID.');
      if (!API_ENABLED) return enter(form);
      try {
        const { token } = await api<{ token: string }>('/auth/login', { method: 'POST', body: { number: input!.value } });
        session.set(token);
        enter(form);
      } catch (err) {
        say(errorText(err));
      }
    }),
  );

  // Smooth scroll for anchor links
  document.querySelectorAll<HTMLAnchorElement>('a[href^="#"]').forEach(a => {
    a.addEventListener('click', (e) => {
      const target = document.querySelector(a.getAttribute('href')!);
      if (target) { e.preventDefault(); target.scrollIntoView({ behavior: 'smooth' }); }
    });
  });
</script>

