  }
  .ln-container { max-width: 1140px; margin: 0 auto; padding: 0 24px; }
  .ln-container--narrow { max-width: 800px; }
  .accent { color: var(--accent); }
  .dim { color: var(--muted); }
  .mono { font-family: var(--mono); }
  .text-xs { font-size: 11px; }

  /* ── Nav ── */
  .ln-nav {
    position: sticky; top: 0; z-index: 50;
