---
import Base from '../layouts/Base.astro';
---
<Base>
  <main>
    <h1>EDGEY <span>CLI</span></h1>
    <p class="tagline">En construction.</p>
    <pre><code><span class="prompt">$</span> edgey --help</code></pre>
  </main>
</Base>

<style>
  main {
    max-width: 720px;
    margin: 0 auto;
    padding: 20vh 16px 4rem;
    text-align: center;
  }
  h1 {
    font-family: var(--mono);
    font-size: clamp(2.5rem, 8vw, 4.5rem);
    letter-spacing: -0.02em;
  }
  h1 span { color: var(--accent); }
  .tagline { color: var(--muted); margin: 0.5rem 0 2rem; }
  pre {
    display: inline-block;
    text-align: left;
    font-family: var(--mono);
    background: #0f151c;
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 0.75rem 1.25rem;
  }
  .prompt { color: var(--accent); margin-right: 0.5ch; }
</style>
