    backdrop-filter: blur(14px) saturate(140%); -webkit-backdrop-filter: blur(14px) saturate(140%);
  }
  .ln-nav .ln-container { display: flex; align-items: center; gap: 44px; width: 100%; }
  .ln-nav-right { margin-left: auto; }
  .ln-brand { display: flex; align-items: center; gap: 10px; font-size: 16px; font-weight: 600; letter-spacing: -0.02em; }
  .ln-logo {
    display: grid; place-items: center;
    width: 28px; height: 28px; border-radius: 8px;
    color: var(--accent); background: var(--accent-soft); border: 1px solid var(--accent-line);
  }
  .ln-links { display: flex; gap: 30px; font-size: 13.5px; color: var(--muted); }
  .ln-links a { transition: color 0.15s; }
  .ln-links a:hover { color: var(--fg); }
  .ln-signin-btn {
    display: inline-flex; align-items: center; gap: 7px;
    height: 38px; padding: 0 18px; border-radius: 999px;
    font-size: 13.5px; font-weight: 500;
    background: var(--fg); color: #05080b;
    box-shadow: inset 0 -1px 0 rgb(0 0 0 / 0.12);
    cursor: pointer; transition: background-color 0.15s, box-shadow 0.2s, transform 0.15s;
  }
  .ln-signin-btn:hover { background: #fff; box-shadow: 0 0 0 4px rgb(255 255 255 / 0.08); }

  /* ── Buttons ── */
  .ln-btn {
    display: inline-flex; align-items: center; justify-content: center; gap: 8px;
    height: 46px; padding: 0 22px; border-radius: 999px;
    font-size: 14.5px; font-weight: 500; white-space: nowrap;
    border: 1px solid var(--border-2); background: var(--surface); color: var(--fg);
    cursor: pointer; transition: color 0.15s, border-color 0.15s, background-color 0.15s, box-shadow 0.25s, transform 0.15s;
  }
  .ln-btn:hover { border-color: var(--accent-line); color: var(--accent); }
  .ln-btn--primary {
    background: var(--accent); border-color: transparent; color: #031217; font-weight: 600;
    box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.35), 0 10px 30px -10px rgb(34 211 238 / 0.65);
  }
  .ln-btn--primary:hover {
    color: #031217; border-color: transparent; transform: translateY(-1px);
    box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.35), 0 0 0 4px rgb(34 211 238 / 0.14), 0 14px 36px -10px rgb(34 211 238 / 0.8);
  }
  .ln-btn--primary:active { transform: translateY(0); }
  .ln-arrow { display: inline-flex; transition: transform 0.2s; }
  .ln-btn:hover .ln-arrow { transform: translateX(3px); }
  .ln-btn--ghost { background: transparent; border-color: transparent; color: var(--fg); }
  .ln-btn--ghost:hover { background: rgb(255 255 255 / 0.04); border-color: transparent; color: var(--fg); }
  .ln-btn--sm { height: 36px; padding: 0 16px; font-size: 12.5px; }
  .ln-text-btn { color: var(--fg); font-weight: 500; background: none; border: 0; cursor: pointer; font: inherit; transition: color 0.15s; }
  .ln-text-btn:hover { color: var(--accent); }

  /* ── Hero ── */
  .ln-hero { position: relative; isolation: isolate; padding: 96px 0 88px; text-align: center; }
  .ln-hero::before {
    content: ''; position: absolute; inset: -68px 0 0; z-index: -1; pointer-events: none;
    background-image:
      linear-gradient(rgb(255 255 255 / 0.04) 1px, transparent 1px),
      linear-gradient(90deg, rgb(255 255 255 / 0.04) 1px, transparent 1px);
    background-size: 64px 64px; background-position: center top;
    -webkit-mask-image: radial-gradient(ellipse 60% 70% at 50% 25%, #000 20%, transparent 72%);
    mask-image: radial-gradient(ellipse 60% 70% at 50% 25%, #000 20%, transparent 72%);
  }
  .ln-hero::after {
    content: ''; position: absolute; z-index: -1; pointer-events: none;
    left: 50%; top: -120px; width: min(900px, 100%); height: 520px; translate: -50% 0;
    background: radial-gradient(closest-side, rgb(34 211 238 / 0.13), transparent);
    filter: blur(20px);
  }
  .ln-kicker {
    display: inline-flex; align-items: center; gap: 9px;
    padding: 6px 14px 6px 12px; border-radius: 999px;
    font-family: var(--mono); font-size: 10.5px; font-weight: 500; letter-spacing: 0.14em; color: var(--accent);
    background: rgb(34 211 238 / 0.05); border: 1px solid var(--accent-line);
  }
  .ln-dot { position: relative; width: 6px; height: 6px; border-radius: 50%; background: var(--accent); }
  .ln-dot::after {
    content: ''; position: absolute; inset: 0; border-radius: 50%; background: var(--accent);
    animation: ln-ping 2s cubic-bezier(0, 0, 0.2, 1) infinite;
  }
  @keyframes ln-ping { 75%, 100% { transform: scale(2.6); opacity: 0; } }
  .ln-title {
    margin-top: 30px;
    font-size: clamp(46px, 7.4vw, 88px);
    font-weight: 600; line-height: 1.02; letter-spacing: -0.035em;
  }
  .ln-title > span { display: block; }
  .ln-title .accent, .ln-heading .accent {
    color: transparent;
    background: linear-gradient(100deg, #6c939d 0%, #8fb7c1 35%, #c8f4fb 50%, #8fb7c1 65%, #6c939d 100%);
    background-size: 260% 100%; background-position: 100% 0;
    -webkit-background-clip: text; background-clip: text;
  }
  .ln-title .accent { animation: ln-rise 0.9s cubic-bezier(0.2, 0.7, 0.2, 1) calc(var(--i, 0) * 90ms + 80ms) both, ln-sheen 6s ease-in-out 1.6s infinite; }
  @keyframes ln-sheen { 0%, 100% { background-position: 100% 0; } 50% { background-position: 0% 0; } }
  .ln-sub { max-width: 560px; margin: 24px auto 0; font-size: 16.5px; line-height: 1.65; color: var(--muted); text-wrap: balance; }

  /* Providers with a gliding viewfinder */
  .ln-providers {
    position: relative; display: flex; justify-content: center; gap: 6px; flex-wrap: wrap;
    margin-top: 38px;
  }
  .ln-prov {
    display: inline-flex; align-items: center; gap: 9px;
    padding: 9px 14px; font-size: 14px; font-weight: 500; color: var(--muted);
    cursor: default; transition: color 0.3s;
  }
  .ln-prov > :first-child { transition: color 0.3s, filter 0.3s; }
  .ln-prov.is-active { color: var(--fg); }
  .ln-prov.is-active > :first-child { color: var(--brand); filter: drop-shadow(0 0 8px color-mix(in srgb, var(--brand) 45%, transparent)); }
  .ln-finder {
    position: absolute; left: 0; top: 0; pointer-events: none;
    width: var(--w, 0); height: var(--h, 0);
    transform: translate(var(--x, 0), var(--y, 0));
    border-radius: 6px;
    background: radial-gradient(120% 140% at 50% 50%, rgb(34 211 238 / 0.06), transparent 70%);
  }
  .ln-finder.ready { transition: transform 0.5s cubic-bezier(0.2, 0.8, 0.2, 1), width 0.5s cubic-bezier(0.2, 0.8, 0.2, 1), height 0.5s; }
  .ln-finder i { position: absolute; width: 9px; height: 9px; border: 0 solid var(--accent); }
  .ln-finder i:nth-child(1) { left: 0; top: 0; border-left-width: 1.5px; border-top-width: 1.5px; border-top-left-radius: 3px; }
  .ln-finder i:nth-child(2) { right: 0; top: 0; border-right-width: 1.5px; border-top-width: 1.5px; border-top-right-radius: 3px; }
  .ln-finder i:nth-child(3) { left: 0; bottom: 0; border-left-width: 1.5px; border-bottom-width: 1.5px; border-bottom-left-radius: 3px; }
  .ln-finder i:nth-child(4) { right: 0; bottom: 0; border-right-width: 1.5px; border-bottom-width: 1.5px; border-bottom-right-radius: 3px; }

  .ln-hero-btns { display: flex; justify-content: center; align-items: center; gap: 10px; margin-top: 34px; }
  .ln-already { margin-top: 22px; font-size: 13px; color: var(--muted); }

  /* Entrance: waits for the opening intro, with a fallback if its script never runs */
  .ln-rise { animation: ln-rise 0.9s cubic-bezier(0.2, 0.7, 0.2, 1) calc(var(--i, 0) * 90ms + 80ms) both; }
  :global(html.intro-on) .ln-rise, :global(html.intro-on) .ln-title .accent { animation: ln-rise-late 0.6s ease 10.4s both; }
  @keyframes ln-rise { from { opacity: 0; transform: translateY(16px); filter: blur(8px); } to { opacity: 1; transform: none; filter: none; } }
  @keyframes ln-rise-late { from { opacity: 0; } to { opacity: 1; } }
  @media (prefers-reduced-motion: reduce) {
    .ln-rise, .ln-title .accent, .ln-dot::after { animation: none; }
    .ln-finder.ready { transition: none; }
  }

  /* ── Sections ── */
  .ln-section { padding: 64px 0; }
  .ln-rule { height: 1px; margin-bottom: 52px; background: linear-gradient(90deg, transparent, var(--border), transparent); }
  .ln-eyebrow { text-align: center; font-family: var(--mono); font-size: 10.5px; font-weight: 500; letter-spacing: 0.2em; color: var(--muted); margin-bottom: 14px; }
  .ln-heading { text-align: center; font-size: clamp(34px, 5vw, 54px); font-weight: 600; line-height: 1.08; letter-spacing: -0.03em; }
  .ln-heading--sm { font-size: clamp(28px, 4vw, 42px); }
  .ln-lead { text-align: center; margin-top: 14px; font-size: 15px; line-height: 1.6; color: var(--muted); }
  .ln-note { text-align: center; margin-top: 20px; font-size: 12px; color: #3d4c55; font-style: italic; }

  /* ── Activity Card ── */
  .ln-activity {
    margin-top: 48px; padding: 24px;
    border-radius: 16px;
    background: linear-gradient(180deg, var(--surface-2), var(--surface));
    border: 1px solid var(--border);
  }
  .ln-activity-top { display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px; }
  .ln-activity-info { display: flex; align-items: center; gap: 12px; }
  .ln-activity-name { font-size: 14px; font-weight: 600; }
  .ln-activity-meta { font-size: 11px; color: var(--muted); }

  /* Radars */
  .ln-radars { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px; margin-top: 20px; }
  .ln-radar-card {
    display: flex; flex-direction: column; align-items: center;
    padding: 28px 16px 20px; border-radius: 12px;
    background: var(--surface); border: 1px solid var(--border);
    transition: border-color 0.2s, transform 0.2s;
    overflow: hidden;
  }
  .ln-radar-card:hover { border-color: var(--accent-line); transform: translateY(-2px); }
  .ln-radar { position: relative; width: 140px; height: 140px; }
  .ln-ring {
    position: absolute; inset: 0; border-radius: 50%;
    border: 1px solid rgb(74 222 128 / 0.22);
    animation: ring-pulse 3.6s ease-out infinite;
  }
  .ln-ring--2 { animation-delay: 1.2s; }
  .ln-ring--3 { animation-delay: 2.4s; }
  .ln-ring--purple { border-color: rgb(168 85 247 / 0.22); }
  .ln-ring--cyan { border-color: rgb(34 211 238 / 0.22); }
  @keyframes ring-pulse { 0% { transform: scale(0.4); opacity: 0.9; } 100% { transform: scale(1.25); opacity: 0; } }

  /* Circular visualizer: 36 bars radiating from the center */
  .ln-viz {
    position: absolute; inset: 0; pointer-events: none;
    color: rgb(74 222 128);
    filter: drop-shadow(0 0 4px color-mix(in srgb, currentColor 55%, transparent));
  }
  .ln-viz--purple { color: rgb(168 85 247); }
  .ln-viz--cyan { color: var(--accent); }
  .ln-tick { position: absolute; inset: 0; transform: rotate(var(--a)); }
  .ln-tick::before {
    content: ''; position: absolute;
    left: calc(50% - 1px); bottom: calc(50% + 31px);
    width: 2px; height: var(--h); border-radius: 2px;
    background: linear-gradient(to top, currentColor, color-mix(in srgb, currentColor 25%, transparent));
    transform-origin: bottom;
    animation: tick-pulse 1.4s ease-in-out calc(var(--dl) * -1) infinite alternate;
  }
  @keyframes tick-pulse {
    0% { transform: scaleY(0.3); opacity: 0.35; }
    100% { transform: scaleY(1.6); opacity: 1; }
  }
  .ln-radar-glow {
    position: absolute; inset: calc(50% - 25px); border-radius: 50%; z-index: -1;
    background: radial-gradient(circle at 50% 35%, var(--surface-2), var(--surface));
    border: 1px solid color-mix(in srgb, currentColor 35%, transparent);
    box-shadow: 0 0 22px 2px color-mix(in srgb, currentColor 20%, transparent), inset 0 0 14px color-mix(in srgb, currentColor 14%, transparent);
    animation: glow-breathe 3s ease-in-out infinite;
  }
  @keyframes glow-breathe {
    50% { box-shadow: 0 0 34px 6px color-mix(in srgb, currentColor 32%, transparent), inset 0 0 18px color-mix(in srgb, currentColor 22%, transparent); }
  }
  @media (prefers-reduced-motion: reduce) {
    .ln-ring, .ln-sweep, .ln-tick::before, .ln-radar-glow { animation: none; }
  }

  /* Brand logos: masked so they take the surrounding text color */
  .ln-mark {
    display: inline-block; flex: none;
    width: var(--s, 16px); height: var(--s, 16px);
    background-color: currentColor;
    -webkit-mask: var(--logo) center / contain no-repeat;
    mask: var(--logo) center / contain no-repeat;
  }
  .ln-mark--openai { --logo: url(/icons/openai.svg); }
  .ln-mark--claude { --logo: url(/icons/claude.svg); }
  .ln-sweep {
    position: absolute; inset: 0; border-radius: 50%;
    background: conic-gradient(from 0deg, transparent 0deg, rgb(74 222 128 / 0.1) 40deg, transparent 80deg);
    animation: sweep 4s linear infinite;
  }
  .ln-sweep--purple { background: conic-gradient(from 0deg, transparent 0deg, rgb(168 85 247 / 0.1) 40deg, transparent 80deg); }
  .ln-sweep--cyan { background: conic-gradient(from 0deg, transparent 0deg, rgb(34 211 238 / 0.1) 40deg, transparent 80deg); }
  @keyframes sweep { to { transform: rotate(360deg); } }
  .ln-radar-center { position: absolute; inset: 0; display: grid; place-items: center; color: rgb(74 222 128); isolation: isolate; }
  .ln-radar-center--purple { color: rgb(168 85 247); }
  .ln-radar-center--cyan { color: var(--accent); }
  .ln-radar-name { margin-top: 14px; font-size: 14px; font-weight: 600; }
  .ln-radar-sub { margin-top: 3px; font-size: 11px; color: var(--muted); }
  .ln-radar-badge {
    display: inline-flex; align-items: center; gap: 5px;
    margin-top: 12px; padding: 4px 10px; border-radius: 999px;
    font-size: 10px; font-weight: 500; color: var(--muted);
    background: var(--surface-2); border: 1px solid var(--border);
  }
  .ln-radar-badge--hl { color: var(--accent); border-color: var(--accent-line); background: var(--accent-soft); }

  /* Share bar */
  .ln-share { margin-top: 20px; padding-top: 18px; border-top: 1px solid var(--border); }
  .ln-share-row { display: flex; justify-content: space-between; font-size: 13px; margin-bottom: 8px; }
  .ln-bar { display: flex; height: 8px; border-radius: 999px; overflow: hidden; background: var(--surface); }
  .ln-seg { height: 100%; }
  .ln-seg--green { background: rgb(74 222 128); }
  .ln-seg--purple { background: rgb(168 85 247); }
  .ln-seg--cyan { background: var(--accent); }
  .ln-legend { display: flex; gap: 18px; margin-top: 8px; font-size: 11px; color: var(--muted); }
  .ln-ldot { display: inline-block; width: 7px; height: 7px; border-radius: 50%; margin-right: 5px; vertical-align: middle; }
  .ln-ldot--green { background: rgb(74 222 128); }
  .ln-ldot--purple { background: rgb(168 85 247); }
  .ln-ldot--cyan { background: var(--accent); }

  /* ── Feature Grid ── */
  .ln-feat-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px; margin-top: 44px; }
  .ln-feat {
    padding: 22px; border-radius: 14px;
    background: linear-gradient(180deg, var(--surface-2), var(--surface));
    border: 1px solid var(--border);
    transition: border-color 0.2s, transform 0.2s;
  }
  .ln-feat:hover { border-color: var(--accent-line); transform: translateY(-3px); }
  .ln-feat h3 { font-size: 14px; font-weight: 600; }
  .ln-feat > p { margin-top: 6px; font-size: 12px; line-height: 1.6; color: var(--muted); }
  .ln-feat-vis { margin-top: 18px; }

  /* Models preview */
  .ln-model-row { display: flex; gap: 10px; }
  .ln-model-icon {
    display: grid; place-items: center;
    width: 42px; height: 42px; border-radius: 10px;
    background: var(--surface); border: 1px solid var(--border); color: var(--muted);
    transition: border-color 0.2s;
  }
  .ln-model-icon--brand { color: var(--accent); border-color: var(--accent-line); background: var(--accent-soft); }
  .ln-feat:hover .ln-model-icon { border-color: var(--border-2); }

  /* Keys preview */
  .ln-keys { display: flex; flex-direction: column; gap: 4px; }
  .ln-key {
    display: flex; align-items: center; gap: 8px;
    padding: 7px 10px; border-radius: 6px; font-size: 11px;
    background: var(--surface); border: 1px solid var(--border);
  }
  .ln-key-dot { width: 5px; height: 5px; border-radius: 50%; background: var(--border-2); flex: none; }
  .ln-key-dot--on { background: rgb(74 222 128); box-shadow: 0 0 4px rgb(74 222 128 / 0.4); }
  .ln-tag { margin-left: auto; font-size: 9px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.04em; padding: 2px 6px; border-radius: 4px; color: var(--muted); background: var(--surface-2); }
  .ln-tag--green { color: rgb(74 222 128); background: rgb(74 222 128 / 0.1); }

  /* Chart preview */
  .ln-chart { display: flex; align-items: flex-end; gap: 6px; height: 70px; }
  .ln-chart-bar {
    flex: 1; height: var(--h); border-radius: 3px 3px 0 0;
    background: linear-gradient(180deg, var(--accent), rgb(34 211 238 / 0.25));
  }
  .ln-chart-labels { display: flex; justify-content: space-between; font-size: 9px; font-family: var(--mono); color: var(--muted); margin-top: 6px; }
  .ln-chart-note { margin-top: 8px; font-size: 10px; color: var(--muted); font-style: italic; }

  /* Setup preview */
  .ln-setup-tabs { display: flex; gap: 2px; margin-bottom: 8px; }
  .ln-setup-tab {
    padding: 4px 10px; border-radius: 6px; font-size: 10px; font-family: var(--mono);
    color: var(--muted); background: var(--surface); cursor: default;
  }
  .ln-setup-tab--active { color: var(--accent); background: var(--accent-soft); }
  .ln-setup-code {
    padding: 10px 12px; border-radius: 8px;
    background: var(--surface); border: 1px solid var(--border);
    font-family: var(--mono); font-size: 10px; line-height: 1.6;
  }
  .ln-setup-code code { display: block; white-space: pre; }

  /* Chat compare preview */
  .ln-chat-compare { display: grid; grid-template-columns: 1fr 1fr; gap: 6px; }
  .ln-chat {
    padding: 10px; border-radius: 8px;
    background: var(--surface); border: 1px solid var(--border);
