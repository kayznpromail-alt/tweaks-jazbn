<script>
  const nav = document.getElementById('lnNav');
  if (nav) {
    const onScroll = () => nav.classList.toggle('scrolled', scrollY > 8);
    addEventListener('scroll', onScroll, { passive: true });
    onScroll();
  }

  const row = document.querySelector<HTMLElement>('[data-finder]');
  const finder = row?.querySelector<HTMLElement>('.ln-finder');
  if (row && finder) {
    const items = [...row.querySelectorAll<HTMLElement>('[data-prov]')];
    let idx = 0;
    let hovering = false;
    const place = (i: number) => {
      idx = i;
      items.forEach((el, k) => el.classList.toggle('is-active', k === i));
      const el = items[i];
      finder.style.cssText = `--x:${el.offsetLeft}px;--y:${el.offsetTop}px;--w:${el.offsetWidth}px;--h:${el.offsetHeight}px`;
    };
    place(0);
    requestAnimationFrame(() => finder.classList.add('ready'));
    document.fonts?.ready.then(() => place(idx));
    addEventListener('resize', () => place(idx));
    items.forEach((el, k) => el.addEventListener('mouseenter', () => { hovering = true; place(k); }));
    row.addEventListener('mouseleave', () => { hovering = false; });
    if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
      setInterval(() => { if (!hovering && !document.hidden) place((idx + 1) % items.length); }, 2400);
    }
  }
  // Feature cards: reveal once, animate only while on screen.
  const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const feats = document.querySelector<HTMLElement>('[data-feats]');
  if (feats) {
    feats.classList.add('js');
    const io = new IntersectionObserver((entries) => {
      for (const e of entries) {
        e.target.classList.toggle('is-live', e.isIntersecting);
        if (e.isIntersecting) e.target.classList.add('is-in');
      }
    }, { threshold: 0.2 });
    feats.querySelectorAll<HTMLElement>('[data-feat]').forEach((el, i) => {
      el.style.setProperty('--n', String(i % 3));
      io.observe(el);
    });
    feats.addEventListener('pointermove', (e) => {
      const card = (e.target as HTMLElement).closest<HTMLElement>('[data-feat]');
      if (!card) return;
      const r = card.getBoundingClientRect();
      card.style.setProperty('--mx', `${e.clientX - r.left}px`);
      card.style.setProperty('--my', `${e.clientY - r.top}px`);
    });
  }
  const isLive = (el: Element) => !!el.closest('.is-live');
  const every = (ms: number, fn: () => void) => setInterval(() => { if (!document.hidden) fn(); }, ms);

  const usage = document.querySelector<HTMLElement>('[data-usage]');
  if (usage) {
    const bars = [...usage.querySelectorAll<HTMLElement>('[data-ubars] > span')];
    const tip = usage.querySelector<HTMLElement>('[data-utip]')!;
    const totalEl = usage.querySelector<HTMLElement>('[data-usage-total]')!;
    const days = ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'];
    const tokensOf = (b: HTMLElement) => Number(b.dataset.h) * 6400;
    const fmt = (n: number) => (n >= 1e6 ? `${(n / 1e6).toFixed(2)}M` : `${Math.round(n / 1e3)}k`);
    let total = bars.reduce((sum, b) => sum + tokensOf(b), 0);
    let counted = false;
    let at = bars.length - 1;
    const show = (i: number) => {
      bars.forEach((b, k) => b.classList.toggle('is-on', k === i));
      const b = bars[i];
      const t = tokensOf(b);
      tip.innerHTML = `<b>${days[Math.floor(i / 4)]}</b>${fmt(t)} tokens · $${((t * 0.7) / 1e6).toFixed(2)}`;
      const half = tip.offsetWidth / 2;
      const x = Math.min(Math.max(b.offsetLeft + b.offsetWidth / 2, half), usage.offsetWidth - half);
      tip.style.setProperty('--x', `${x}px`);
      tip.style.setProperty('--y', `${b.offsetHeight}px`);
      tip.classList.add('is-on');
    };
    const countUp = () => {
      counted = true;
      if (still) { totalEl.textContent = fmt(total); return; }
      const t0 = performance.now();
      const tick = (now: number) => {
        const k = Math.min(1, (now - t0) / 1400);
        totalEl.textContent = fmt(total * (1 - Math.pow(1 - k, 3)));
        if (k < 1) requestAnimationFrame(tick);
      };
      requestAnimationFrame(tick);
    };
    if (still) { countUp(); show(at); }
    every(1700, () => {
      if (still || !isLive(usage)) return;
      if (!counted) { countUp(); return; }
      total += 2000 + Math.round(Math.random() * 9000);
      totalEl.textContent = fmt(total);
      at = (at + 5) % bars.length;
      show(at);
    });
  }

  const snip = document.querySelector<HTMLElement>('[data-snip]');
  if (snip) {
    const tabs = [...snip.querySelectorAll<HTMLButtonElement>('[data-snip-tab]')];
    const panes = [...snip.querySelectorAll<HTMLElement>('.ln-snip-pane')];
    const ind = snip.querySelector<HTMLElement>('.ln-snip-ind')!;
    const copy = snip.querySelector<HTMLButtonElement>('[data-snip-copy]')!;
    let cur = 0;
    let hold = false;
    const select = (i: number) => {
      cur = i;
      tabs.forEach((t, k) => t.classList.toggle('is-on', k === i));
      panes.forEach((p, k) => p.classList.toggle('is-on', k === i));
      ind.style.cssText = `--x:${tabs[i].offsetLeft}px;--w:${tabs[i].offsetWidth}px`;
    };
    select(0);
    document.fonts?.ready.then(() => select(cur));
    tabs.forEach((t, k) => t.addEventListener('click', () => { hold = true; select(k); }));
    snip.addEventListener('pointerenter', () => { hold = true; });
    snip.addEventListener('pointerleave', () => { hold = false; });
    copy.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(panes[cur].textContent ?? '');
        copy.classList.add('is-done');
        setTimeout(() => copy.classList.remove('is-done'), 1400);
      } catch {}
    });
    if (!still) every(3800, () => { if (!hold && isLive(snip)) select((cur + 1) % tabs.length); });
  }

  const stream = document.querySelector<HTMLElement>('[data-stream]');
  if (stream) {
    const out = stream.querySelector<HTMLElement>('[data-stream-out]')!;
    const meta = stream.querySelector<HTMLElement>('[data-stream-meta]')!;
    const code: [string, string?][] = [
      ['#include ', 'c-kw'], ['"updater.hpp"', 'c-str'], ['\n'],
      ['int', 'c-kw'], [' main() {\n  '],
      ['if', 'c-kw'], [' (!Updater::init()) '], ['return', 'c-kw'], [' '], ['1', 'c-num'], [';\n  '],
      ['return', 'c-kw'], [' Updater::run();\n}'],
    ];
    let tok = 0, ch = 0, rest = 0, ticks = 0;
    const finish = () => {
      stream.classList.add('is-done');
      meta.textContent = `done in ${((ticks * 45) / 1000).toFixed(1)}s`;
    };
    const reset = () => {
      out.textContent = '';
      tok = ch = ticks = 0;
      stream.classList.remove('is-done');
      meta.textContent = 'streaming…';
    };
    if (still) {
      for (const [text, cls] of code) { const s = document.createElement('span'); if (cls) s.className = cls; s.textContent = text; out.append(s); }
      ticks = 48;
      finish();
    } else {
      reset();
      every(45, () => {
        if (!isLive(stream)) return;
        if (rest) { if (--rest === 0) reset(); return; }
        ticks++;
        for (let n = 0; n < 2 && tok < code.length; n++) {
          const [text, cls] = code[tok];
          if (ch === 0) { const s = document.createElement('span'); if (cls) s.className = cls; out.append(s); }
          out.lastElementChild!.textContent += text[ch++];
          if (ch >= text.length) { tok++; ch = 0; }
        }
        if (tok >= code.length) { finish(); rest = 70; }
      });
    }
  }

  const fix = document.querySelector<HTMLElement>('[data-fix]');
  if (fix) {
    const labels = ['Sending request', 'TypeError: res.text is undefined', 'Patching line 21', 'Running again', '200 OK · 312 tokens'];
    const label = fix.querySelector<HTMLElement>('[data-fix-label]')!;
    const count = fix.querySelector<HTMLElement>('[data-fix-count]')!;
    let step = 0, wait = 0;
    const set = (i: number) => {
      step = i;
      fix.dataset.step = String(i);
      fix.style.setProperty('--s', String(i));
      label.textContent = labels[i];
      count.textContent = `${i + 1} / ${labels.length}`;
    };
    if (still) set(labels.length - 1);
    else every(1400, () => {
      if (!isLive(fix)) return;
      if (wait) { wait--; return; }
      const next = (step + 1) % labels.length;
      set(next);
      if (next === labels.length - 1) wait = 1;
    });
  }

  const dialog = document.getElementById('signinDialog') as HTMLDialogElement | null;
  document.querySelectorAll<HTMLElement>('[data-open-signin],[data-open-signin-register]').forEach(b =>
    b.addEventListener('click', (e) => { e.preventDefault(); dialog?.showModal(); })
  );
  document.querySelectorAll<HTMLElement>('[data-close-signin]').forEach(b =>
    b.addEventListener('click', () => dialog?.close())
  );
  if (location.hash === '#register') dialog?.showModal();
  document.querySelectorAll<HTMLAnchorElement>('a[href^="#"]').forEach(a => {
    a.addEventListener('click', (e) => {
      const t = document.querySelector(a.getAttribute('href')!);
      if (t) { e.preventDefault(); t.scrollIntoView({ behavior: 'smooth' }); }
    });
  });
</script>

<style>
  /* ── Base ── */
  .landing {
    min-height: 100svh;
    font-family: 'Geist', system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
    --mono: 'Geist Mono', ui-monospace, 'JetBrains Mono', 'Cascadia Code', Consolas, monospace;
    font-feature-settings: 'ss01';
  }
  .ln-container { max-width: 1140px; margin: 0 auto; padding: 0 24px; }
  .ln-container--narrow { max-width: 800px; }
  .accent { color: var(--accent); }
  .dim { color: var(--muted); }
  .mono { font-family: var(--mono); }
  .text-xs { font-size: 11px; }

  /* ── Nav ── */
  .ln-nav {
    position: sticky; top: 0; z-index: 50;
    height: 68px; display: flex; align-items: center;
    background: transparent;
    border-bottom: 1px solid transparent;
    transition: background-color 0.25s, border-color 0.25s;
  }
  .ln-nav.scrolled {
    background: rgb(5 8 11 / 0.78); border-color: var(--border);
    backdrop-filter: blur(14px) saturate(140%); -webkit-backdrop-filter: blur(14px) saturate(140%);
  }
  .ln-nav .ln-container { display: flex; align-items: center; gap: 44px; width: 100%; }
  .ln-nav-right { margin-left: auto; }
  .ln-brand { display: flex; align-items: center; gap: 10px; font-size: 16px; font-weight: 600; letter-spacing: -0.02em; }
  .ln-logo {
    display: grid; place-items: center;
    width: 28px; height: 28px; border-radius: 8px;
    color: var(--accent); background: var(--accent-soft); border: 1px solid var(--accent-line);
  }
  .ln-links { display: flex; gap: 30px; font-size: 13.5px; color: var(--muted); }
  .ln-links a { transition: color 0.15s; }
  .ln-links a:hover { color: var(--fg); }
  .ln-signin-btn {
    display: inline-flex; align-items: center; gap: 7px;
    height: 38px; padding: 0 18px; border-radius: 999px;
    font-size: 13.5px; font-weight: 500;
    background: var(--fg); color: #05080b;
    box-shadow: inset 0 -1px 0 rgb(0 0 0 / 0.12);
    cursor: pointer; transition: background-color 0.15s, box-shadow 0.2s, transform 0.15s;
  }
  .ln-signin-btn:hover { background: #fff; box-shadow: 0 0 0 4px rgb(255 255 255 / 0.08); }

  /* ── Buttons ── */
  .ln-btn {
    display: inline-flex; align-items: center; justify-content: center; gap: 8px;
    height: 46px; padding: 0 22px; border-radius: 999px;
    font-size: 14.5px; font-weight: 500; white-space: nowrap;
    border: 1px solid var(--border-2); background: var(--surface); color: var(--fg);
    cursor: pointer; transition: color 0.15s, border-color 0.15s, background-color 0.15s, box-shadow 0.25s, transform 0.15s;
  }
  .ln-btn:hover { border-color: var(--accent-line); color: var(--accent); }
  .ln-btn--primary {
    background: var(--accent); border-color: transparent; color: #031217; font-weight: 600;
    box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.35), 0 10px 30px -10px rgb(34 211 238 / 0.65);
  }
  .ln-btn--primary:hover {
    color: #031217; border-color: transparent; transform: translateY(-1px);
    box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.35), 0 0 0 4px rgb(34 211 238 / 0.14), 0 14px 36px -10px rgb(34 211 238 / 0.8);
  }
  .ln-btn--primary:active { transform: translateY(0); }
  .ln-arrow { display: inline-flex; transition: transform 0.2s; }
  .ln-btn:hover .ln-arrow { transform: translateX(3px); }
  .ln-btn--ghost { background: transparent; border-color: transparent; color: var(--fg); }
  .ln-btn--ghost:hover { background: rgb(255 255 255 / 0.04); border-color: transparent; color: var(--fg); }
  .ln-btn--sm { height: 36px; padding: 0 16px; font-size: 12.5px; }
  .ln-text-btn { color: var(--fg); font-weight: 500; background: none; border: 0; cursor: pointer; font: inherit; transition: color 0.15s; }
  .ln-text-btn:hover { color: var(--accent); }

  /* ── Hero ── */
  .ln-hero { position: relative; isolation: isolate; padding: 96px 0 88px; text-align: center; }
  .ln-hero::before {
    content: ''; position: absolute; inset: -68px 0 0; z-index: -1; pointer-events: none;
    background-image:
      linear-gradient(rgb(255 255 255 / 0.04) 1px, transparent 1px),
      linear-gradient(90deg, rgb(255 255 255 / 0.04) 1px, transparent 1px);
    background-size: 64px 64px; background-position: center top;
    -webkit-mask-image: radial-gradient(ellipse 60% 70% at 50% 25%, #000 20%, transparent 72%);
    mask-image: radial-gradient(ellipse 60% 70% at 50% 25%, #000 20%, transparent 72%);
  }
  .ln-hero::after {
    content: ''; position: absolute; z-index: -1; pointer-events: none;
    left: 50%; top: -120px; width: min(900px, 100%); height: 520px; translate: -50% 0;
    background: radial-gradient(closest-side, rgb(34 211 238 / 0.13), transparent);
    filter: blur(20px);
  }
  .ln-kicker {
    display: inline-flex; align-items: center; gap: 9px;
    padding: 6px 14px 6px 12px; border-radius: 999px;
    font-family: var(--mono); font-size: 10.5px; font-weight: 500; letter-spacing: 0.14em; color: var(--accent);
    background: rgb(34 211 238 / 0.05); border: 1px solid var(--accent-line);
  }
  .ln-dot { position: relative; width: 6px; height: 6px; border-radius: 50%; background: var(--accent); }
  .ln-dot::after {
    content: ''; position: absolute; inset: 0; border-radius: 50%; background: var(--accent);
    animation: ln-ping 2s cubic-bezier(0, 0, 0.2, 1) infinite;
  }
  @keyframes ln-ping { 75%, 100% { transform: scale(2.6); opacity: 0; } }
  .ln-title {
    margin-top: 30px;
    font-size: clamp(46px, 7.4vw, 88px);
    font-weight: 600; line-height: 1.02; letter-spacing: -0.035em;
  }
  .ln-title > span { display: block; }
  .ln-title .accent, .ln-heading .accent {
    color: transparent;
    background: linear-gradient(100deg, #6c939d 0%, #8fb7c1 35%, #c8f4fb 50%, #8fb7c1 65%, #6c939d 100%);
    background-size: 260% 100%; background-position: 100% 0;
    -webkit-background-clip: text; background-clip: text;
  }
  .ln-title .accent { animation: ln-rise 0.9s cubic-bezier(0.2, 0.7, 0.2, 1) calc(var(--i, 0) * 90ms + 80ms) both, ln-sheen 6s ease-in-out 1.6s infinite; }
  @keyframes ln-sheen { 0%, 100% { background-position: 100% 0; } 50% { background-position: 0% 0; } }
  .ln-sub { max-width: 560px; margin: 24px auto 0; font-size: 16.5px; line-height: 1.65; color: var(--muted); text-wrap: balance; }

  /* Providers with a gliding viewfinder */
  .ln-providers {
    position: relative; display: flex; justify-content: center; gap: 6px; flex-wrap: wrap;
    margin-top: 38px;
  }
  .ln-prov {
    display: inline-flex; align-items: center; gap: 9px;
    padding: 9px 14px; font-size: 14px; font-weight: 500; color: var(--muted);
    cursor: default; transition: color 0.3s;
  }
  .ln-prov > :first-child { transition: color 0.3s, filter 0.3s; }
  .ln-prov.is-active { color: var(--fg); }
  .ln-prov.is-active > :first-child { color: var(--brand); filter: drop-shadow(0 0 8px color-mix(in srgb, var(--brand) 45%, transparent)); }
  .ln-finder {
    position: absolute; left: 0; top: 0; pointer-events: none;
    width: var(--w, 0); height: var(--h, 0);
    transform: translate(var(--x, 0), var(--y, 0));
    border-radius: 6px;
    background: radial-gradient(120% 140% at 50% 50%, rgb(34 211 238 / 0.06), transparent 70%);
  }
  .ln-finder.ready { transition: transform 0.5s cubic-bezier(0.2, 0.8, 0.2, 1), width 0.5s cubic-bezier(0.2, 0.8, 0.2, 1), height 0.5s; }
  .ln-finder i { position: absolute; width: 9px; height: 9px; border: 0 solid var(--accent); }
  .ln-finder i:nth-child(1) { left: 0; top: 0; border-left-width: 1.5px; border-top-width: 1.5px; border-top-left-radius: 3px; }
  .ln-finder i:nth-child(2) { right: 0; top: 0; border-right-width: 1.5px; border-top-width: 1.5px; border-top-right-radius: 3px; }
  .ln-finder i:nth-child(3) { left: 0; bottom: 0; border-left-width: 1.5px; border-bottom-width: 1.5px; border-bottom-left-radius: 3px; }
  .ln-finder i:nth-child(4) { right: 0; bottom: 0; border-right-width: 1.5px; border-bottom-width: 1.5px; border-bottom-right-radius: 3px; }

  .ln-hero-btns { display: flex; justify-content: center; align-items: center; gap: 10px; margin-top: 34px; }
  .ln-already { margin-top: 22px; font-size: 13px; color: var(--muted); }

  /* Entrance: waits for the opening intro, with a fallback if its script never runs */
  .ln-rise { animation: ln-rise 0.9s cubic-bezier(0.2, 0.7, 0.2, 1) calc(var(--i, 0) * 90ms + 80ms) both; }
  :global(html.intro-on) .ln-rise, :global(html.intro-on) .ln-title .accent { animation: ln-rise-late 0.6s ease 10.4s both; }
  @keyframes ln-rise { from { opacity: 0; transform: translateY(16px); filter: blur(8px); } to { opacity: 1; transform: none; filter: none; } }
  @keyframes ln-rise-late { from { opacity: 0; } to { opacity: 1; } }
  @media (prefers-reduced-motion: reduce) {
    .ln-rise, .ln-title .accent, .ln-dot::after { animation: none; }
    .ln-finder.ready { transition: none; }
  }

  /* ── Sections ── */
  .ln-section { padding: 64px 0; }
  .ln-rule { height: 1px; margin-bottom: 52px; background: linear-gradient(90deg, transparent, var(--border), transparent); }
  .ln-eyebrow { text-align: center; font-family: var(--mono); font-size: 10.5px; font-weight: 500; letter-spacing: 0.2em; color: var(--muted); margin-bottom: 14px; }
  .ln-heading { text-align: center; font-size: clamp(34px, 5vw, 54px); font-weight: 600; line-height: 1.08; letter-spacing: -0.03em; }
  .ln-heading--sm { font-size: clamp(28px, 4vw, 42px); }
  .ln-lead { text-align: center; margin-top: 14px; font-size: 15px; line-height: 1.6; color: var(--muted); }
  .ln-note { text-align: center; margin-top: 20px; font-size: 12px; color: #3d4c55; font-style: italic; }

  /* ── Activity Card ── */
  .ln-activity {
    margin-top: 48px; padding: 24px;
    border-radius: 16px;
    background: linear-gradient(180deg, var(--surface-2), var(--surface));
    border: 1px solid var(--border);
  }
  .ln-activity-top { display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px; }
  .ln-activity-info { display: flex; align-items: center; gap: 12px; }
  .ln-activity-name { font-size: 14px; font-weight: 600; }
  .ln-activity-meta { font-size: 11px; color: var(--muted); }

  /* Radars */
  .ln-radars { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px; margin-top: 20px; }
  .ln-radar-card {
    display: flex; flex-direction: column; align-items: center;
    padding: 28px 16px 20px; border-radius: 12px;
    background: var(--surface); border: 1px solid var(--border);
    transition: border-color 0.2s, transform 0.2s;
    overflow: hidden;
  }
  .ln-radar-card:hover { border-color: var(--accent-line); transform: translateY(-2px); }
  .ln-radar { position: relative; width: 140px; height: 140px; }
  .ln-ring {
    position: absolute; inset: 0; border-radius: 50%;
    border: 1px solid rgb(74 222 128 / 0.22);
    animation: ring-pulse 3.6s ease-out infinite;
  }
  .ln-ring--2 { animation-delay: 1.2s; }
  .ln-ring--3 { animation-delay: 2.4s; }
  .ln-ring--purple { border-color: rgb(168 85 247 / 0.22); }
  .ln-ring--cyan { border-color: rgb(34 211 238 / 0.22); }
  @keyframes ring-pulse { 0% { transform: scale(0.4); opacity: 0.9; } 100% { transform: scale(1.25); opacity: 0; } }

  /* Circular visualizer: 36 bars radiating from the center */
  .ln-viz {
    position: absolute; inset: 0; pointer-events: none;
    color: rgb(74 222 128);
    filter: drop-shadow(0 0 4px color-mix(in srgb, currentColor 55%, transparent));
  }
  .ln-viz--purple { color: rgb(168 85 247); }
  .ln-viz--cyan { color: var(--accent); }
  .ln-tick { position: absolute; inset: 0; transform: rotate(var(--a)); }
  .ln-tick::before {
    content: ''; position: absolute;
    left: calc(50% - 1px); bottom: calc(50% + 31px);
    width: 2px; height: var(--h); border-radius: 2px;
    background: linear-gradient(to top, currentColor, color-mix(in srgb, currentColor 25%, transparent));
    transform-origin: bottom;
    animation: tick-pulse 1.4s ease-in-out calc(var(--dl) * -1) infinite alternate;
  }
  @keyframes tick-pulse {
    0% { transform: scaleY(0.3); opacity: 0.35; }
    100% { transform: scaleY(1.6); opacity: 1; }
  }
  .ln-radar-glow {
    position: absolute; inset: calc(50% - 25px); border-radius: 50%; z-index: -1;
    background: radial-gradient(circle at 50% 35%, var(--surface-2), var(--surface));
    border: 1px solid color-mix(in srgb, currentColor 35%, transparent);
    box-shadow: 0 0 22px 2px color-mix(in srgb, currentColor 20%, transparent), inset 0 0 14px color-mix(in srgb, currentColor 14%, transparent);
    animation: glow-breathe 3s ease-in-out infinite;
  }
  @keyframes glow-breathe {
    50% { box-shadow: 0 0 34px 6px color-mix(in srgb, currentColor 32%, transparent), inset 0 0 18px color-mix(in srgb, currentColor 22%, transparent); }
  }
  @media (prefers-reduced-motion: reduce) {
    .ln-ring, .ln-sweep, .ln-tick::before, .ln-radar-glow { animation: none; }
  }

  /* Brand logos: masked so they take the surrounding text color */
  .ln-mark {
    display: inline-block; flex: none;
    width: var(--s, 16px); height: var(--s, 16px);
    background-color: currentColor;
    -webkit-mask: var(--logo) center / contain no-repeat;
    mask: var(--logo) center / contain no-repeat;
  }
  .ln-mark--openai { --logo: url(/icons/openai.svg); }
  .ln-mark--claude { --logo: url(/icons/claude.svg); }
  .ln-sweep {
    position: absolute; inset: 0; border-radius: 50%;
    background: conic-gradient(from 0deg, transparent 0deg, rgb(74 222 128 / 0.1) 40deg, transparent 80deg);
    animation: sweep 4s linear infinite;
  }
  .ln-sweep--purple { background: conic-gradient(from 0deg, transparent 0deg, rgb(168 85 247 / 0.1) 40deg, transparent 80deg); }
  .ln-sweep--cyan { background: conic-gradient(from 0deg, transparent 0deg, rgb(34 211 238 / 0.1) 40deg, transparent 80deg); }
  @keyframes sweep { to { transform: rotate(360deg); } }
  .ln-radar-center { position: absolute; inset: 0; display: grid; place-items: center; color: rgb(74 222 128); isolation: isolate; }
  .ln-radar-center--purple { color: rgb(168 85 247); }
  .ln-radar-center--cyan { color: var(--accent); }
  .ln-radar-name { margin-top: 14px; font-size: 14px; font-weight: 600; }
  .ln-radar-sub { margin-top: 3px; font-size: 11px; color: var(--muted); }
  .ln-radar-badge {
    display: inline-flex; align-items: center; gap: 5px;
    margin-top: 12px; padding: 4px 10px; border-radius: 999px;
    font-size: 10px; font-weight: 500; color: var(--muted);
    background: var(--surface-2); border: 1px solid var(--border);
  }
  .ln-radar-badge--hl { color: var(--accent); border-color: var(--accent-line); background: var(--accent-soft); }

  /* Share bar */
  .ln-share { margin-top: 20px; padding-top: 18px; border-top: 1px solid var(--border); }
  .ln-share-row { display: flex; justify-content: space-between; font-size: 13px; margin-bottom: 8px; }
  .ln-bar { display: flex; height: 8px; border-radius: 999px; overflow: hidden; background: var(--surface); }
  .ln-seg { height: 100%; }
  .ln-seg--green { background: rgb(74 222 128); }
  .ln-seg--purple { background: rgb(168 85 247); }
  .ln-seg--cyan { background: var(--accent); }
  .ln-legend { display: flex; gap: 18px; margin-top: 8px; font-size: 11px; color: var(--muted); }
  .ln-ldot { display: inline-block; width: 7px; height: 7px; border-radius: 50%; margin-right: 5px; vertical-align: middle; }
  .ln-ldot--green { background: rgb(74 222 128); }
  .ln-ldot--purple { background: rgb(168 85 247); }
  .ln-ldot--cyan { background: var(--accent); }

  /* ── Feature Grid ── */
  .ln-feat-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px; margin-top: 44px; }
  .ln-feat {
    position: relative; isolation: isolate; overflow: hidden;
    display: flex; flex-direction: column;
    padding: 22px; border-radius: 16px;
    background: linear-gradient(180deg, var(--surface-2), var(--surface));
    border: 1px solid var(--border);
    transition: border-color 0.25s, transform 0.25s, opacity 0.7s cubic-bezier(0.2, 0.7, 0.2, 1), translate 0.7s cubic-bezier(0.2, 0.7, 0.2, 1);
    transition-delay: 0s, 0s, calc(var(--n, 0) * 90ms), calc(var(--n, 0) * 90ms);
  }
  .ln-feat-grid.js .ln-feat:not(.is-in) { opacity: 0; translate: 0 24px; }
  .ln-feat::before {
    content: ''; position: absolute; inset: 0; z-index: -1; pointer-events: none;
    background: radial-gradient(340px circle at var(--mx, 50%) var(--my, 0%), rgb(34 211 238 / 0.08), transparent 60%);
    opacity: 0; transition: opacity 0.3s;
  }
  .ln-feat::after {
    content: ''; position: absolute; inset: 0 0 auto; height: 1px; pointer-events: none;
    background: linear-gradient(90deg, transparent, rgb(34 211 238 / 0.4), transparent);
    opacity: 0; transition: opacity 0.3s;
  }
  .ln-feat:hover { border-color: var(--border-2); transform: translateY(-2px); }
  .ln-feat:hover::before, .ln-feat:hover::after { opacity: 1; }
  .ln-feat-ico {
    display: grid; place-items: center; width: 34px; height: 34px; border-radius: 10px;
    color: var(--accent); background: var(--accent-soft); border: 1px solid var(--accent-line);
  }
  .ln-feat h3 { margin-top: 18px; font-size: 15.5px; font-weight: 600; letter-spacing: -0.01em; }
  .ln-feat > p { margin-top: 6px; font-size: 13px; line-height: 1.55; color: var(--muted); }
  .ln-feat-vis { position: relative; margin-top: auto; padding-top: 20px; height: 216px; display: grid; place-items: center; }
  /* Offscreen cards stop animating */
  .ln-feat-grid.js .ln-feat:not(.is-live) .ln-feat-vis *,
  .ln-feat-grid.js .ln-feat:not(.is-live) .ln-feat-vis *::before,
  .ln-feat-grid.js .ln-feat:not(.is-live) .ln-feat-vis *::after { animation-play-state: paused !important; }

  /* 1 · Model hub */
  .ln-hub { position: relative; width: 280px; height: 176px; }
  .ln-hub-svg { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; }
  .ln-hub-orbit { fill: none; stroke: rgb(34 211 238 / 0.28); stroke-dasharray: 2 5; transform-origin: 140px 88px; animation: ln-spin 24s linear infinite; }
  .ln-hub-line { fill: none; stroke: var(--border-2); stroke-dasharray: 3 4; animation: ln-flow 1s linear infinite; }
  @keyframes ln-spin { to { transform: rotate(360deg); } }
  @keyframes ln-flow { to { stroke-dashoffset: -7; } }
  .ln-pkt {
    position: absolute; left: 0; top: 0; width: 7px; height: 7px; border-radius: 50%;
    background: var(--c); box-shadow: 0 0 10px var(--c), 0 0 2px var(--c);
    offset-path: var(--path); offset-rotate: 0deg;
    animation: ln-pkt 2.8s cubic-bezier(0.45, 0.05, 0.55, 0.95) var(--d) infinite both;
  }
  @keyframes ln-pkt {
    0% { offset-distance: 22%; opacity: 0; }
    10% { opacity: 1; }
    62% { offset-distance: 72%; opacity: 1; }
    68%, 100% { offset-distance: 76%; opacity: 0; }
  }
  .ln-hub-node {
    position: absolute; z-index: 1; translate: -50% -50%;
    display: flex; flex-direction: column; align-items: center; gap: 5px;
    width: 62px; padding: 9px 0 7px; border-radius: 12px;
    color: var(--muted); background: var(--surface-2); border: 1px solid var(--border);
    animation: ln-hit 2.8s ease var(--d) infinite both;
  }
  .ln-hub-node small { font-size: 9.5px; font-weight: 500; color: var(--muted); }
  @keyframes ln-hit {
    0%, 56%, 100% { color: var(--muted); border-color: var(--border); box-shadow: none; }
    66% { color: var(--c); border-color: color-mix(in srgb, var(--c) 55%, transparent); box-shadow: 0 0 22px -4px color-mix(in srgb, var(--c) 60%, transparent); }
    88% { color: var(--c); border-color: color-mix(in srgb, var(--c) 25%, transparent); box-shadow: none; }
  }
  .ln-hub-core {
    position: absolute; z-index: 1; left: 140px; top: 88px; translate: -50% -50%;
    display: grid; place-items: center; width: 52px; height: 52px; border-radius: 15px;
    color: var(--accent); background: radial-gradient(circle at 50% 25%, #0f2a31, var(--surface));
    border: 1px solid var(--accent-line);
    box-shadow: 0 0 32px -6px rgb(34 211 238 / 0.55), inset 0 1px 0 rgb(255 255 255 / 0.06);
  }
  .ln-hub-core::before {
    content: ''; position: absolute; inset: -1px; border-radius: inherit; border: 1px solid var(--accent);
    animation: ln-core 1.4s ease-out infinite;
  }
  @keyframes ln-core { from { transform: scale(1); opacity: 0.6; } to { transform: scale(1.6); opacity: 0; } }

  /* 2 · Keys */
  .ln-keyset { position: relative; width: 100%; display: flex; flex-direction: column; gap: 8px; }
  .ln-krow {
    display: flex; align-items: center; gap: 10px; height: 52px; padding: 0 12px; border-radius: 12px;
    background: var(--surface); border: 1px solid var(--border);
  }
  .ln-keyset-sel {
    position: absolute; z-index: 2; left: 0; right: 0; top: 0; height: 52px; border-radius: 12px; pointer-events: none;
    border: 1px solid var(--accent-line); background: rgb(34 211 238 / 0.05);
    box-shadow: 0 0 26px -10px rgb(34 211 238 / 0.6);
    animation: ln-sel 7.5s cubic-bezier(0.7, 0, 0.2, 1) infinite;
  }
  @keyframes ln-sel { 0%, 28% { translate: 0 0; } 33%, 61% { translate: 0 60px; } 66%, 95% { translate: 0 120px; } 100% { translate: 0 0; } }
  .ln-krow-ico {
    display: grid; place-items: center; flex: none; width: 28px; height: 28px; border-radius: 8px;
    color: var(--muted); background: var(--surface-2); border: 1px solid var(--border);
  }
  .ln-krow-main { display: flex; flex-direction: column; flex: 1; min-width: 0; gap: 1px; }
  .ln-krow-main b { font-size: 12px; font-weight: 600; }
  .ln-krow-main .mono, .ln-krow-state { font-size: 10px; color: var(--muted); }
  .ln-krow-state { display: grid; }
  .ln-krow-state > span { grid-area: 1 / 1; }
  .ln-krow-state > span:first-child { color: rgb(251 191 36); animation: ln-st-a 7.5s infinite; }
  .ln-krow-state > span:last-child { color: var(--accent); animation: ln-st-b 7.5s infinite; }
  @keyframes ln-st-a { 0%, 72%, 98%, 100% { opacity: 1; } 75%, 95% { opacity: 0; } }
  @keyframes ln-st-b { 0%, 72%, 98%, 100% { opacity: 0; } 75%, 95% { opacity: 1; } }
  .ln-krow-budget { display: flex; flex-direction: column; align-items: flex-end; gap: 5px; flex: none; width: 62px; }
  .ln-krow-budget i { position: relative; display: block; width: 100%; height: 4px; border-radius: 99px; overflow: hidden; background: var(--border); }
  .ln-krow-budget i::after {
    content: ''; position: absolute; inset: 0 auto 0 0; width: var(--p); border-radius: inherit;
    background: linear-gradient(90deg, rgb(34 211 238 / 0.45), var(--accent));
    transform-origin: left; transition: transform 1.2s cubic-bezier(0.2, 0.7, 0.2, 1) 0.4s;
  }
  .ln-feat-grid.js .ln-feat:not(.is-in) .ln-krow-budget i::after { transform: scaleX(0); }
  .ln-krow-budget small { font-family: var(--mono); font-size: 9.5px; color: var(--muted); }
  .ln-krow--flip > :not(.ln-switch) { animation: ln-dim 7.5s infinite; }
  @keyframes ln-dim { 0%, 72%, 98%, 100% { opacity: 0.55; } 75%, 95% { opacity: 1; } }
  .ln-switch { position: relative; flex: none; width: 30px; height: 17px; border-radius: 999px; background: var(--border-2); }
  .ln-switch::after {
    content: ''; position: absolute; top: 2px; left: 2px; width: 13px; height: 13px; border-radius: 50%; background: #9fb0ba;
  }
  .ln-switch.is-on { background: rgb(34 211 238 / 0.35); }
  .ln-switch.is-on::after { transform: translateX(13px); background: var(--accent); }
  .ln-krow--flip .ln-switch { animation: ln-sw-bg 7.5s infinite; }
  .ln-krow--flip .ln-switch::after { animation: ln-sw-knob 7.5s infinite; }
  @keyframes ln-sw-bg { 0%, 72%, 98%, 100% { background: var(--border-2); } 75%, 95% { background: rgb(34 211 238 / 0.35); } }
  @keyframes ln-sw-knob { 0%, 72%, 98%, 100% { transform: none; background: #9fb0ba; } 75%, 95% { transform: translateX(13px); background: var(--accent); } }

  /* 3 · Usage */
  .ln-usage { width: 100%; }
  .ln-usage-top { display: flex; justify-content: space-between; align-items: baseline; font-size: 11.5px; color: var(--muted); }
  .ln-usage-top b { font-size: 20px; font-weight: 600; color: var(--fg); letter-spacing: -0.02em; }
  .ln-ubars { position: relative; display: flex; align-items: flex-end; gap: 3px; height: 116px; margin-top: 14px; border-bottom: 1px solid var(--border); }
  .ln-ubars > span {
    flex: 1; height: calc(var(--h) * 0.8); border-radius: 3px 3px 1px 1px;
    background: linear-gradient(180deg, rgb(34 211 238 / 0.7), rgb(34 211 238 / 0.1));
    transform-origin: bottom;
    transition: transform 0.8s cubic-bezier(0.2, 0.7, 0.2, 1) calc(var(--i) * 22ms), background 0.25s, box-shadow 0.25s;
  }
  .ln-feat-grid.js .ln-feat:not(.is-in) .ln-ubars > span { transform: scaleY(0); }
  .ln-ubars > span.is-on { background: linear-gradient(180deg, #a5f3fc, var(--accent)); box-shadow: 0 0 14px rgb(34 211 238 / 0.55); }
  .ln-utip {
    position: absolute; left: var(--x, 50%); bottom: calc(var(--y, 40px) + 10px); translate: -50% 0;
    padding: 5px 9px; border-radius: 8px; white-space: nowrap; pointer-events: none;
    font-size: 10.5px; color: var(--fg); background: rgb(15 22 28 / 0.94); border: 1px solid var(--border-2);
    box-shadow: 0 8px 20px -8px #000;
    opacity: 0; transition: left 0.45s cubic-bezier(0.2, 0.8, 0.2, 1), bottom 0.45s cubic-bezier(0.2, 0.8, 0.2, 1), opacity 0.3s;
  }
  .ln-utip.is-on { opacity: 1; }
  .ln-utip :global(b) { margin-right: 4px; font-weight: 600; color: var(--accent); }
  .ln-ubars-x { display: flex; justify-content: space-between; margin-top: 7px; font-family: var(--mono); font-size: 9.5px; color: var(--muted); }

  /* 4 · Snippets */
  .ln-snip { width: 100%; overflow: hidden; border-radius: 12px; background: #070b0e; border: 1px solid var(--border); }
  .ln-snip-tabs { position: relative; display: flex; align-items: center; gap: 2px; padding: 6px; background: var(--surface); border-bottom: 1px solid var(--border); }
  .ln-snip-tabs button { position: relative; z-index: 1; padding: 5px 10px; border-radius: 7px; font-size: 11px; font-weight: 500; color: var(--muted); transition: color 0.2s; }
  .ln-snip-tabs button:hover, .ln-snip-tabs button.is-on { color: var(--fg); }
  .ln-snip-ind {
    position: absolute; top: 6px; bottom: 6px; left: 0; width: var(--w, 0); translate: var(--x, 0) 0;
    border-radius: 7px; background: var(--surface-2); border: 1px solid var(--border-2);
    transition: translate 0.4s cubic-bezier(0.2, 0.8, 0.2, 1), width 0.4s cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .ln-snip-tabs .ln-snip-copy { display: grid; place-items: center; width: 26px; height: 26px; margin-left: auto; padding: 0; }
  .ln-snip-copy :global(svg:last-child) { display: none; color: rgb(74 222 128); }
  .ln-snip-copy.is-done :global(svg:first-child) { display: none; }
  .ln-snip-copy.is-done :global(svg:last-child) { display: block; }
  .ln-snip-panes { display: grid; padding: 14px 12px 16px; }
  .ln-snip-pane {
    grid-area: 1 / 1; margin: 0; overflow-x: auto; scrollbar-width: none;
    font-family: var(--mono); font-size: 9.5px; line-height: 1.8; color: #c7d3da; white-space: pre;
    opacity: 0; transition: opacity 0.25s;
  }
  .ln-snip-pane.is-on { opacity: 1; }
  .ln-snip-pane code > span { display: inline-block; }
  .ln-snip-pane.is-on code > span { animation: ln-type 0.55s steps(20, end) calc(var(--l) * 170ms + 120ms) both; }
  @keyframes ln-type { from { clip-path: inset(0 100% 0 0); } to { clip-path: inset(0); } }

  /* 5 · Streaming reply */
  .ln-stream { width: 100%; display: flex; flex-direction: column; gap: 8px; }
  .ln-deny {
    display: flex; align-items: center; gap: 8px; padding: 8px 12px; border-radius: 10px; font-size: 11.5px;
    background: var(--surface); border: 1px dashed var(--border-2); opacity: 0.75;
  }
  .ln-deny-x { display: grid; place-items: center; flex: none; width: 18px; height: 18px; border-radius: 50%; color: rgb(248 113 113); background: rgb(248 113 113 / 0.12); }
  .ln-deny-who { font-weight: 600; }
  .ln-deny-msg { margin-left: auto; color: var(--muted); text-decoration: line-through; text-decoration-color: rgb(248 113 113 / 0.55); }
  .ln-reply { overflow: hidden; border-radius: 12px; background: #070b0e; border: 1px solid var(--accent-line); box-shadow: 0 0 30px -14px rgb(34 211 238 / 0.6); }
  .ln-reply-head { display: flex; align-items: center; gap: 8px; padding: 7px 12px; font-size: 11px; white-space: nowrap; border-bottom: 1px solid var(--border); }
  .ln-reply-who { display: inline-flex; align-items: center; gap: 5px; font-weight: 600; color: var(--accent); }
  .ln-reply-model { padding: 2px 6px; border-radius: 5px; font-size: 9.5px; color: var(--muted); background: var(--surface-2); }
  .ln-reply-meta { margin-left: auto; font-size: 9.5px; color: var(--muted); transition: color 0.3s; }
  .ln-stream.is-done .ln-reply-meta { color: rgb(74 222 128); }
  .ln-reply-code { margin: 0; min-height: 101px; padding: 10px 12px 12px; font-family: var(--mono); font-size: 10.5px; line-height: 1.55; color: #c7d3da; white-space: pre; }
  .ln-reply-code :global(.c-kw) { color: rgb(168 85 247); }
  .ln-reply-code :global(.c-str) { color: rgb(74 222 128); }
  .ln-reply-code :global(.c-num) { color: rgb(251 191 36); }
  .ln-caret { display: inline-block; width: 6px; height: 12px; margin-left: 1px; vertical-align: -2px; background: var(--accent); animation: ln-blink 1s steps(1) infinite; }
  @keyframes ln-blink { 50% { opacity: 0; } }

  /* 6 · Fix loop */
  .ln-fix { --s: 0; width: 100%; }
  .ln-fix-top { display: flex; justify-content: space-between; align-items: center; font-size: 11.5px; }
  .ln-fix-status { display: inline-flex; align-items: center; gap: 8px; font-weight: 500; transition: color 0.3s; }
  .ln-fix-status i { width: 8px; height: 8px; border-radius: 50%; background: rgb(251 191 36); box-shadow: 0 0 10px rgb(251 191 36 / 0.6); animation: ln-blink 1s ease-in-out infinite; transition: background 0.3s, box-shadow 0.3s; }
  .ln-fix-count { font-size: 10px; color: var(--muted); }
