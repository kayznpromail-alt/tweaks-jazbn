  .ln-chat--fail { opacity: 0.6; }
  .ln-chat--ok { border-color: var(--accent-line); }
  .ln-chat-label { font-size: 9px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em; color: var(--muted); }
  .ln-chat-msg { margin-top: 6px; font-size: 11px; }
  .ln-chat-msg--err { color: rgb(248 113 113); }
  .ln-chat-code { display: block; margin-top: 6px; font-size: 9px; line-height: 1.5; white-space: pre; }

  /* Debug preview */
  .ln-debug {
    padding: 10px 12px; border-radius: 8px;
    background: var(--surface); border: 1px solid var(--border);
  }
  .ln-debug-head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px; font-size: 10px; }
  .ln-debug-tag {
    padding: 3px 8px; border-radius: 4px; font-size: 9px; font-weight: 600;
    color: rgb(251 191 36); background: rgb(251 191 36 / 0.1); border: 1px solid rgb(251 191 36 / 0.2);
  }
  .ln-debug-diff { font-family: var(--mono); font-size: 10px; line-height: 1.7; }
  .ln-diff-old { display: block; color: rgb(248 113 113); background: rgb(248 113 113 / 0.06); padding: 2px 6px; border-radius: 3px; }
  .ln-diff-new { display: block; color: rgb(74 222 128); background: rgb(74 222 128 / 0.06); padding: 2px 6px; border-radius: 3px; margin-top: 2px; }

  /* Syntax colors */
  .c-kw { color: rgb(168 85 247); }
  .c-str { color: rgb(74 222 128); }
  .c-key { color: var(--accent); }
  .c-num { color: rgb(251 191 36); }

  /* ── Code Card ── */
  .ln-code-card {
    margin-top: 40px; max-width: 640px; margin-inline: auto;
    border-radius: 14px; overflow: hidden;
    background: var(--surface); border: 1px solid var(--border);
  }
  .ln-code-top {
    display: flex; justify-content: space-between; align-items: center;
