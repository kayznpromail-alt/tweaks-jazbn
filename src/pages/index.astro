---
import Shell from '../layouts/Shell.astro';
import Icon from '../components/Icon.astro';
import { Starfield } from '../components/ui/starfield';
import { FAQ } from '../components/ui/faq-tabs';
import { SignIn1 } from '../components/ui/modern-stunning-sign-in';
import { API_ROOT, DISCORD_URL, providers } from '../data/site';

const year = new Date().getFullYear();
const modelCount = providers.reduce((sum, p) => sum + p.models.length, 0);
const providerCount = providers.length;

const features = [
  { icon: 'grid' as const, title: 'Your models. One place.', desc: 'Explore the model catalog and choose the right fit for your next project.', badges: ['GPT', 'Claude', 'Gemini', 'Grok'] },
  { icon: 'key' as const, title: 'Keys that work your way.', desc: 'Keep projects separate with API keys, model access and individual limits.', lines: ['Production', 'Side project', 'Local dev'] },
  { icon: 'activity' as const, title: 'See where your usage goes.', desc: 'Follow your requests, token usage and costs from your workspace.' },
  { icon: 'terminal' as const, title: 'Made for your workflow.', desc: 'Find connection details and setup instructions for your clients and CLI tools.' },
  { icon: 'code' as const, title: 'Keep building.', desc: 'From your idea to the first lines of code. Drop-in OpenAI-compatible endpoint.' },
  { icon: 'search' as const, title: 'Follow every step.', desc: 'A small walkthrough: spot an issue, change a line, and run it again.' },
];
---
<Shell title="Your AI Workspace">
  <div class="landing">

    <!-- Starfield background -->
    <div class="ln-starfield">
      <Starfield client:load starCount={15000} starColor={{ r: 34, g: 211, b: 238 }} maxOpacity={200} rotationSpeed={0.0003} waveFrequency={15} />
    </div>

    <!-- Nav -->
    <header class="ln-nav" id="lnNav">
      <div class="ln-container">
        <a href="/" class="ln-brand">
          <span class="ln-logo"><Icon name="terminal" size={14} /></span>
          <span class="ln-brand-name">edgey<span class="acc">.shop</span></span>
        </a>
        <nav class="ln-links">
          <a href="#features">Features</a>
          <a href="#how">How it works</a>
          <a href="#faq">FAQ</a>
        </nav>
        <div class="ln-nav-right">
          <button class="ln-btn ln-btn--ghost" data-open-signin>Sign in</button>
        </div>
      </div>
    </header>

    <!-- Hero -->
    <section class="ln-hero">
      <div class="ln-orbs">
        <div class="ln-orb ln-orb--1"></div>
        <div class="ln-orb ln-orb--2"></div>
        <div class="ln-orb ln-orb--3"></div>
      </div>
      <div class="ln-particles" id="particles"></div>
      <div class="ln-container">
        <div class="ln-hero-badge">
          <span class="ln-dot"></span>
          <span>YOUR AI WORKSPACE</span>
        </div>
        <h1 class="ln-hero-title">
          More models.<br />
          <span class="ln-hero-fade">One workspace.</span>
        </h1>
        <p class="ln-hero-sub">
          Connect to AI models through one API.<br />
          Manage keys, usage limits and token costs in one place.
        </p>

        <div class="ln-provider-strip">
          <span class="ln-provider"><span class="ln-prov-icon ln-prov-icon--gpt">
            <img src="/icons/openai.svg" width="18" height="18" alt="OpenAI" />
          </span>OpenAI</span>
          <span class="ln-provider"><span class="ln-prov-icon ln-prov-icon--claude">
            <img src="/icons/claude.svg" width="18" height="18" alt="Claude" />
          </span>Claude</span>
          <span class="ln-provider ln-prov--highlight"><span class="ln-prov-icon ln-prov-icon--edgey">
            <Icon name="terminal" size={16} />
          </span>edgey</span>
          <span class="ln-provider"><span class="ln-prov-icon ln-prov-icon--grok">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor"><path d="M3 3l7.5 9L3 21h2l6.5-7.8L18 21h3l-8-9.5L20.5 3h-2L12 10.3 6 3H3z"/></svg>
          </span>Grok</span>
        </div>

        <div class="ln-hero-actions">
          <button class="ln-btn ln-btn--primary ln-btn--lg" data-open-signin>
            Start building <Icon name="arrowRight" size={14} />
          </button>
          <a href="/overview" class="ln-btn ln-btn--ghost ln-btn--lg">
            Open workspace <Icon name="arrowUpRight" size={14} />
          </a>
        </div>

        <p class="ln-hero-already">
          Already with us? <button class="ln-link" data-open-signin>Use your existing account.</button>
        </p>
      </div>
    </section>

    <!-- Model Activity -->
    <section class="ln-section" id="models">
      <div class="ln-container">
        <h2 class="ln-section-title">
          Find your rhythm.<br />
          <span class="ln-fade">Build with your favorites.</span>
        </h2>
        <p class="ln-section-sub">A closer look at how your model usage comes together.</p>

        <div class="ln-counters">
          <div class="ln-counter">
            <span class="ln-counter-val" data-count={modelCount}>0</span>
            <span class="ln-counter-label">Models</span>
          </div>
          <div class="ln-counter-sep"></div>
          <div class="ln-counter">
            <span class="ln-counter-val" data-count={providerCount}>0</span>
            <span class="ln-counter-label">Providers</span>
          </div>
          <div class="ln-counter-sep"></div>
          <div class="ln-counter">
            <span class="ln-counter-val" data-count="99.9" data-suffix="%">0%</span>
            <span class="ln-counter-label">Uptime</span>
          </div>
        </div>

        <div class="ln-activity-card">
          <div class="ln-activity-head">
            <div class="ln-activity-info">
              <Icon name="activity" size={18} />
              <div>
                <p class="ln-activity-title">Model activity</p>
                <p class="ln-activity-meta">{providerCount} model families · {modelCount} models</p>
              </div>
            </div>
            <a href="/overview" class="ln-btn ln-btn--sm">Open workspace <Icon name="arrowUpRight" size={12} /></a>
          </div>

          <div class="ln-prov-cards">
            <div class="ln-prov-card">
              <div class="ln-radar">
                <div class="ln-radar-ring"></div>
                <div class="ln-radar-ring ln-radar-ring--2"></div>
                <div class="ln-radar-ring ln-radar-ring--3"></div>
                <div class="ln-radar-sweep"></div>
                <div class="ln-radar-ticks">
                  {Array.from({length: 12}).map((_, i) => <span class="ln-tick" style={`--i:${i}`}></span>)}
                </div>
                <div class="ln-radar-icon">
                  <img src="/icons/openai.svg" width="28" height="28" alt="OpenAI" />
                </div>
                <div class="ln-radar-blips">
                  <span class="ln-blip" style="--angle:35deg;--dist:38px"></span>
                  <span class="ln-blip" style="--angle:160deg;--dist:42px"></span>
                  <span class="ln-blip ln-blip--fade" style="--angle:280deg;--dist:35px"></span>
                </div>
              </div>
              <p class="ln-prov-card-name">OpenAI</p>
              <p class="ln-prov-card-sub">GPT · General purpose</p>
              <span class="ln-prov-card-stat"><Icon name="activity" size={12} /> 6 models</span>
            </div>

            <div class="ln-prov-card">
              <div class="ln-radar ln-radar--purple">
                <div class="ln-radar-ring ln-radar-ring--purple"></div>
                <div class="ln-radar-ring ln-radar-ring--2 ln-radar-ring--purple"></div>
                <div class="ln-radar-ring ln-radar-ring--3 ln-radar-ring--purple"></div>
                <div class="ln-radar-sweep ln-radar-sweep--purple"></div>
                <div class="ln-radar-ticks ln-radar-ticks--purple">
                  {Array.from({length: 12}).map((_, i) => <span class="ln-tick" style={`--i:${i}`}></span>)}
                </div>
                <div class="ln-radar-icon ln-radar-icon--purple">
                  <img src="/icons/claude.svg" width="26" height="26" alt="Claude" />
                </div>
                <div class="ln-radar-blips">
                  <span class="ln-blip ln-blip--purple" style="--angle:70deg;--dist:40px"></span>
                  <span class="ln-blip ln-blip--purple" style="--angle:210deg;--dist:36px"></span>
                </div>
              </div>
              <p class="ln-prov-card-name">Anthropic</p>
              <p class="ln-prov-card-sub">Claude · Reasoning</p>
              <span class="ln-prov-card-stat"><Icon name="activity" size={12} /> 8 models</span>
            </div>

            <div class="ln-prov-card">
              <div class="ln-radar ln-radar--cyan">
                <div class="ln-radar-ring ln-radar-ring--cyan"></div>
                <div class="ln-radar-ring ln-radar-ring--2 ln-radar-ring--cyan"></div>
                <div class="ln-radar-ring ln-radar-ring--3 ln-radar-ring--cyan"></div>
                <div class="ln-radar-sweep ln-radar-sweep--cyan"></div>
                <div class="ln-radar-ticks ln-radar-ticks--cyan">
                  {Array.from({length: 12}).map((_, i) => <span class="ln-tick" style={`--i:${i}`}></span>)}
                </div>
                <div class="ln-radar-icon ln-radar-icon--cyan">
                  <Icon name="terminal" size={26} />
                </div>
                <div class="ln-radar-blips">
                  <span class="ln-blip ln-blip--cyan" style="--angle:120deg;--dist:44px"></span>
                  <span class="ln-blip ln-blip--cyan ln-blip--fade" style="--angle:300deg;--dist:38px"></span>
                </div>
              </div>
              <p class="ln-prov-card-name">edgey</p>
              <p class="ln-prov-card-sub">Premium · Beast mode</p>
              <span class="ln-prov-card-stat"><Icon name="shield" size={12} /> Exclusive</span>
            </div>
          </div>

          <div class="ln-share-bar">
            <div class="ln-share-header">
              <span>Request share</span>
              <span class="ln-share-total">{modelCount} models total</span>
            </div>
            <div class="ln-bar-track">
              <div class="ln-bar-seg ln-bar-seg--green" style="width:16%"></div>
              <div class="ln-bar-seg ln-bar-seg--purple" style="width:20%"></div>
              <div class="ln-bar-seg ln-bar-seg--cyan" style="width:64%"></div>
            </div>
            <div class="ln-share-legend">
              <span><i class="ln-leg-dot ln-leg-dot--green"></i> GPT 16%</span>
              <span><i class="ln-leg-dot ln-leg-dot--purple"></i> Claude 20%</span>
              <span><i class="ln-leg-dot ln-leg-dot--cyan"></i> All others 64%</span>
            </div>
          </div>
        </div>

        <p class="ln-section-note">Animated preview with example usage. Your actual models and activity appear in the workspace.</p>
      </div>
    </section>

    <!-- Features -->
    <section class="ln-section" id="features">
      <div class="ln-container">
        <div class="ln-divider"></div>
        <p class="ln-section-eyebrow">NOTHING IN YOUR WAY.</p>
        <h2 class="ln-section-title ln-section-title--sm">
          From your first API key to your next project.<br />
          <span class="ln-fade">A workspace that keeps the details together.</span>
        </h2>

        <div class="ln-feat-grid">
          {features.map((f, idx) => (
            <article class="ln-feat">
              <div class="ln-feat-icon"><Icon name={f.icon} size={18} /></div>
              <h3>{f.title}</h3>
              <p>{f.desc}</p>
              {idx === 0 && (
                <div class="ln-feat-preview">
                  <div class="ln-feat-badges">
                    {f.badges?.map(b => <span class="ln-feat-badge">{b}</span>)}
                  </div>
                </div>
              )}
              {idx === 1 && (
                <div class="ln-feat-preview">
                  <div class="ln-feat-keys">
                    {f.lines?.map((l, li) => (
                      <div class={`ln-feat-key-row${li === 0 ? ' ln-feat-key-row--active' : ''}`}>
                        <span class="ln-feat-key-dot"></span>
                        <span>{l}</span>
                        <span class="ln-feat-key-badge">sk_edgey_…</span>
                      </div>
                    ))}
                  </div>
                </div>
              )}
              {idx === 2 && (
                <div class="ln-feat-preview">
                  <div class="ln-feat-bars">
                    <div class="ln-feat-bar" style="--w:85%;--delay:0s"></div>
                    <div class="ln-feat-bar" style="--w:60%;--delay:0.15s"></div>
                    <div class="ln-feat-bar" style="--w:40%;--delay:0.3s"></div>
                    <div class="ln-feat-bar" style="--w:72%;--delay:0.45s"></div>
                  </div>
                </div>
              )}
              {idx === 4 && (
                <div class="ln-feat-preview">
                  <div class="ln-feat-code-mini">
                    <div class="ln-feat-code-tab">main.py</div>
                    <code><span class="c-kw">import</span> openai</code>
                  </div>
                </div>
              )}
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- Code example -->
    <section class="ln-section" id="how">
      <div class="ln-container">
        <div class="ln-divider"></div>
        <p class="ln-section-eyebrow">DROP-IN COMPATIBLE.</p>
        <h2 class="ln-section-title ln-section-title--sm">
          One line changed.<br />
          <span class="ln-fade">Every model unlocked.</span>
        </h2>
        <p class="ln-section-sub">Same OpenAI SDK. Same format. Just point the base URL to edgey and use any model in the catalog.</p>

        <div class="ln-code-card">
          <div class="ln-code-head">
            <div class="ln-code-dots">
              <span></span><span></span><span></span>
            </div>
            <span class="ln-code-lang">python</span>
          </div>
          <pre class="ln-code-body"><code><span class="c-kw">from</span> openai <span class="c-kw">import</span> OpenAI

client = OpenAI(
    <span class="c-key">base_url</span>=<span class="c-str">"https://api.edgey.shop/v1"</span>,
    <span class="c-key">api_key</span>=<span class="c-str">"sk_edgey_..."</span>,
)

response = client.chat.completions.create(
    <span class="c-key">model</span>=<span class="c-str">"claude-sonnet-5"</span>,
    <span class="c-key">messages</span>=[{"{"}
        <span class="c-str">"role"</span>: <span class="c-str">"user"</span>,
        <span class="c-str">"content"</span>: <span class="c-str">"Let's build."</span>
    {"}"}],
)
<span class="c-kw">print</span>(response.choices[<span class="c-num">0</span>].message.content)</code></pre>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="ln-section" id="faq">
      <div class="ln-container ln-container--narrow">
        <div class="ln-divider"></div>
        <FAQ
          client:load
          title="Questions? Covered."
          subtitle="FREQUENTLY ASKED"
          categories={{
            "pricing": "Pricing",
            "setup": "Setup & API",
            "models": "Models",
            "security": "Security"
          }}
          faqData={{
            "pricing": [
              { question: "How does pricing work?", answer: "You buy token packs (starting at €9.99). Each model has a rate multiplier — a ×2 model costs twice as many tokens per request as a ×1 model. Your balance is shared across all your API keys." },
              { question: "What payment methods are accepted?", answer: "Crypto (BTC, ETH, LTC, USDT, SOL) via NOWPayments with instant delivery. PayPal and card available via Discord." },
              { question: "Can I track my spending?", answer: "Yes. Your workspace shows token usage per key, per model and per request. You always know where your balance goes." }
            ],
            "setup": [
              { question: "How do I get started?", answer: "Join the Discord, purchase a plan, and receive your 16-digit edgey ID and CLI key. Sign in here, grab your API key, and start building." },
              { question: "Is it OpenAI-compatible?", answer: "Yes. Point any OpenAI SDK or tool at https://api.edgey.shop/v1 with your sk_edgey_ key. Same format, same streaming, same function calling." },
              { question: "Can I have multiple API keys?", answer: "Yes. Create as many keys as you need — one per project, one per environment. Each key shares your account balance but can be revoked individually." }
            ],
            "models": [
              { question: "Which models are available?", answer: "GPT (including GPT-6), Claude (Opus, Sonnet, Haiku, Fable), Gemini, Grok, Deepseek, Qwen, and more. Check the model list for the full catalog." },
              { question: "What are premium models?", answer: "Some models like edgeybeast are exclusive or have special pricing. They require a separate subscription and come with their own token quota." },
              { question: "Do all models support streaming?", answer: "Yes. Every model supports streaming responses out of the box, just like the official OpenAI API." }
            ],
            "security": [
              { question: "Is my upstream provider key exposed?", answer: "No. Your requests are relayed through edgey's servers. The upstream key never leaves the infrastructure. Clients only see their own sk_edgey_ key." },
              { question: "How is my data handled?", answer: "Requests are proxied in real-time — nothing is logged or stored beyond usage metadata (model, tokens, timestamp). Your prompts and completions pass through and are never retained." }
            ]
          }}
          className="!bg-transparent !px-0"
        />
        <p class="ln-faq-more">Something else on your mind? <a href={DISCORD_URL} target="_blank" rel="noopener">Talk to support <Icon name="arrowUpRight" size={12} /></a></p>
      </div>
    </section>

    <!-- CTA -->
    <section class="ln-section">
      <div class="ln-container">
        <div class="ln-divider"></div>
        <p class="ln-section-eyebrow">LESS FRICTION. MORE BUILDING.</p>
        <h2 class="ln-cta-title">Make room for<br />your next idea.</h2>
        <div class="ln-cta-actions">
          <button class="ln-btn ln-btn--primary ln-btn--lg" data-open-signin>
            Start building <Icon name="arrowRight" size={14} />
          </button>
        </div>
      </div>
    </section>

    <!-- Footer -->
    <footer class="ln-footer">
      <div class="ln-container">
        <div class="ln-divider"></div>
        <div class="ln-footer-grid">
          <div class="ln-footer-brand">
            <a href="/" class="ln-brand">
              <span class="ln-logo"><Icon name="terminal" size={14} /></span>
              <span class="ln-brand-name">edgey<span class="acc">.shop</span></span>
            </a>
            <p>Your AI models, API keys<br />and usage in one place.</p>
            <p class="ln-footer-copy">© {year} cli.edgey.shop</p>
          </div>

          <div class="ln-footer-col">
            <h4>Workspace</h4>
            <a href="/" data-open-signin>Sign in</a>
            <a href="/#register" data-open-signin-register>Create account</a>
            <a href="/models">Models</a>
          </div>

          <div class="ln-footer-col">
            <h4>Resources</h4>
            <a href="/setup">Setup</a>
            <a href="/support">Support</a>
            <a href="#faq">FAQ</a>
          </div>

          <div class="ln-footer-col">
            <h4>Information</h4>
            <a href="/terms">Terms &amp; payments</a>
            <a href="/products">Products</a>
          </div>
        </div>
      </div>
    </footer>

    <!-- Sign-in dialog -->
    <dialog class="ln-dialog" id="signinDialog">
      <div class="ln-dialog-backdrop" data-close-signin></div>
      <div class="ln-dialog-panel ln-dialog-panel--modern">
        <button class="ln-dialog-close" data-close-signin aria-label="Close"><Icon name="x" size={18} /></button>
        <SignIn1 client:load apiBase={API_ROOT} discordUrl={DISCORD_URL} openRegistration={true} />
      </div>
    </dialog>
  </div>
</Shell>

<script>
  // Sticky nav shadow
  const nav = document.getElementById('lnNav');
  if (nav) {
    const observer = new IntersectionObserver(([e]) => nav.classList.toggle('scrolled', !e.isIntersecting), { threshold: [1], rootMargin: '-1px 0px 0px 0px' });
    observer.observe(nav);
  }

  // Dialog open/close (sign-in form is handled by the React component)
  const dialog = document.getElementById('signinDialog') as HTMLDialogElement | null;
  const openBtns = document.querySelectorAll<HTMLElement>('[data-open-signin]');
  const openRegBtns = document.querySelectorAll<HTMLElement>('[data-open-signin-register]');
  const closeBtns = document.querySelectorAll<HTMLElement>('[data-close-signin]');

  const openDialog = () => { if (dialog) dialog.showModal(); };
  openBtns.forEach(b => b.addEventListener('click', (e) => { e.preventDefault(); openDialog(); }));
  openRegBtns.forEach(b => b.addEventListener('click', (e) => { e.preventDefault(); openDialog(); }));
  closeBtns.forEach(b => b.addEventListener('click', () => dialog?.close()));

  if (location.hash === '#register') openDialog();

  // Smooth scroll for anchor links
  document.querySelectorAll<HTMLAnchorElement>('a[href^="#"]').forEach(a => {
    a.addEventListener('click', (e) => {
      const target = document.querySelector(a.getAttribute('href')!);
      if (target) { e.preventDefault(); target.scrollIntoView({ behavior: 'smooth' }); }
    });
  });

  // Animated counters
  const counters = document.querySelectorAll<HTMLElement>('[data-count]');
  const animateCounter = (el: HTMLElement) => {
    const target = parseFloat(el.dataset.count!);
    const suffix = el.dataset.suffix ?? '';
    const isFloat = String(target).includes('.');
    const duration = 1800;
    const start = performance.now();
    const step = (now: number) => {
      const progress = Math.min((now - start) / duration, 1);
      const eased = 1 - Math.pow(1 - progress, 3);
      const current = eased * target;
      el.textContent = (isFloat ? current.toFixed(1) : Math.round(current).toString()) + suffix;
      if (progress < 1) requestAnimationFrame(step);
    };
    requestAnimationFrame(step);
  };
  const counterObserver = new IntersectionObserver((entries) => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        animateCounter(e.target as HTMLElement);
        counterObserver.unobserve(e.target);
      }
    });
  }, { threshold: 0.5 });
  counters.forEach(c => counterObserver.observe(c));

  // Particles
  const particlesEl = document.getElementById('particles');
  if (particlesEl) {
    for (let i = 0; i < 30; i++) {
      const dot = document.createElement('span');
      dot.className = 'ln-particle';
      dot.style.cssText = `left:${Math.random()*100}%;top:${Math.random()*100}%;animation-delay:${Math.random()*5}s;animation-duration:${4+Math.random()*4}s;`;
      particlesEl.appendChild(dot);
    }
  }
</script>

<style>
  /* ─── Layout ─── */
  .landing { min-height: 100svh; position: relative; overflow-x: hidden; }

  /* ─── Starfield ─── */
  .ln-starfield {
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }
  .landing > *:not(.ln-starfield) { position: relative; z-index: 1; }

  .ln-container { max-width: 1140px; margin: 0 auto; padding: 0 24px; }
  .ln-container--narrow { max-width: 800px; }

  /* ─── Nav ─── */
  .ln-nav {
    position: sticky;
    top: 0;
    z-index: 50;
    height: 64px;
    display: flex;
    align-items: center;
    background: rgb(5 8 11 / 0.8);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid transparent;
    transition: border-color 0.2s;
  }
  .ln-nav.scrolled { border-color: var(--border); }
  .ln-nav .ln-container { display: flex; align-items: center; justify-content: space-between; width: 100%; }
  .ln-brand { display: flex; align-items: center; gap: 10px; font-size: 16px; font-weight: 700; }
  .ln-logo {
    display: grid; place-items: center;
    width: 28px; height: 28px; border-radius: 8px;
    color: var(--accent); background: var(--accent-soft); border: 1px solid var(--accent-line);
  }
  .acc { color: var(--muted); font-weight: 400; }
  .ln-links { display: flex; gap: 28px; font-size: 13px; color: var(--muted); }
