---
import Shell from '../layouts/Shell.astro';
import Icon from '../components/Icon.astro';
import { SignIn1 } from '../components/ui/modern-stunning-sign-in';
import { API_ROOT, DISCORD_URL, providers } from '../data/site';

const year = new Date().getFullYear();
const modelCount = providers.reduce((sum, p) => sum + p.models.length, 0);
const providerCount = providers.length;

const features = [
  {
    title: 'Every model on tap.',
    desc: 'Browse the catalog, compare rates, and switch models by changing a single string.',
  },
  {
    title: 'A key for every project.',
    desc: 'Give each app its own key, budget and model access. Pause any of them in one click.',
  },
  {
    title: 'Spend you can actually read.',
    desc: 'Requests, tokens and cost per key, broken down day by day.',
  },
  {
    title: 'Fits the tools you use.',
    desc: 'Copy-paste setup for the OpenAI SDK, curl and the edgey CLI.',
  },
  {
    title: 'Keep the momentum.',
    desc: 'From the idea to the first lines of code, through one OpenAI-compatible endpoint.',
  },
  {
    title: 'Fix it, run it again.',
    desc: 'Spot the issue, patch one line, rerun. That is the whole loop.',
  },
];

const steps = [
  {
    tag: 'Account', num: '01',
    title: 'Sign in.',
    desc: 'Create an account, or use the access number you already have.',
    checks: ['Your own workspace', 'Existing credits stay with you', 'Support on Discord'],
    btn: 'Create account', action: 'register',
  },
  {
    tag: 'Credits', num: '02',
    title: 'Top up.',
    desc: 'Check the model rates, then add credits with crypto when you\'re ready.',
    checks: ['Live model rates', 'One wallet for all your keys', 'Full payment history'],
    btn: 'Open dashboard', href: '/overview', highlight: true,
  },
  {
    tag: 'Build', num: '03',
    title: 'Plug in.',
    desc: 'Create an API key, follow the setup guide, and send your first request.',
    checks: ['Per-key limits', 'OpenAI SDK and CLI guides', 'Usage tracking'],
    btn: 'Open setup', href: '/setup',
  },
];

const faqs = [
  { q: 'What is edgey?', a: 'edgey is an AI workspace that lets you connect to multiple AI models (GPT, Claude, Gemini, Grok and more) through a single OpenAI-compatible API. Manage your keys, usage and balance in one place.' },
  { q: 'Can I use my existing account?', a: 'Yes. Sign in with your 16-digit access number. If you already have credits, they\'ll be waiting for you in your workspace.' },
  { q: 'Which models can I use?', a: 'GPT (including GPT-6), Claude (Opus, Sonnet, Haiku, Fable), Gemini, Grok, Deepseek, Qwen, and more. Check the model catalog for the full list and rates.' },
  { q: 'How do top-ups work?', a: 'You buy token packs with crypto (BTC, ETH, LTC, USDT, SOL) via NOWPayments. Your balance is shared across all your API keys. Each model has a rate multiplier.' },
  { q: 'Where are connection instructions?', a: 'In the Setup page. Point any OpenAI SDK at https://api.edgey.shop/v1 with your sk_edgey_ key. Same format, same streaming, same function calling.' },
  { q: 'How do I contact support?', a: 'Join our Discord server. The support team can help with payments, account access, and API issues. Never share your access number or API key publicly.' },
];
---
<Shell title="Every model, one key">
  <Fragment slot="head">
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Geist:wght@400..700&family=Geist+Mono:wght@400..600&display=swap" />
  </Fragment>
  <div class="landing">

    <!-- Nav -->
    <header class="ln-nav" id="lnNav">
      <div class="ln-container">
        <a href="/" class="ln-brand">
          <span class="ln-logo"><Icon name="terminal" size={14} /></span>
          <span class="ln-brand-name">edgey<span class="dim">.shop</span></span>
        </a>
        <nav class="ln-links">
          <a href="#features">Features</a>
          <a href="#how">How it works</a>
          <a href="#faq">FAQ</a>
        </nav>
        <div class="ln-nav-right">
          <button class="ln-signin-btn" data-open-signin>Sign in <Icon name="arrowUpRight" size={12} /></button>
        </div>
      </div>
    </header>

    <!-- Hero -->
    <section class="ln-hero">
      <div class="ln-container">
        <p class="ln-kicker ln-rise" style="--i:0"><span class="ln-dot"></span> {modelCount}+ MODELS · ONE API KEY</p>
        <h1 class="ln-title">
          <span class="ln-rise" style="--i:1">Every model.</span>
          <span class="ln-rise accent" style="--i:2">One key away.</span>
        </h1>
        <p class="ln-sub ln-rise" style="--i:3">
          GPT, Claude, Grok and more through a single OpenAI-compatible endpoint.{' '}<br />
          Keys, limits and spend, all in one clean dashboard.
        </p>

        <div class="ln-providers ln-rise" style="--i:4" data-finder>
          <span class="ln-finder" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
          <span class="ln-prov is-active" data-prov style="--brand:#10a37f"><span class="ln-mark ln-mark--openai" style="--s:17px"></span>OpenAI</span>
          <span class="ln-prov" data-prov style="--brand:#d97757"><span class="ln-mark ln-mark--claude" style="--s:17px"></span>Claude</span>
          <span class="ln-prov" data-prov style="--brand:var(--accent)"><Icon name="terminal" size={16} />edgey</span>
          <span class="ln-prov" data-prov style="--brand:#f4f7f8"><svg viewBox="0 0 24 24" width="15" height="15" fill="currentColor" aria-hidden="true"><path d="M3 3l7.5 9L3 21h2l6.5-7.8L18 21h3l-8-9.5L20.5 3h-2L12 10.3 6 3H3z"/></svg>Grok</span>
        </div>

        <div class="ln-hero-btns ln-rise" style="--i:5">
          <button class="ln-btn ln-btn--primary" data-open-signin>Get started <span class="ln-arrow"><Icon name="arrowRight" size={14} /></span></button>
          <a href="/overview" class="ln-btn ln-btn--ghost">See the dashboard <Icon name="arrowUpRight" size={13} /></a>
        </div>

        <p class="ln-already ln-rise" style="--i:6">Got an access number? <button class="ln-text-btn" data-open-signin>Sign in here.</button></p>
      </div>
    </section>

    <!-- Model Activity -->
    <section class="ln-section" id="models">
      <div class="ln-container">
        <h2 class="ln-heading">Watch the traffic.<br /><span class="accent">Model by model.</span></h2>
        <p class="ln-lead">A live look at where your requests go and which models carry the load.</p>

        <div class="ln-activity">
          <div class="ln-activity-top">
            <div class="ln-activity-info">
              <Icon name="activity" size={16} />
              <div>
                <p class="ln-activity-name">Model activity</p>
                <p class="ln-activity-meta">{providerCount} model families · Example data</p>
              </div>
            </div>
            <a href="/overview" class="ln-btn ln-btn--sm">Open workspace <Icon name="arrowUpRight" size={11} /></a>
          </div>

          <div class="ln-radars">
            <div class="ln-radar-card">
              <div class="ln-radar">
                <div class="ln-viz">{Array.from({length:36},(_,i)=><span class="ln-tick" style={`--a:${i*10}deg;--dl:${((i*7)%11)*0.17}s;--h:${6+((i*13)%9)}px`}/>)}</div>
                <div class="ln-ring"></div><div class="ln-ring ln-ring--2"></div><div class="ln-ring ln-ring--3"></div>
                <div class="ln-sweep"></div>
                <div class="ln-radar-center"><div class="ln-radar-glow"></div><span class="ln-mark ln-mark--openai" style="--s:26px"></span></div>
              </div>
              <p class="ln-radar-name">OpenAI</p>
              <p class="ln-radar-sub">GPT · General purpose</p>
              <span class="ln-radar-badge"><Icon name="activity" size={11} /> 80 requests</span>
            </div>

            <div class="ln-radar-card">
              <div class="ln-radar ln-radar--purple">
                <div class="ln-viz ln-viz--purple">{Array.from({length:36},(_,i)=><span class="ln-tick" style={`--a:${i*10}deg;--dl:${((i*5)%11)*0.19}s;--h:${5+((i*11)%10)}px`}/>)}</div>
                <div class="ln-ring ln-ring--purple"></div><div class="ln-ring ln-ring--2 ln-ring--purple"></div><div class="ln-ring ln-ring--3 ln-ring--purple"></div>
                <div class="ln-sweep ln-sweep--purple"></div>
                <div class="ln-radar-center ln-radar-center--purple"><div class="ln-radar-glow"></div><span class="ln-mark ln-mark--claude" style="--s:26px"></span></div>
              </div>
              <p class="ln-radar-name">Claude</p>
              <p class="ln-radar-sub">Anthropic · Reasoning</p>
              <span class="ln-radar-badge"><Icon name="activity" size={11} /> 50 requests</span>
            </div>

            <div class="ln-radar-card">
              <div class="ln-radar ln-radar--cyan">
                <div class="ln-viz ln-viz--cyan">{Array.from({length:36},(_,i)=><span class="ln-tick" style={`--a:${i*10}deg;--dl:${((i*3)%11)*0.15}s;--h:${7+((i*17)%8)}px`}/>)}</div>
                <div class="ln-ring ln-ring--cyan"></div><div class="ln-ring ln-ring--2 ln-ring--cyan"></div><div class="ln-ring ln-ring--3 ln-ring--cyan"></div>
                <div class="ln-sweep ln-sweep--cyan"></div>
                <div class="ln-radar-center ln-radar-center--cyan"><div class="ln-radar-glow"></div><Icon name="terminal" size={24} /></div>
              </div>
              <p class="ln-radar-name">edgey</p>
              <p class="ln-radar-sub">Our own models</p>
              <span class="ln-radar-badge ln-radar-badge--hl"><Icon name="shield" size={11} /> 870 requests</span>
            </div>
          </div>

          <div class="ln-share">
            <div class="ln-share-row"><span>Request share</span><span class="dim">1,000 total</span></div>
            <div class="ln-bar"><div class="ln-seg ln-seg--green" style="width:8%"></div><div class="ln-seg ln-seg--purple" style="width:5%"></div><div class="ln-seg ln-seg--cyan" style="width:87%"></div></div>
            <div class="ln-legend">
              <span><i class="ln-ldot ln-ldot--green"></i> OpenAI 8%</span>
              <span><i class="ln-ldot ln-ldot--purple"></i> Claude 5%</span>
              <span><i class="ln-ldot ln-ldot--cyan"></i> edgey 87%</span>
            </div>
          </div>
        </div>

        <p class="ln-note">Animated preview with example usage. Your actual models and activity appear in the workspace.</p>
      </div>
    </section>

    <!-- Features -->
    <section class="ln-section" id="features">
      <div class="ln-container">
        <div class="ln-rule"></div>
        <p class="ln-eyebrow">WHAT YOU GET</p>
        <h2 class="ln-heading ln-heading--sm">
          Less setup.<br />
          <span class="accent">More shipping.</span>
        </h2>
        <p class="ln-lead">Keys, models, usage and setup guides.<br />Everything you need to go from idea to production, nothing you don't.</p>

        <div class="ln-feat-grid">
          <!-- 1: Models -->
          <article class="ln-feat">
            <h3>{features[0].title}</h3>
            <p>{features[0].desc}</p>
            <div class="ln-feat-vis">
              <div class="ln-model-row">
                <span class="ln-model-icon"><span class="ln-mark ln-mark--openai" style="--s:20px"></span></span>
                <span class="ln-model-icon"><span class="ln-mark ln-mark--claude" style="--s:20px"></span></span>
                <span class="ln-model-icon ln-model-icon--brand"><Icon name="terminal" size={18} /></span>
                <span class="ln-model-icon"><svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor"><path d="M3 3l7.5 9L3 21h2l6.5-7.8L18 21h3l-8-9.5L20.5 3h-2L12 10.3 6 3H3z"/></svg></span>
              </div>
            </div>
          </article>

          <!-- 2: Keys -->
          <article class="ln-feat">
            <h3>{features[1].title}</h3>
            <p>{features[1].desc}</p>
            <div class="ln-feat-vis">
              <div class="ln-keys">
                <div class="ln-key"><span class="ln-key-dot ln-key-dot--on"></span><span>Production</span><span class="dim mono">sk_edgey_…</span><span class="ln-tag ln-tag--green">Active</span></div>
                <div class="ln-key"><span class="ln-key-dot ln-key-dot--on"></span><span>Side project</span><span class="dim mono">sk_edgey_…</span><span class="ln-tag ln-tag--green">Active</span></div>
                <div class="ln-key"><span class="ln-key-dot"></span><span>Local dev</span><span class="dim mono">sk_edgey_…</span><span class="ln-tag">Paused</span></div>
              </div>
            </div>
          </article>

          <!-- 3: Usage -->
          <article class="ln-feat">
            <h3>{features[2].title}</h3>
            <p>{features[2].desc}</p>
            <div class="ln-feat-vis">
              <div class="ln-chart">
                <div class="ln-chart-bar" style="--h:55%"></div>
                <div class="ln-chart-bar" style="--h:80%"></div>
                <div class="ln-chart-bar" style="--h:40%"></div>
                <div class="ln-chart-bar" style="--h:90%"></div>
                <div class="ln-chart-bar" style="--h:65%"></div>
                <div class="ln-chart-bar" style="--h:25%"></div>
                <div class="ln-chart-bar" style="--h:45%"></div>
              </div>
              <div class="ln-chart-labels"><span>Mon</span><span>Tue</span><span>Wed</span><span>Thu</span><span>Fri</span><span>Sat</span><span>Sun</span></div>
              <p class="ln-chart-note">Requests getting…</p>
            </div>
          </article>

          <!-- 4: Setup -->
          <article class="ln-feat">
            <h3>{features[3].title}</h3>
            <p>{features[3].desc}</p>
            <div class="ln-feat-vis">
              <div class="ln-setup-tabs">
                <span class="ln-setup-tab ln-setup-tab--active">openai</span>
                <span class="ln-setup-tab">curl</span>
                <span class="ln-setup-tab">edgeycli</span>
              </div>
              <div class="ln-setup-code">
                <code><span class="c-kw">from</span> openai <span class="c-kw">import</span> OpenAI</code>
                <code>client = OpenAI(</code>
                <code>  <span class="c-key">base_url</span>=<span class="c-str">"api.edgey.shop/v1"</span></code>
                <code>)</code>
              </div>
            </div>
          </article>

          <!-- 5: Keep building -->
          <article class="ln-feat">
            <h3>{features[4].title}</h3>
            <p>{features[4].desc}</p>
            <div class="ln-feat-vis">
              <div class="ln-chat-compare">
                <div class="ln-chat ln-chat--fail">
                  <span class="ln-chat-label">ChatGPT</span>
                  <p class="ln-chat-msg ln-chat-msg--err">Can't respond.</p>
                </div>
                <div class="ln-chat ln-chat--ok">
                  <span class="ln-chat-label">edgey</span>
                  <code class="ln-chat-code"><span class="c-kw">#include</span> <span class="c-str">&lt;iostream&gt;</span>
<span class="c-kw">int</span> main() {"{"} … {"}"}</code>
                </div>
              </div>
            </div>
          </article>

          <!-- 6: Debug -->
          <article class="ln-feat">
            <h3>{features[5].title}</h3>
            <p>{features[5].desc}</p>
            <div class="ln-feat-vis">
              <div class="ln-debug">
                <div class="ln-debug-head"><span class="ln-debug-tag">Issue detected</span><span class="dim">1 / 6</span></div>
                <div class="ln-debug-diff">
                  <code class="ln-diff-old">- response.<span class="c-key">text</span></code>
                  <code class="ln-diff-new">+ response.<span class="c-key">output_text</span></code>
                </div>
              </div>
            </div>
          </article>
        </div>
      </div>
    </section>

    <!-- Code example -->
    <section class="ln-section" id="how">
      <div class="ln-container">
        <div class="ln-rule"></div>
        <p class="ln-eyebrow">DROP-IN COMPATIBLE</p>
        <h2 class="ln-heading ln-heading--sm">Swap the base URL.<br /><span class="accent">Keep your code.</span></h2>
        <p class="ln-lead">Already on the OpenAI SDK? Point it at edgey and call any model in the catalog.<br />Same format, same streaming, same tool calls.</p>

        <div class="ln-code-card">
          <div class="ln-code-top"><div class="ln-dots"><span></span><span></span><span></span></div><span class="dim mono text-xs">python</span></div>
          <pre class="ln-code"><code><span class="c-kw">from</span> openai <span class="c-kw">import</span> OpenAI

client = OpenAI(
    <span class="c-key">base_url</span>=<span class="c-str">"https://api.edgey.shop/v1"</span>,
    <span class="c-key">api_key</span>=<span class="c-str">"sk_edgey_..."</span>,
)

response = client.chat.completions.create(
    <span class="c-key">model</span>=<span class="c-str">"claude-sonnet-5"</span>,
    <span class="c-key">messages</span>=[{"{"}
        <span class="c-str">"role"</span>: <span class="c-str">"user"</span>,
        <span class="c-str">"content"</span>: <span class="c-str">"Let's build."</span>
    {"}"}],
)
<span class="c-kw">print</span>(response.choices[<span class="c-num">0</span>].message.content)</code></pre>
        </div>
      </div>
    </section>

    <!-- Getting Started -->
    <section class="ln-section">
      <div class="ln-container">
        <div class="ln-rule"></div>
        <p class="ln-eyebrow">THREE STEPS</p>
        <h2 class="ln-heading ln-heading--sm">From zero to first request.<br /><span class="accent">In minutes.</span></h2>
        <p class="ln-lead">Sign in, top up, plug in your key.</p>

        <div class="ln-steps">
          {steps.map((s) => (
            <div class:list={['ln-step', { 'ln-step--hl': s.highlight }]}>
              <div class="ln-step-top">
                <span class="ln-step-tag">{s.tag}</span>
                <span class="ln-step-num">{s.num}</span>
              </div>
              <h3>{s.title}</h3>
              <p class="ln-step-desc">{s.desc}</p>
              <ul class="ln-checks">
                {s.checks.map((c) => (
                  <li><Icon name="check" size={12} /> {c}</li>
                ))}
              </ul>
              {s.action === 'register' ? (
                <button class:list={['ln-btn ln-btn--sm ln-step-btn', { 'ln-btn--primary': s.highlight }]} data-open-signin>{s.btn} <Icon name="arrowRight" size={12} /></button>
              ) : (
                <a href={s.href} class:list={['ln-btn ln-btn--sm ln-step-btn', { 'ln-btn--primary': s.highlight }]}>{s.btn} <Icon name="arrowRight" size={12} /></a>
              )}
            </div>
          ))}
        </div>

        <p class="ln-note">Pay as you go with crypto top-ups. No subscription.</p>
      </div>
    </section>

    <!-- FAQ -->
    <section class="ln-section" id="faq">
      <div class="ln-container ln-container--narrow">
        <div class="ln-rule"></div>
        <p class="ln-eyebrow">FAQ</p>
        <h2 class="ln-heading">Questions?<br /><span class="accent">Answered.</span></h2>
        <p class="ln-lead">The short version of everything you need to know.</p>

        <div class="ln-faq-list">
          {faqs.map((f) => (
            <details class="ln-faq">
              <summary>{f.q} <span class="ln-faq-icon"><Icon name="plus" size={14} /></span></summary>
              <div class="ln-faq-body"><p>{f.a}</p></div>
            </details>
          ))}
        </div>

        <p class="ln-faq-more">Still stuck? <a href={DISCORD_URL} target="_blank" rel="noopener">Talk to support <Icon name="arrowUpRight" size={12} /></a></p>
      </div>
    </section>

    <!-- CTA -->
    <section class="ln-section">
      <div class="ln-container">
        <div class="ln-rule"></div>
        <p class="ln-eyebrow">READY WHEN YOU ARE</p>
        <h2 class="ln-heading">Your next build<br /><span class="accent">starts with one key.</span></h2>
        <div class="ln-cta-btns">
          <button class="ln-btn ln-btn--primary" data-open-signin>Get started <span class="ln-arrow"><Icon name="arrowRight" size={14} /></span></button>
        </div>
      </div>
    </section>

    <!-- Footer -->
    <footer class="ln-footer">
      <div class="ln-container">
        <div class="ln-rule"></div>
        <div class="ln-foot-grid">
          <div class="ln-foot-brand">
            <a href="/" class="ln-brand">
              <span class="ln-logo"><Icon name="terminal" size={14} /></span>
              <span class="ln-brand-name">edgey<span class="dim">.shop</span></span>
            </a>
            <p>Every model, one API key.<br />Usage and spend in one dashboard.</p>
            <p class="ln-copy">&copy; {year} cli.edgey.shop</p>
          </div>
          <div class="ln-foot-col">
            <h4>Workspace</h4>
            <a href="/" data-open-signin>Sign in</a>
            <a href="/#register" data-open-signin-register>Create account</a>
            <a href="#features">Features</a>
          </div>
          <div class="ln-foot-col">
            <h4>Resources</h4>
            <a href="/setup">Setup</a>
            <a href="/support">Support</a>
            <a href="#faq">FAQ</a>
          </div>
          <div class="ln-foot-col">
            <h4>Information</h4>
            <a href="/terms">Terms &amp; payments</a>
            <a href="/products">Products</a>
          </div>
        </div>
      </div>
    </footer>

    <!-- Sign-in dialog -->
    <dialog class="ln-dialog" id="signinDialog">
      <div class="ln-dialog-bg" data-close-signin></div>
      <div class="ln-dialog-box">
        <button class="ln-dialog-x" data-close-signin aria-label="Close"><Icon name="x" size={18} /></button>
        <SignIn1 client:load apiBase={API_ROOT} discordUrl={DISCORD_URL} openRegistration={true} />
      </div>
    </dialog>
  </div>
</Shell>

<script>
  const nav = document.getElementById('lnNav');
  if (nav) {
    const onScroll = () => nav.classList.toggle('scrolled', scrollY > 8);
    addEventListener('scroll', onScroll, { passive: true });
    onScroll();
  }

  const row = document.querySelector<HTMLElement>('[data-finder]');
  const finder = row?.querySelector<HTMLElement>('.ln-finder');
  if (row && finder) {
    const items = [...row.querySelectorAll<HTMLElement>('[data-prov]')];
    let idx = 0;
    let hovering = false;
    const place = (i: number) => {
      idx = i;
      items.forEach((el, k) => el.classList.toggle('is-active', k === i));
      const el = items[i];
      finder.style.cssText = `--x:${el.offsetLeft}px;--y:${el.offsetTop}px;--w:${el.offsetWidth}px;--h:${el.offsetHeight}px`;
    };
    place(0);
    requestAnimationFrame(() => finder.classList.add('ready'));
    document.fonts?.ready.then(() => place(idx));
    addEventListener('resize', () => place(idx));
    items.forEach((el, k) => el.addEventListener('mouseenter', () => { hovering = true; place(k); }));
    row.addEventListener('mouseleave', () => { hovering = false; });
    if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
      setInterval(() => { if (!hovering && !document.hidden) place((idx + 1) % items.length); }, 2400);
    }
  }
  const dialog = document.getElementById('signinDialog') as HTMLDialogElement | null;
  document.querySelectorAll<HTMLElement>('[data-open-signin],[data-open-signin-register]').forEach(b =>
    b.addEventListener('click', (e) => { e.preventDefault(); dialog?.showModal(); })
  );
  document.querySelectorAll<HTMLElement>('[data-close-signin]').forEach(b =>
    b.addEventListener('click', () => dialog?.close())
  );
  if (location.hash === '#register') dialog?.showModal();
  document.querySelectorAll<HTMLAnchorElement>('a[href^="#"]').forEach(a => {
    a.addEventListener('click', (e) => {
      const t = document.querySelector(a.getAttribute('href')!);
      if (t) { e.preventDefault(); t.scrollIntoView({ behavior: 'smooth' }); }
    });
  });
</script>

<style>
  /* ── Base ── */
  .landing {
    min-height: 100svh;
    font-family: 'Geist', system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
