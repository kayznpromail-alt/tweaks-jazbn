---
import Public from '../layouts/Public.astro';
import Icon from '../components/Icon.astro';
import { DISCORD_URL } from '../data/site';

const topics = [
  {
    icon: 'wallet',
    title: 'Payment support',
    text: 'Include your payment reference, currency, network and approximate time. We can investigate pending, partial, expired or incorrectly routed payments.',
  },
  {
    icon: 'key',
    title: 'Account & API access',
    text: 'For sign-in or API access issues, tell us the account name and the error message. Keep credentials private — staff will never ask for them.',
  },
  {
    icon: 'cpu',
    title: 'Model & routing issues',
    text: 'If a model returns errors or unexpected results, share the model ID, timestamp and error. Include your key name (not the key itself).',
  },
] as const;
const checklist = [
  'Check payment status in your workspace history.',
  'Confirm the asset and network matched checkout.',
  'Keep the reference and transaction hash available.',
  'Never share your access number, API key or wallet seed.',
];
---
<Public title="Support" active="support">
  <section class="hero">
    <p class="kicker"><i class="dot"></i>CUSTOMER SUPPORT</p>
    <h1>We can help with your <span class="accent">account</span> or payment.</h1>
    <p class="lead">Use the official edgey Discord for support. Never post an access number, API key, wallet seed or private key.</p>
    <div class="cta">
      <a href={DISCORD_URL} class="btn primary" target="_blank" rel="noopener"><Icon name="discord" size={16} /> Open Discord <Icon name="arrowUpRight" size={13} /></a>
    </div>
  </section>

  <section class="grid">
    {topics.map((t, i) => (
      <article class="card feat">
        <div class="feat-top">
          <span class="g-icon"><Icon name={t.icon} /></span>
          <span class="idx">0{i + 1}</span>
        </div>
        <h2>{t.title}</h2>
        <p>{t.text}</p>
      </article>
    ))}
  </section>

  <section class="card check-card">
    <div class="check-head">
      <div>
        <p class="card-title row"><Icon name="shield" /> Before contacting us</p>
        <p class="card-sub">A few things to verify first — it helps us resolve your issue faster.</p>
      </div>
      <span class="warn-tag"><Icon name="lock" size={11} /> Never share secrets</span>
    </div>
    <ul class="checklist">
      {checklist.map((s) => (
        <li>
          <span class="check-icon"><Icon name="check" size={14} /></span>
          <span>{s}</span>
        </li>
      ))}
    </ul>
  </section>
</Public>

<style>
  .row { display: flex; align-items: center; gap: 10px; }

  .check-card { margin-top: 16px; overflow: hidden; }
  .check-head {
    display: flex; justify-content: space-between; align-items: center;
    padding: 20px 24px; border-bottom: 1px solid var(--border);
  }
  .warn-tag {
    display: inline-flex; align-items: center; gap: 6px;
    padding: 6px 12px; border-radius: 8px;
    font-family: var(--mono); font-size: 9px; letter-spacing: 0.1em; text-transform: uppercase;
    color: #fbbf24; background: rgb(251 191 36 / 0.08); border: 1px solid rgb(251 191 36 / 0.2);
  }
  .checklist { list-style: none; }
  .checklist li {
    display: flex; gap: 14px; align-items: center;
    padding: 16px 24px;
    border-bottom: 1px solid var(--border);
    font-size: 13px;
    transition: background 0.15s;
  }
  .checklist li:last-child { border-bottom: 0; }
  .checklist li:hover { background: var(--surface-2); }
  .check-icon {
    display: grid; place-items: center;
    width: 28px; height: 28px; flex: none;
    border-radius: 8px;
    color: #4ade80;
    background: rgb(74 222 128 / 0.08);
    border: 1px solid rgb(74 222 128 / 0.2);
  }
  @media (max-width: 640px) {
    .check-head { flex-direction: column; align-items: flex-start; gap: 12px; }
  }
</style>
