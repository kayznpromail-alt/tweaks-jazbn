---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import ModelRates from '../components/ModelRates.astro';
import { DISCORD_URL } from '../data/site';
import TopUp from '../components/TopUp.astro';
---
<Base crumb="OVERVIEW" heading="Welcome back." sub="Your tokens, keys, and usage in one place.">
  <div class="top-grid">
    <section class="card pad wallet">
      <div class="card-head">
        <p class="card-title">Tokens available</p>
        <button class="icon-btn" aria-label="Top up" data-topup-open><Icon name="arrowDownLeft" /></button>
      </div>
      <p class="figure"><span data-cli="available">–</span><span class="tag">tokens</span></p>
      <button class="btn primary wide" data-topup-open>Top up <Icon name="plus" size={14} /></button>
    </section>

    <section class="card pad">
      <div class="card-head">
        <p class="card-title">Usage</p>
        <a href="/activity" class="icon-btn" aria-label="Usage details"><Icon name="activity" /></a>
      </div>
      <div class="req">
        <p class="figure"><span data-cli="used">0</span><span class="tag" data-usage-tag>used</span></p>
        <div class="succ"><p class="dash" data-cli="limit">–</p><p class="tag" data-limit-tag>limit</p></div>
      </div>
      <div class="bar"><i data-cli-bar></i></div>
      <p class="card-sub small" data-usage-sub><span data-cli="requests">–</span> requests left · <span data-cli="percent"></span></p>
    </section>

    <section class="card pad">
      <div class="card-head">
        <p class="card-title" data-key-title>Your CLI key</p>
        <a href="/api" class="icon-btn" aria-label="Keys"><Icon name="key" /></a>
      </div>
      <div class="state" data-cli-state="none"><i></i><span data-cli="status">Not linked</span></div>
      <a href="/api" class="key-row">
        <code data-cli="masked">No CLI key yet</code>
        <Icon name="chevronRight" size={14} />
      </a>
      <p class="card-sub small" data-key-sub>Plan <span data-cli="plan">–</span> · expires <span data-cli="expires">–</span></p>
    </section>
  </div>

  <a href={DISCORD_URL} class="card pad discord">
    <span class="icon-btn big"><Icon name="discord" size={20} /></span>
    <span class="grow">
      <span class="card-title">Discord community</span>
      <span class="card-sub">Service news, model updates, and promo codes.</span>
    </span>
    <span class="btn">Open <Icon name="arrowUpRight" size={13} /></span>
  </a>

  <div class="gap"><ModelRates /></div>
  <TopUp />
</Base>

<script>
  import { API_ENABLED, ApiError, api, fmt } from '../lib/api';
  import { fillCli, type Cli } from '../lib/cli';

  if (API_ENABLED) {
    type Me = { cli: Cli; balance: number; keyCount: number; maxKeys: number; firstKey: string | null; requests24h: number; successful24h: number };
    api<Me>('/me').then((me) => {
      const { cli } = me;
      fillCli(cli);
      const set = (sel: string, text: string) => document.querySelectorAll<HTMLElement>(sel).forEach((el) => (el.textContent = text));
      // Accounts without a CLI key use edgey API keys and the edgey balance.
      if (!cli) {
        set('[data-cli="available"]', fmt(me.balance));
        set('[data-cli="used"]', fmt(me.requests24h));
        set('[data-usage-tag]', 'requests · 24h');
        set('[data-cli="limit"]', fmt(me.successful24h));
        set('[data-limit-tag]', 'successful');
        set('[data-usage-sub]', 'Details on the Activity page.');
        const ratio = me.requests24h ? Math.round((me.successful24h / me.requests24h) * 100) : 0;
        document.querySelectorAll<HTMLElement>('[data-cli-bar]').forEach((el) => (el.style.width = `${ratio}%`));
        set('[data-key-title]', 'Your API keys');
        set('[data-cli="status"]', `${me.keyCount} / ${me.maxKeys} keys`);
        document.querySelectorAll<HTMLElement>('[data-cli-state]').forEach((el) => (el.dataset.cliState = me.keyCount ? 'active' : 'none'));
        set('[data-cli="masked"]', me.firstKey ?? 'No API key yet');
        set('[data-key-sub]', 'Create and manage keys on the API page.');
      }
      // Top-up dialog: tokens currently available.
      const cur = document.querySelector<HTMLElement>('[data-cur]');
      const available = cli ? (cli.account?.available ?? 0) : me.balance;
      if (cur) {
        cur.dataset.cur = String(available);
        cur.textContent = `${fmt(available)} tokens`;
      }
    });

    // Crypto top-up through NOWPayments (hosted invoice).
    (window as any).edgeyTopup = async (pack: number, coin: string, say: (t: string) => void) => {
      try {
        const { invoiceUrl } = await api<{ invoiceUrl: string }>('/topup', { method: 'POST', body: { pack, coin } });
        location.assign(invoiceUrl);
      } catch (err) {
        const code = err instanceof ApiError ? err.code : '';
        say(code === 'crypto_unavailable' ? 'Crypto checkout is being set up. Use Discord for now.' : 'Payment could not start. Try again.');
      }
    };
  }
</script>


<style>
  .pad { padding: 24px; }
  .top-grid {
    display: grid;
    grid-template-columns: 1.3fr 1fr 1.1fr;
    gap: 20px;
  }
  .figure {
    display: flex;
    align-items: baseline;
    gap: 10px;
    font-size: 44px;
    font-weight: 600;
    letter-spacing: -0.04em;
    margin: 28px 0 22px;
    line-height: 1;
  }
  .wallet .figure { background: linear-gradient(90deg, var(--fg), var(--accent)); -webkit-background-clip: text; background-clip: text; color: transparent; }
  .wallet .figure .tag { -webkit-text-fill-color: var(--muted); letter-spacing: 0.12em; }
  .wide { width: 100%; height: 44px; }
  .req { display: flex; justify-content: space-between; align-items: flex-end; }
  .succ { text-align: right; margin-bottom: 22px; }
  .dash { font-size: 18px; font-weight: 600; }
  .small { font-size: 10.5px; }
  .bar { height: 6px; margin: -8px 0 12px; border-radius: 6px; background: var(--surface-2); overflow: hidden; }
  .bar i { display: block; height: 100%; width: 0; border-radius: 6px; background: linear-gradient(90deg, var(--accent), var(--accent-2)); transition: width 0.8s cubic-bezier(0.2, 0.8, 0.2, 1); }
  .state { display: inline-flex; align-items: center; gap: 8px; margin: 26px 0 16px; font-size: 13px; font-weight: 600; }
  .state i { width: 8px; height: 8px; border-radius: 50%; background: var(--muted); }
  .state[data-cli-state='active'] i { background: #4ade80; box-shadow: 0 0 10px #4ade80; }
  .state[data-cli-state='exhausted'] i, .state[data-cli-state='paused'] i { background: #fbbf24; }
  .state[data-cli-state='expired'] i { background: #f87171; }
  .keys-count {
    display: flex;
    align-items: center;
    gap: 12px;
    margin: 26px 0 18px;
  }
  .keys-count .n { font-size: 36px; font-weight: 600; line-height: 1; color: var(--accent); }
  .keys-count .k { font-size: 11px; font-weight: 600; }
  .keys-count :global(.go) { margin-left: auto; color: var(--muted); }
  .keys-count:hover :global(.go) { color: var(--accent); }
  .key-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 12px 14px;
    border-radius: 8px;
    border: 1px solid var(--border);
    background: var(--bg);
    font-size: 11px;
    transition: border-color 0.15s;
  }
  .key-row:hover { border-color: var(--accent-line); }
  .key-row.empty { border-style: dashed; color: var(--muted); }
  .key-row.empty:hover { color: var(--accent); }
  .discord {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-top: 20px;
    transition: border-color 0.15s;
  }
  .discord:hover { border-color: var(--accent-line); }
  .discord .grow { flex: 1; display: flex; flex-direction: column; }
  .icon-btn.big { width: 44px; height: 44px; color: var(--accent); }
  .bottom-grid {
    display: grid;
    grid-template-columns: 1.6fr 1fr;
    gap: 20px;
    margin-top: 20px;
    align-items: start;
  }
  .gap { margin-top: 20px; }
  @media (max-width: 1000px) {
    .top-grid, .bottom-grid { grid-template-columns: 1fr; }
  }
  @media (max-width: 560px) {
    .discord { flex-wrap: wrap; }
  }
</style>
