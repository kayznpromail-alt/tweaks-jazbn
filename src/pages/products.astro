---
import Public from '../layouts/Public.astro';
import Icon from '../components/Icon.astro';

const features = [
  {
    icon: 'wallet',
    title: 'Crypto wallet top-up',
    text: 'After signing in, choose an available cryptocurrency and network, enter a USD amount, and get the exact payment address and QR code. The checkout shows the amount, network and expiry before you send funds.',
  },
  {
    icon: 'badgeCheck',
    title: 'Verified delivery',
    text: 'Funds are credited only after the payment is confirmed and matched to the order. Partial, unsigned or mismatched payments are not credited automatically.',
  },
  {
    icon: 'key',
    title: 'One shared balance',
    text: 'Your wallet is shared by all your API keys and edgeyCLI. Top up once, use it everywhere.',
  },
] as const;
const steps = [
  'Register or sign in with your 16-digit access number.',
  'Open Top up wallet.',
  'Select the cryptocurrency and follow the instructions.',
  'Wait for network confirmation; your API balance updates automatically.',
];
---
<Public title="Products" active="products">
      <section class="hero">
        <p class="kicker"><i class="dot"></i>CRYPTO SERVICES</p>
        <h1>Build more with your <span class="accent">edgey</span> workspace.</h1>
        <p class="lead">Buy weighted API units for supported AI models using cryptocurrency. Your balance is shared by your API keys and edgeyCLI.</p>
        <div class="cta">
          <a href="/#register" class="btn primary">Create an account and view checkout <Icon name="arrowRight" size={14} /></a>
          <a href="/" class="btn">Sign in</a>
        </div>
      </section>

      <section class="grid">
        {features.map((f, i) => (
          <article class="card feat">
            <div class="feat-top">
              <span class="g-icon"><Icon name={f.icon} /></span>
              <span class="idx">0{i + 1}</span>
            </div>
            <h2>{f.title}</h2>
            <p>{f.text}</p>
          </article>
        ))}
      </section>

      <section class="card how">
        <div class="how-head">
          <p class="card-title"><Icon name="terminal" /> How it works</p>
          <span class="tag">4 steps</span>
        </div>
        <ol>
          {steps.map((s, i) => (
            <li><span class="n">{String(i + 1).padStart(2, '0')}</span><span class="p">$</span><span>{s}</span></li>
          ))}
        </ol>
      </section>
</Public>
