# Copy to deploy/.env on the VPS and fill in. Never commit the real file.

# Domain served by Caddy (DNS A record must point to the VPS).
API_DOMAIN=api.edgey.shop

# Upstream provider and YOUR key for it. Only lives on the VPS.
UPSTREAM_BASE=
UPSTREAM_API_KEY=

# Random secret used to hash access numbers, API keys and sessions.
# Generate once with: openssl rand -hex 32   (changing it later logs everyone out and breaks all keys)
SECRET_PEPPER=

# Password for the /admin panel on the site. Generate with: openssl rand -hex 24
ADMIN_TOKEN=

# Sites allowed to call the dashboard endpoints.
ALLOWED_ORIGINS=https://cli.edgey.shop,https://tweaks-jazbn.pages.dev
PUBLIC_API_URL=https://api.edgey.shop
SITE_URL=https://cli.edgey.shop

# NOWPayments (crypto). Leave empty until the account is ready.
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=

# Profit split shown in the admin panel (CLI payments only).
# Retail cost at the provider in USD per 1M tokens, the USD/EUR rate used to convert it,
# and each partner's share of the profit (shares are rounded up to the cent).
COST_USD_PER_MILLION=0.05
USD_PER_EUR=1.15
PROFIT_SPLIT=edgey:60,kayzn:40

# Let customers create their own API keys on the site (off: keys come from the admin panel).
CUSTOMER_KEYS=false
